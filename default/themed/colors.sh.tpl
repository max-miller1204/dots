# Shell-sourceable palette for the active theme. Source it from scripts or
# your prompt: . ~/.local/state/dots/current/theme/colors.sh

DOTS_THEME_MODE="{{ mode }}"

DOTS_ACCENT="{{ accent }}"
DOTS_SELECTION="{{ selection }}"
DOTS_MUTED="{{ muted }}"

DOTS_BACKGROUND="{{ background }}"
DOTS_FOREGROUND="{{ foreground }}"
DOTS_BRIGHT_FOREGROUND="{{ bright_foreground }}"

DOTS_RED="{{ red }}"
DOTS_GREEN="{{ green }}"
DOTS_YELLOW="{{ yellow }}"
DOTS_BLUE="{{ blue }}"
DOTS_MAGENTA="{{ magenta }}"
DOTS_CYAN="{{ cyan }}"

DOTS_ACCENT_RGB="{{ accent_rgb }}"
DOTS_BACKGROUND_RGB="{{ background_rgb }}"
DOTS_FOREGROUND_RGB="{{ foreground_rgb }}"
