# History
if [[ -n ${BASH_VERSION:-} ]]; then
  shopt -s histappend cmdhist
  HISTCONTROL=ignoreboth:erasedups
  HISTSIZE=32768
  HISTFILESIZE=$HISTSIZE

  # Load bash-completion from mise. If this installation is not available,
  # load the first installation in a prefix on PATH. Also search system paths
  # that are not below these prefixes (for example, on Fedora and Debian).
  dots_mise_data_dir=${MISE_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/mise}
  dots_mise_bash_completion="$dots_mise_data_dir/installs/github-scop-bash-completion/latest/bash_completion"
  if [[ -r $dots_mise_bash_completion || -z ${BASH_COMPLETION_VERSINFO:-} ]]; then
    dots_bash_completion_candidates=(
      "$dots_mise_bash_completion"
    )
    IFS=: read -r -a dots_path_dirs <<<"$PATH"
    for dots_path_dir in "${dots_path_dirs[@]}"; do
      [[ $dots_path_dir == /*/bin ]] || continue
      dots_path_prefix=${dots_path_dir%/bin}
      dots_bash_completion_candidates+=(
        "$dots_path_prefix/etc/profile.d/bash_completion.sh"
        "$dots_path_prefix/share/bash-completion/bash_completion"
      )
    done
    dots_bash_completion_candidates+=(
      /etc/profile.d/bash_completion.sh
      /etc/bash_completion
      /usr/share/bash-completion/bash_completion
    )
    for dots_bash_completion in "${dots_bash_completion_candidates[@]}"; do
      if [[ -r $dots_bash_completion ]]; then
        . "$dots_bash_completion"
        break
      fi
    done
    unset dots_bash_completion dots_bash_completion_candidates dots_path_dir \
      dots_path_dirs dots_path_prefix
  fi
  unset dots_mise_bash_completion dots_mise_data_dir
elif [[ -n ${ZSH_VERSION:-} ]]; then
  HISTFILE=${ZDOTDIR:-$HOME}/.zsh_history
  HISTSIZE=32768
  SAVEHIST=$HISTSIZE
  setopt append_history extended_history hist_expire_dups_first
  setopt hist_ignore_all_dups hist_ignore_space share_history
fi
