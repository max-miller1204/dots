# Shell integrations are optional: a missing tool leaves the stock shell intact.
if command -v fzf >/dev/null 2>&1; then
  if [[ -n ${BASH_VERSION:-} ]]; then
    _dots_fzf_init=$(fzf --bash 2>/dev/null) && eval "$_dots_fzf_init"
  elif [[ -n ${ZSH_VERSION:-} ]]; then
    _dots_fzf_init=$(fzf --zsh 2>/dev/null) && eval "$_dots_fzf_init"
  fi
  unset _dots_fzf_init
fi

if [[ ${TERM:-} != "dumb" ]] && command -v starship >/dev/null 2>&1; then
  if [[ -n ${BASH_VERSION:-} ]]; then
    eval "$(starship init bash)"
  elif [[ -n ${ZSH_VERSION:-} ]]; then
    eval "$(starship init zsh)"
  fi
elif [[ -n ${BASH_VERSION:-} ]]; then
  PS1='\[\e[34m\]\W\[\e[0m\] \$ '
elif [[ -n ${ZSH_VERSION:-} ]]; then
  PROMPT='%F{blue}%1~%f %# '
fi

# Starship can replace zoxide's prompt/directory hooks, so zoxide follows it.
if command -v zoxide >/dev/null 2>&1; then
  if [[ -n ${BASH_VERSION:-} ]]; then
    eval "$(zoxide init bash)"
  elif [[ -n ${ZSH_VERSION:-} ]]; then
    eval "$(zoxide init zsh)"
  fi
fi

# mise preserves existing hooks while registering its own. Initialize it last
# so directory-specific tool versions continue updating without displacing
# Starship or zoxide.
if command -v mise >/dev/null 2>&1; then
  if [[ -n ${BASH_VERSION:-} ]]; then
    eval "$(mise activate bash)"
  elif [[ -n ${ZSH_VERSION:-} ]]; then
    eval "$(mise activate zsh)"
  fi
fi
