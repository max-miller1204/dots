# Single source of truth for DOTS_PATH + PATH adjustments. Sourced by:
#   ~/.bashrc   (interactive and some non-interactive Bash sessions)
#   ~/.zshenv   (interactive and non-interactive Zsh sessions)
#   ~/.zshrc    (interactive Zsh, including direct/manual sourcing)
#
# The active release or developer checkout is stored as plain data in
# ~/.config/dots/path and deliberately never sourced as shell code. The
# installer rejects newlines, so one read recovers the path exactly, including
# spaces, quotes, backticks, and dollar signs.
dots_path_file="$HOME/.config/dots/path"
if [[ -L $HOME/.config || -L $HOME/.config/dots ||
      ( -e $dots_path_file || -L $dots_path_file ) && ( -L $dots_path_file || ! -f $dots_path_file ) ]]; then
  echo "Refusing unsafe dots runtime path hierarchy: $dots_path_file" >&2
  return 1 2>/dev/null || exit 1
fi
if [[ -f $dots_path_file ]]; then
  dots_path_value=""
  dots_path_count=0
  while IFS= read -r dots_path_line || [[ -n $dots_path_line ]]; do
    dots_path_count=$((dots_path_count + 1))
    dots_path_value=$dots_path_line
  done <"$dots_path_file"
  if ((dots_path_count == 1)) && [[ $dots_path_value == /* && $dots_path_value != *:* ]]; then
    DOTS_PATH=$dots_path_value
  else
    DOTS_PATH=""
  fi
fi
if [[ ${DOTS_PATH:-} != /* || $DOTS_PATH == *$'\n'* || $DOTS_PATH == *:* ]]; then
  DOTS_PATH="$HOME/dotfiles"
fi
unset dots_path_file dots_path_value dots_path_count dots_path_line
export DOTS_PATH

# Homebrew (macOS): dots uses Bash as its command runtime without changing the
# account login shell. Homebrew's bin must precede system dirs so
# `#!/usr/bin/env bash` resolves to modern Bash rather than 3.2. Support both
# Apple Silicon's /opt/homebrew and Intel's /usr/local without treating Linux
# /usr/local as Homebrew. GUI terminals may have reordered an existing entry
# behind /bin.
hb_prefix=""
if [[ $(uname -s) == "Darwin" ]]; then
  if [[ -x /opt/homebrew/bin/brew ]]; then
    hb_prefix=/opt/homebrew
  elif [[ -x /usr/local/bin/brew ]]; then
    hb_prefix=/usr/local
  fi
fi
if [[ -n $hb_prefix ]]; then
  hb_bin="$hb_prefix/bin" hb_sbin="$hb_prefix/sbin"
  PATH=":$PATH:"
  PATH="${PATH//:$hb_sbin:/:}"
  PATH="${PATH//:$hb_bin:/:}"
  PATH="${PATH#:}"
  PATH="${PATH%:}"
  PATH="$hb_bin:$hb_sbin${PATH:+:$PATH}"
  unset hb_bin hb_sbin
fi
unset hb_prefix

# The active immutable release (or explicitly linked developer checkout) owns
# the command tree, so its bin/ is always first, including after re-sourcing.
dots_bin="${DOTS_PATH%/}/bin"
PATH=":$PATH:"
PATH=${PATH//":$dots_bin:"/:}
PATH=${PATH#:}
PATH=${PATH%:}
PATH="$dots_bin${PATH:+:$PATH}"
unset dots_bin

# User-level tool paths, appended so system binaries keep precedence.
case ":$PATH:" in
  *":$HOME/.local/share/mise/shims:"*) ;;
  *) PATH="${PATH:+$PATH:}$HOME/.local/share/mise/shims" ;;
esac
case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) PATH="${PATH:+$PATH:}$HOME/.local/bin" ;;
esac
export PATH
