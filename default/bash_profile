# This file is yours. It is seeded from ~/dotfiles/default/bash_profile at
# install (with a backup of any previous version) and never touched by
# `dots update`. `dots reinstall configs` resets it to the shipped default.
#
# Login Bash reads this file and skips ~/.bashrc, so keep the interactive
# setup in one place and delegate to it here. This supports Linux login shells
# and macOS users who explicitly choose Homebrew Bash instead of the default
# Zsh login shell.

[ -f "$HOME/.bashrc" ] && . "$HOME/.bashrc"
