# This file is yours. It is seeded from the active dots runtime at install
# (with a backup of any previous version) and never touched by `dots update`.
# `dots reinstall configs` resets it to the shipped default.

# Resolve plain runtime-path data before env-bootstrap itself is available.
dots_bootstrap_path=""
if [[ -L $HOME/.config || -L $HOME/.config/dots ||
      ( -e $HOME/.config/dots/path || -L $HOME/.config/dots/path ) &&
      ( -L $HOME/.config/dots/path || ! -f $HOME/.config/dots/path ) ]]; then
  echo "Refusing unsafe dots runtime path hierarchy: $HOME/.config/dots/path" >&2
  return 1 2>/dev/null || exit 1
fi
if [[ -f $HOME/.config/dots/path ]]; then
  dots_bootstrap_count=0
  while IFS= read -r dots_bootstrap_line || [[ -n $dots_bootstrap_line ]]; do
    dots_bootstrap_count=$((dots_bootstrap_count + 1))
    dots_bootstrap_path=$dots_bootstrap_line
  done <"$HOME/.config/dots/path"
  ((dots_bootstrap_count == 1)) || dots_bootstrap_path=""
else
  dots_bootstrap_path=${DOTS_PATH:-}
fi
if [[ $dots_bootstrap_path != /* || $dots_bootstrap_path == *$'\n'* || $dots_bootstrap_path == *:* ]]; then
  dots_bootstrap_path="$HOME/dotfiles"
fi
dots_bootstrap_file="$dots_bootstrap_path/default/bash/env-bootstrap"
if [[ ! -r $dots_bootstrap_file ]]; then
  unset dots_bootstrap_path dots_bootstrap_file dots_bootstrap_count dots_bootstrap_line
  return 0 2>/dev/null || exit 0
fi
. "$dots_bootstrap_file"
unset dots_bootstrap_path dots_bootstrap_file dots_bootstrap_count dots_bootstrap_line

# Non-interactive Zsh gets its environment from ~/.zshenv. Keep aliases,
# history, completion, directory hooks, and prompts out of script shells.
[[ -o interactive ]] || return 0 2>/dev/null || exit 0
[[ -r $DOTS_PATH/default/bash/shell ]] || return 0 2>/dev/null || exit 0

# These defaults intentionally use syntax shared by Bash 5 and Zsh.
. "$DOTS_PATH/default/bash/shell"
. "$DOTS_PATH/default/bash/aliases"
. "$DOTS_PATH/default/bash/functions"
. "$DOTS_PATH/default/bash/init"

# Zsh uses ZLE rather than Readline, so mirror the useful inputrc bindings.
if [[ -o interactive ]]; then
  bindkey -e
  autoload -Uz up-line-or-beginning-search down-line-or-beginning-search
  zle -N up-line-or-beginning-search
  zle -N down-line-or-beginning-search
  bindkey '^[[A' up-line-or-beginning-search
  bindkey '^[[B' down-line-or-beginning-search
  bindkey '^[[Z' reverse-menu-complete
  zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'
  zstyle ':completion:*' menu select
fi
