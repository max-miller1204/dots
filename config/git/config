[init]
	defaultBranch = main

[pull]
	ff = only

[push]
	autoSetupRemote = true

[diff]
	algorithm = histogram
	colorMoved = plain
	mnemonicPrefix = true

[commit]
	verbose = true

[column]
	ui = auto
	status = never

[branch]
	sort = -committerdate

[tag]
	sort = -version:refname

[rerere]
	enabled = true
	autoupdate = true

[alias]
	st = status -sb
	co = checkout
	br = branch
	ci = commit
	lg = log --oneline --graph --decorate -20

[credential "https://github.com"]
	helper =
	helper = !\"$HOME/.local/share/mise/shims/gh\" auth git-credential

[credential "https://gist.github.com"]
	helper =
	helper = !\"$HOME/.local/share/mise/shims/gh\" auth git-credential
