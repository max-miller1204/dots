#!/usr/bin/env bash

# Cross-platform shell completion loading plus dots dispatcher candidates.

set -eo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
source "$ROOT/test/helpers.sh"
setup_sandbox

contains_line() { # contains_line <lines> <expected> <label>
  if grep -Fxq -- "$2" <<<"$1"; then
    assertions=$((assertions + 1))
  else
    fail "$3: expected line '$2' in:
$1"
  fi
}

excludes_line() { # excludes_line <lines> <unexpected> <label>
  if grep -Fxq -- "$2" <<<"$1"; then
    fail "$3: unexpected line '$2' in:
$1"
  fi
  assertions=$((assertions + 1))
}

helper="$ROOT/bin/dots-completion-candidates"

# Root and nested candidates mirror router visibility without exposing helper
# binaries or hidden implementation commands.
out=$("$helper")
contains_line "$out" theme "root completion includes visible group"
contains_line "$out" update "root completion includes executable group"
excludes_line "$out" cmd "root completion hides internal command"

theme_out=$("$helper" theme)
contains_line "$theme_out" set "nested completion includes immediate command"
contains_line "$theme_out" list "nested completion includes sibling command"
contains_line "$theme_out" sync "nested completion includes documented sync commands"
sync_out=$("$helper" theme sync)
contains_line "$sync_out" pi "sync completion includes public Pi integration"
contains_line "$sync_out" claude "sync completion includes public Claude integration"
excludes_line "$sync_out" btop "sync completion hides internal integrations"

migrate_out=$("$helper" migrate)
contains_line "$migrate_out" --pending "metadata option is completed"
contains_line "$migrate_out" --check "documented option alias is completed"
version_out=$("$helper" version)
contains_line "$version_out" prune "version prune command is completed"
prune_out=$("$helper" version prune)
contains_line "$prune_out" --force "version prune force option is completed"

mkdir -p "$HOME/.config/dots/themes/user-theme" "$HOME/.config/dots/themes/Invalid_Theme"
theme_values=$("$helper" theme set)
contains_line "$theme_values" tokyo-night "repository theme is completed"
contains_line "$theme_values" user-theme "user theme is completed"
excludes_line "$theme_values" Invalid_Theme "invalid theme identifiers are not completed"

hook_values=$("$helper" hook)
contains_line "$hook_values" install "hook subcommand is completed"
contains_line "$hook_values" post-install "supported hook event is completed"
contains_line "$hook_values" post-update "supported hook event is completed"
contains_line "$hook_values" theme-set "supported hook event is completed"

refresh_values=$("$helper" refresh config)
contains_line "$refresh_values" git/config "shipped config path is completed"
mkdir -p "$HOME/.config/completion-test"
printf 'valid\n' >"$HOME/.config/completion-test/valid"
printf 'invalid\n' >"$HOME/.config/completion-test/invalid..name"
import_values=$("$helper" config import)
contains_line "$import_values" completion-test/valid "live config path is completed"
excludes_line "$import_values" completion-test/invalid..name "rejected config path is not completed"
newline_config=$'completion-test/newline\nname'
printf 'valid\n' >"$HOME/.config/$newline_config"
mapfile -d '' -t nul_import_values < <("$helper" --null config import)
newline_found=""
for completion_value in "${nul_import_values[@]}"; do
  [[ $completion_value == "$newline_config" ]] && newline_found=1
done
[[ -n $newline_found ]] || fail "NUL-delimited completion dropped a newline-bearing config path"
assertions=$((assertions + 1))

# A checkout path containing spaces exercises arbitrary nested commands, enum
# metadata, options, and hidden filtering without changing the real bin tree.
fixture_repo="$SANDBOX/completion repo"
mkdir -p "$fixture_repo/bin" "$fixture_repo/install/helpers" "$fixture_repo/themes/repo-theme"
cp "$helper" "$fixture_repo/bin/dots-completion-candidates"
cp "$ROOT/install/helpers/metadata.sh" "$fixture_repo/install/helpers/metadata.sh"
cp "$ROOT/install/helpers/files.sh" "$fixture_repo/install/helpers/files.sh"
cat >"$fixture_repo/bin/dots-alpha" <<'EOF'
#!/usr/bin/env bash
# dots:args=<one|two> [--force]
EOF
cat >"$fixture_repo/bin/dots-alpha-beta-gamma" <<'EOF'
#!/usr/bin/env bash
EOF
cat >"$fixture_repo/bin/dots-alpha-hidden" <<'EOF'
#!/usr/bin/env bash
# dots:hidden=true
EOF
chmod +x "$fixture_repo/bin"/*
fixture_out=$(DOTS_PATH="$fixture_repo" "$fixture_repo/bin/dots-completion-candidates" alpha)
contains_line "$fixture_out" beta "deep command exposes only its next segment"
contains_line "$fixture_out" one "enum metadata first value is completed"
contains_line "$fixture_out" two "enum metadata second value is completed"
contains_line "$fixture_out" --force "fixture metadata option is completed"
excludes_line "$fixture_out" hidden "hidden fixture command is excluded"
deep_out=$(DOTS_PATH="$fixture_repo" "$fixture_repo/bin/dots-completion-candidates" alpha beta)
contains_line "$deep_out" gamma "third-level command is completed"

# Bash discovers the framework loader under a PATH prefix and then loads the
# dots adapter after third-party shell integrations.
completion_prefix="$SANDBOX/completion-prefix"
mkdir -p "$completion_prefix/bin" "$completion_prefix/share/bash-completion"
cat >"$completion_prefix/share/bash-completion/bash_completion" <<'EOF'
BASH_COMPLETION_VERSINFO=(2 99)
_completion_loader() { :; }
EOF
bash_bin=$(command -v bash)
PATH="$completion_prefix/bin:/usr/bin:/bin" DOTS_PATH="$ROOT" TERM=dumb \
  "$bash_bin" --noprofile --norc -ic \
  'source "$1"; declare -F _completion_loader >/dev/null;
    declare -F _dots_complete >/dev/null; complete -p dots >/dev/null;
    ((BASH_VERSINFO[0] < 5)) ||
      [[ $(complete -p -I) == *"-o bashdefault -o default"*"dots-*"* ]]' \
  bash "$ROOT/default/bashrc" || fail "interactive Bash did not load completion framework and dots adapter"
assertions=$((assertions + 1))

# Verify that Bash loads the mise GitHub release when a system framework is
# already loaded. Also verify that MISE_DATA_DIR specifies the data directory.
mise_data_dir="$SANDBOX/mise-data"
mise_completion_dir="$mise_data_dir/installs/github-scop-bash-completion/latest"
mkdir -p "$mise_completion_dir"
cat >"$mise_completion_dir/bash_completion" <<'EOF'
BASH_COMPLETION_VERSINFO=(2 100)
_mise_completion_loader() { :; }
EOF
MISE_DATA_DIR="$mise_data_dir" PATH="$completion_prefix/bin:/usr/bin:/bin" \
  DOTS_PATH="$ROOT" TERM=dumb "$bash_bin" --noprofile --norc -ic \
  'BASH_COMPLETION_VERSINFO=(2 99); _system_completion_loader() { :; };
    source "$1"; [[ ${BASH_COMPLETION_VERSINFO[*]} == "2 100" ]];
    declare -F _system_completion_loader >/dev/null;
    declare -F _mise_completion_loader >/dev/null;
    declare -F _dots_complete >/dev/null; complete -p dots >/dev/null' \
  bash "$ROOT/default/bashrc" || fail "interactive Bash did not load the mise completion framework first"
assertions=$((assertions + 1))

# Run this check with DOTS_TEST_REAL_MISE set to the mise executable. It uses
# the GitHub backend to verify the installed layout and tmux completion.
if [[ -n ${DOTS_TEST_REAL_MISE:-} ]]; then
  [[ -x $DOTS_TEST_REAL_MISE ]] || fail "DOTS_TEST_REAL_MISE is not executable"
  real_mise_home="$SANDBOX/real-mise-home"
  real_mise_config_dir="$real_mise_home/.config/mise"
  real_mise_data_dir="$real_mise_home/.local/share/mise"
  real_mise_cache_dir="$real_mise_home/.cache/mise"
  real_mise_bin_dir="$real_mise_home/bin"
  mkdir -p "$real_mise_config_dir" "$real_mise_data_dir" \
    "$real_mise_cache_dir" "$real_mise_bin_dir"
  ln -s "$DOTS_TEST_REAL_MISE" "$real_mise_bin_dir/mise"
  (
    cd "$real_mise_home"
    HOME="$real_mise_home" XDG_CONFIG_HOME="$real_mise_home/.config" \
      MISE_CONFIG_DIR="$real_mise_config_dir" \
      MISE_GLOBAL_CONFIG_FILE="$real_mise_config_dir/config.toml" \
      MISE_DATA_DIR="$real_mise_data_dir" MISE_CACHE_DIR="$real_mise_cache_dir" \
      PATH="$real_mise_bin_dir:$PATH" DOTS_PATH="$ROOT" \
      bash "$ROOT/migrations/1788459720.sh" >/dev/null
  ) || fail "mise did not install Bash completion"

  real_completion_root="$real_mise_data_dir/installs/github-scop-bash-completion/latest"
  [[ -r $real_completion_root/bash_completion &&
    -d $real_completion_root/completions ]] ||
    fail "mise did not remove the release archive directory"
  assertions=$((assertions + 1))

  real_bin_paths=$(HOME="$real_mise_home" \
    XDG_CONFIG_HOME="$real_mise_home/.config" MISE_CONFIG_DIR="$real_mise_config_dir" \
    MISE_GLOBAL_CONFIG_FILE="$real_mise_config_dir/config.toml" \
    MISE_DATA_DIR="$real_mise_data_dir" MISE_CACHE_DIR="$real_mise_cache_dir" \
    "$DOTS_TEST_REAL_MISE" -C "$real_mise_home" bin-paths)
  contains_line "$real_bin_paths" "$real_completion_root/completions" \
    "mise exposes only Bash completion data"
  excludes_line "$real_bin_paths" "$real_completion_root" \
    "mise does not expose Bash completion build scripts"

  MISE_DATA_DIR="$real_mise_data_dir" PATH="$completion_prefix/bin:/usr/bin:/bin" \
    bash --noprofile --norc -c \
    'BASH_COMPLETION_VERSINFO=(2 99); source "$1";
      [[ ${BASH_COMPLETION_VERSINFO[*]} != "2 99" ]];
      declare -F _comp_load >/dev/null; _comp_load tmux;
      complete -p tmux >/dev/null' \
    bash "$ROOT/default/bash/shell" ||
    fail "the installed mise release did not provide tmux completion"
  assertions=$((assertions + 1))
fi

# Exercise Bash's current-word filtering through the registered adapter.
DOTS_PATH="$ROOT" bash --noprofile --norc -c \
  'source "$1"; COMP_WORDS=(dots theme se); COMP_CWORD=2; _dots_complete;
    [[ ${COMPREPLY[*]} == "set" ]]' \
  bash "$ROOT/default/bash/completions" || fail "Bash dots adapter returned wrong nested candidate"
assertions=$((assertions + 1))

# Zsh finds the native _dots definition through fpath before compinit scans it.
if command -v zsh >/dev/null 2>&1; then
  PATH="/usr/bin:/bin" DOTS_PATH="$ROOT" TERM=dumb zsh -fic \
    'source "$1"; (( $+functions[_dots] && ${fpath[(Ie)$2/default/zsh/site-functions]} &&
      ${+_comps[dots]} ))' \
    zsh "$ROOT/default/zshrc" "$ROOT" || fail "interactive Zsh did not register native dots completion"

  zsh_out=$(DOTS_PATH="$ROOT" zsh -fc '
    compadd() {
      local candidate current=${words[CURRENT]} matched=1
      shift
      for candidate in "$@"; do
        if [[ $candidate == "$current"* ]]; then
          print -r -- "$candidate"
          matched=0
        fi
      done
      return $matched
    }
    _default() { return 1; }
    words=(dots theme se)
    CURRENT=3
    source "$1"
  ' zsh "$ROOT/default/zsh/site-functions/_dots")
  [[ $zsh_out == "set" ]] || fail "Zsh dots adapter returned wrong nested candidate: $zsh_out"
  assertions=$((assertions + 2))
fi

printf 'ok: %d assertions passed (completion)\n' "$assertions"
