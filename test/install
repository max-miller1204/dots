#!/usr/bin/env bash

# Fresh-install durability: manifest ordering, completion markers, and safe
# checkout-path persistence. System/user provisioning is stubbed so this suite
# never touches the host package manager or OS settings.

set -eo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
source "$ROOT/test/helpers.sh"
setup_sandbox

repo="$SANDBOX/repo space 'quote \$dollar \`tick"
mkdir -p "$repo"
canonical_repo=$(cd "$repo" && pwd)
cp -R "$ROOT/bin" "$ROOT/config" "$ROOT/default" "$ROOT/install" "$ROOT/migrations" "$repo/"
printf '# test: system provisioning stubbed\n' >"$repo/install/config/all.sh"
printf '# test: user provisioning stubbed\n' >"$repo/install/user/all.sh"
newline_config=$'newline-name\ncontinued'
newline_parent=$'newline-dir\ncontinued'
printf 'newline config\n' >"$repo/config/$newline_config"
mkdir -p "$repo/config/$newline_parent"
printf 'newline parent config\n' >"$repo/config/$newline_parent/file"

stub="$SANDBOX/stub"
mkdir -p "$stub"
cat >"$stub/mise" <<'MISE'
#!/usr/bin/env bash
[[ -f $HOME/.config/mise/config.toml ]] || {
  echo "manifest missing before mise" >&2
  exit 9
}
printf '%s\n' "$*" >>"$HOME/mise-calls"
MISE
chmod +x "$stub/mise"

# Launch from outside the checkout; mise must still see the seeded live manifest.
(
  cd /
  PATH="$stub:/usr/bin:/bin" "$repo/bin/dots-install" >/dev/null
)
[[ -f "$HOME/.config/mise/config.toml" ]] || fail "fresh install did not seed mise manifest"
grep -q '^install$' "$HOME/mise-calls" || fail "fresh install did not run mise after seeding"
[[ $(cat "$HOME/.config/dots/path") == "$canonical_repo" ]] || fail "checkout path was not stored as plain data"
[[ ! -e "$HOME/.config/dots/dots.conf" && ! -L "$HOME/.config/dots/dots.conf" ]] || fail "install wrote executable dots.conf"
[[ -f "$HOME/.local/state/dots/done/install" ]] || fail "successful install was not marked complete"
[[ -f "$HOME/.config/$newline_config" ]] || fail "fresh install split a newline-bearing config filename"
[[ -f "$HOME/.config/$newline_parent/file" ]] || fail "fresh install split a newline-bearing config directory"
assertions=$((assertions + 7))

# A package convergence failure aborts and never creates the install marker.
failed_home="$SANDBOX/failed-home"
mkdir -p "$failed_home" "$SANDBOX/failing-stub"
cat >"$SANDBOX/failing-stub/mise" <<'MISE'
#!/usr/bin/env bash
exit 23
MISE
chmod +x "$SANDBOX/failing-stub/mise"
if HOME="$failed_home" PATH="$SANDBOX/failing-stub:/usr/bin:/bin" \
  "$repo/bin/dots-install" >/dev/null 2>&1; then
  fail "install succeeded after mise failed"
fi
[[ ! -e "$failed_home/.local/state/dots/done/install" ]] || fail "failed install was marked complete"
assertions=$((assertions + 2))

# Install refuses a symlinked config parent rather than seeding an external tree.
linked_home="$SANDBOX/linked-home"
linked_target="$SANDBOX/linked-config-target"
mkdir -p "$linked_home" "$linked_target"
ln -s "$linked_target" "$linked_home/.config"
if HOME="$linked_home" PATH="$stub:/usr/bin:/bin" "$repo/bin/dots-install" >/dev/null 2>&1; then
  fail "install accepted a symlinked .config parent"
fi
[[ ! -e "$linked_target/dots/path" ]] || fail "install wrote through symlinked .config"
[[ ! -e "$linked_home/.local/state/dots/done/install" ]] || fail "symlink-rejected install was marked complete"
assertions=$((assertions + 3))

linked_state_home="$SANDBOX/linked-state-home"
linked_state_target="$SANDBOX/linked-state-target"
mkdir -p "$linked_state_home" "$linked_state_target"
ln -s "$linked_state_target" "$linked_state_home/.local"
if HOME="$linked_state_home" PATH="$stub:/usr/bin:/bin" "$repo/bin/dots-install" >/dev/null 2>&1; then
  fail "install accepted a symlinked state parent"
fi
[[ ! -e "$linked_state_target/state/dots/install.log" ]] || fail "install logged through symlinked state parent"
[[ ! -e "$linked_state_target/state/dots/done/install" ]] || fail "symlink-state install was marked complete"
assertions=$((assertions + 3))

linked_log_home="$SANDBOX/linked-log-home"
mkdir -p "$linked_log_home/.local/state/dots"
printf 'foreign log\n' >"$SANDBOX/foreign-install-log"
ln -s "$SANDBOX/foreign-install-log" "$linked_log_home/.local/state/dots/install.log"
if HOME="$linked_log_home" PATH="$stub:/usr/bin:/bin" "$repo/bin/dots-install" >/dev/null 2>&1; then
  fail "install accepted a symlinked log file"
fi
[[ $(cat "$SANDBOX/foreign-install-log") == "foreign log" ]] || fail "install wrote through log symlink"
assertions=$((assertions + 2))

linked_done_home="$SANDBOX/linked-done-home"
mkdir -p "$linked_done_home/.local/state/dots/done"
ln -s "$SANDBOX/dangling-install-done" "$linked_done_home/.local/state/dots/done/install"
if HOME="$linked_done_home" PATH="$stub:/usr/bin:/bin" "$repo/bin/dots-install" >/dev/null 2>&1; then
  fail "install accepted a symlinked completion marker"
fi
[[ ! -e "$SANDBOX/dangling-install-done" ]] || fail "install created completion marker target"
[[ ! -e "$linked_done_home/.config/dots/path" ]] || fail "install mutated config before rejecting completion marker"
assertions=$((assertions + 3))

# A checkout path that cannot be represented safely is rejected before setup.
bad_repo="$SANDBOX/repo:invalid"
cp -R "$repo" "$bad_repo"
bad_home="$SANDBOX/bad-home"
mkdir -p "$bad_home"
if HOME="$bad_home" PATH="$stub:/usr/bin:/bin" "$bad_repo/bin/dots-install" >/dev/null 2>&1; then
  fail "install accepted a colon-delimited checkout path"
fi
[[ ! -e "$bad_home/.local/state/dots/done/install" ]] || fail "invalid-path install was marked complete"
assertions=$((assertions + 2))

echo "ok: $assertions assertions passed (install)"
