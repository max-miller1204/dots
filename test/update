#!/usr/bin/env bash

# Update pipeline suite: lock, free-space guard, log analysis, restart
# markers, update-available, and a stubbed end-to-end dots-update run.

set -eo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
source "$ROOT/test/helpers.sh"
setup_sandbox

git_test() { git -c user.email=test@test -c user.name=test -c commit.gpgsign=false "$@"; }

# Stub mise up front: several later invocations run the full dots-update
# pipeline, and none of them may touch the real mise.
mkdir -p "$SANDBOX/stub"
cat >"$SANDBOX/stub/mise" <<'EOF'
#!/usr/bin/env bash
echo "stub mise $*"
EOF
chmod +x "$SANDBOX/stub/mise"

# A missing macOS flock is diagnosed without mutating package state.
flock_stub="$SANDBOX/flock-diagnostic-stub"
mkdir -p "$flock_stub"
ln -s "$(command -v bash)" "$flock_stub/bash"
cat >"$flock_stub/uname" <<'EOF'
#!/usr/bin/env bash
printf 'Darwin\n'
EOF
cat >"$flock_stub/brew" <<'EOF'
#!/usr/bin/env bash
touch "${0%/*}/brew-called"
EOF
chmod +x "$flock_stub/uname" "$flock_stub/brew"
rc=0
out=$(PATH="$flock_stub" "$ROOT/bin/dots-ensure-flock" 2>&1) || rc=$?
((rc == 1)) || fail "missing flock diagnostic should exit 1 (got $rc)"
assert_contains "$out" "dots install" "missing macOS flock has actionable guidance"
[[ ! -e "$flock_stub/brew-called" ]] || fail "flock diagnostic invoked Homebrew"
assertions=$((assertions + 1))

# The update lock performs the one unlocked bootstrap needed to make the
# historical flock-healing migration reachable on existing macOS installs.
flock_repair_repo="$SANDBOX/flock-repair-repo"
flock_repair_bin="$SANDBOX/flock-repair-bin"
flock_repair_home="$SANDBOX/flock-repair-home"
mkdir -p "$flock_repair_repo/bin" "$flock_repair_repo/install/config" \
  "$flock_repair_repo/install/helpers" "$flock_repair_bin" "$flock_repair_home"
cp "$ROOT/bin/dots-update-lock" "$flock_repair_repo/bin/dots-update-lock"
cp "$ROOT/install/config/flock.sh" "$flock_repair_repo/install/config/flock.sh"
cp "$ROOT/install/helpers/files.sh" "$ROOT/install/helpers/runtime.sh" \
  "$flock_repair_repo/install/helpers/"
ln -s "$(command -v bash)" "$flock_repair_bin/bash"
ln -s "$(command -v dirname)" "$flock_repair_bin/dirname"
ln -s "$(command -v ln)" "$flock_repair_bin/ln"
cat >"$flock_repair_repo/bin/dots-path-resolve" <<EOF
#!/usr/bin/env bash
printf '%s\\n' '$flock_repair_repo'
EOF
cat >"$flock_repair_repo/bin/dots-ensure-flock" <<'EOF'
#!/usr/bin/env bash
command -v flock >/dev/null 2>&1 || exit 90
printf 'repaired\n' >"$HOME/flock-repaired"
exit 73
EOF
cat >"$flock_repair_bin/uname" <<'EOF'
#!/usr/bin/env bash
printf 'Darwin\n'
EOF
true_path=$(type -P true)
cat >"$flock_repair_bin/brew" <<EOF
#!/usr/bin/env bash
printf 'called\\n' >"\$HOME/brew-called"
ln -s "$true_path" "\${0%/*}/flock"
EOF
chmod +x "$flock_repair_repo/bin/"* "$flock_repair_bin/uname" "$flock_repair_bin/brew"
rc=0
HOME="$flock_repair_home" PATH="$flock_repair_bin" \
  "$flock_repair_repo/bin/dots-update-lock" /bin/true >/dev/null 2>&1 || rc=$?
((rc == 73)) || fail "update lock did not reach flock bootstrap (got $rc)"
[[ -f $flock_repair_home/brew-called ]] || fail "update lock did not invoke the flock bootstrap"
[[ -f $flock_repair_home/flock-repaired ]] || fail "update lock did not continue after installing flock"
assertions=$((assertions + 3))

# --- adoption migration: missing defaults are installed, user shell files are
# preserved, Git defaults are merged, and mise receives the shipped tool set.
printf '# custom shell\n' >"$HOME/.bashrc"
printf '# custom zsh\n' >"$HOME/.zshrc"
migration_out=$(PATH="$SANDBOX/stub:$PATH" \
  GIT_CONFIG_GLOBAL="$HOME/.config/git/config" \
  DOTS_PATH="$ROOT" bash "$ROOT/migrations/1788046742.sh" 2>&1)
[[ $(cat "$HOME/.bashrc") == "# custom shell" ]] || fail "migration replaced a customized bashrc"
[[ $(cat "$HOME/.zshrc") == "# custom zsh" ]] || fail "migration replaced a customized zshrc"
[[ ! -e "$HOME/.config/dots/hooks/theme-set.d/10-sync-app-themes" ]] || fail "migration installed built-in logic as a user hook"
[[ -f "$HOME/.config/ghostty/config" ]] || fail "migration did not install missing app config"
[[ $(GIT_CONFIG_GLOBAL="$HOME/.config/git/config" git config --global --get diff.algorithm) == "histogram" ]] || fail "migration did not merge Git defaults"
assert_contains "$migration_out" "stub mise use --global" "migration merges mise tool manifest"
assertions=$((assertions + 5))

adoption_fixtures="$ROOT/migrations/fixtures/1788046742"
adoption_link_home="$SANDBOX/adoption-link-home"
adoption_link_targets="$SANDBOX/adoption-link-targets"
mkdir -p "$adoption_link_home" "$adoption_link_targets"
cp "$adoption_fixtures/bashrc.old" "$adoption_link_targets/bashrc"
cp "$adoption_fixtures/zshrc.old" "$adoption_link_targets/zshrc"
ln -s "$adoption_link_targets/bashrc" "$adoption_link_home/.bashrc"
ln -s "$adoption_link_targets/zshrc" "$adoption_link_home/.zshrc"
HOME="$adoption_link_home" PATH="$SANDBOX/stub:$PATH" \
  GIT_CONFIG_GLOBAL="$adoption_link_home/.config/git/config" \
  DOTS_PATH="$ROOT" bash "$ROOT/migrations/1788046742.sh" >/dev/null
[[ -L $adoption_link_home/.bashrc ]] || fail "adoption migration replaced a stock bashrc symlink"
[[ -L $adoption_link_home/.zshrc ]] || fail "adoption migration replaced a stock zshrc symlink"
cmp -s "$adoption_link_targets/bashrc" "$adoption_fixtures/bashrc.old" || fail "adoption migration altered a bashrc symlink target"
cmp -s "$adoption_link_targets/zshrc" "$adoption_fixtures/zshrc.old" || fail "adoption migration altered a zshrc symlink target"
assertions=$((assertions + 4))

# A failed manifest merge keeps the adoption migration pending for the next
# update instead of recording a partially applied migration as complete.
retry_repo="$SANDBOX/retry-repo"
retry_home="$SANDBOX/retry-home"
retry_state="$retry_home/.local/state/dots/migrations"
mkdir -p "$retry_repo/migrations" "$retry_repo/bin" "$retry_repo/install/helpers" \
  "$retry_home" "$SANDBOX/failing-stub"
cp -R "$ROOT/config" "$ROOT/default" "$retry_repo/"
cp "$ROOT/migrations/1788046742.sh" "$retry_repo/migrations/1788046742.sh"
mkdir -p "$retry_repo/migrations/fixtures"
cp -R "$ROOT/migrations/fixtures/1788046742" "$retry_repo/migrations/fixtures/"
cp "$ROOT/bin/dots-migrate" "$ROOT/bin/dots-path-resolve" "$ROOT/bin/dots-ensure-flock" \
  "$ROOT/bin/dots-update-restart" "$retry_repo/bin/"
cp "$ROOT/install/helpers/files.sh" "$ROOT/install/helpers/runtime.sh" \
  "$retry_repo/install/helpers/"
cat >"$SANDBOX/failing-stub/mise" <<'EOF'
#!/usr/bin/env bash
printf '%s\n' "$*" >>"$HOME/mise-retry-calls"
[[ ${3:-} != "claude@2" ]]
EOF
chmod +x "$SANDBOX/failing-stub/mise"
cp "$adoption_fixtures/bashrc.old" "$retry_home/.bashrc"
cp "$adoption_fixtures/zshrc.old" "$retry_home/.zshrc"
if HOME="$retry_home" PATH="$SANDBOX/failing-stub:$PATH" DOTS_PATH="$retry_repo" \
  DOTS_MIGRATION_STATE="$retry_state" GIT_CONFIG_GLOBAL="$retry_home/gitconfig" \
  "$ROOT/bin/dots-migrate" >/dev/null 2>&1; then
  fail "adoption migration succeeded after mise manifest merge failed"
fi
[[ ! -e "$retry_state/1788046742.sh" ]] || fail "failed adoption migration was marked complete"
grep -qx 'use --global claude@2' "$retry_home/mise-retry-calls" ||
  fail "adoption migration did not attempt the pinned Claude major"
grep -qx 'use --global codex@latest' "$retry_home/mise-retry-calls" ||
  fail "one tool failure prevented later tools from being merged"
cmp -s "$retry_home/.bashrc" "$retry_repo/default/bashrc" ||
  fail "tool failure prevented later shell migration work"
[[ ! -e "$retry_home/.config/nvim/lua/plugins/example.lua" ]] ||
  fail "adoption migration restored the removed Neovim starter file"

missing_source_home="$SANDBOX/missing-source-home"
missing_source_state="$missing_source_home/.local/state/dots/migrations"
mkdir -p "$missing_source_home"
cp "$adoption_fixtures/bashrc.old" "$missing_source_home/.bashrc"
rm "$retry_repo/config/ghostty/config"
if HOME="$missing_source_home" PATH="$SANDBOX/stub:$PATH" DOTS_PATH="$retry_repo" \
  DOTS_MIGRATION_STATE="$missing_source_state" GIT_CONFIG_GLOBAL="$missing_source_home/gitconfig" \
  "$ROOT/bin/dots-migrate" >/dev/null 2>&1; then
  fail "adoption migration accepted a missing shipped config"
fi
[[ ! -e $missing_source_state/1788046742.sh ]] ||
  fail "adoption migration with missing source was marked complete"
[[ -f $missing_source_home/.config/tmux/tmux.conf ]] ||
  fail "one missing config prevented later configs from being installed"
cmp -s "$missing_source_home/.bashrc" "$retry_repo/default/bashrc" ||
  fail "one missing config prevented later shell migration work"
assertions=$((assertions + 10))

# A machine temporarily missing Git keeps the adoption migration pending while
# later independent shell work still completes.
no_git_bin="$SANDBOX/no-git-bin"
no_git_home="$SANDBOX/no-git-home"
mkdir -p "$no_git_bin" "$no_git_home"
for required_command in bash cmp cp dirname env mkdir mktemp mv rm uname; do
  ln -s "$(command -v "$required_command")" "$no_git_bin/$required_command"
done
cat >"$no_git_bin/mise" <<'EOF'
#!/usr/bin/env bash
exit 0
EOF
chmod +x "$no_git_bin/mise"
cp "$adoption_fixtures/bashrc.old" "$no_git_home/.bashrc"
rc=0
out=$(HOME="$no_git_home" PATH="$no_git_bin" DOTS_PATH="$ROOT" \
  "$BASH" "$ROOT/migrations/1788046742.sh" 2>&1) || rc=$?
((rc != 0)) || fail "adoption migration succeeded without Git"
assert_contains "$out" "git is required" "adoption migration reports missing Git"
cmp -s "$no_git_home/.bashrc" "$ROOT/default/bashrc" ||
  fail "missing Git prevented later shell migration work"
assertions=$((assertions + 3))

# --- durability migration: executable path config and legacy integration
# plumbing are retired without executing them; namespaced links replace only
# the exact links previously owned by dots.
durable_home="$SANDBOX/durable-home"
mkdir -p "$durable_home/.config/dots/hooks/theme-set.d" "$durable_home/.config/btop/themes" \
  "$durable_home/.config/nvim/lua/plugins" "$durable_home/.pi/agent"
printf 'touch "$HOME/legacy-config-executed"\n' >"$durable_home/.config/dots/dots.conf"
cat >"$durable_home/.config/dots/hooks/theme-set.d/10-sync-app-themes" <<'EOF'
#!/usr/bin/env bash

# Keep installed applications pointed at the newly rendered active theme.

DOTS_PATH=${DOTS_PATH:-$HOME/dotfiles}

"$DOTS_PATH/bin/dots-theme-sync-btop"
"$DOTS_PATH/bin/dots-theme-sync-neovim"
"$DOTS_PATH/bin/dots-theme-sync-pi"
"$DOTS_PATH/bin/dots-theme-sync-claude"
"$DOTS_PATH/bin/dots-theme-sync-tmux"
EOF
printf 'color_theme = "current"\n' >"$durable_home/.config/btop/btop.conf"
printf '{"theme":"user-choice"}\n' >"$durable_home/.pi/agent/settings.json"
HOME="$durable_home" DOTS_PATH="$ROOT" "$ROOT/bin/dots-theme-set" tokyo-night >/dev/null
ln -s "$durable_home/.local/state/dots/current/theme/btop.theme" "$durable_home/.config/btop/themes/current.theme"
ln -s "$durable_home/.local/state/dots/current/theme/neovim.lua" "$durable_home/.config/nvim/lua/plugins/theme.lua"
HOME="$durable_home" DOTS_PATH="$ROOT" bash "$ROOT/migrations/1788049840.sh" >/dev/null
[[ ! -e "$durable_home/legacy-config-executed" ]] || fail "durability migration sourced legacy dots.conf"
[[ $(cat "$durable_home/.config/dots/path") == "$ROOT" ]] || fail "durability migration did not store plain checkout path"
[[ ! -e "$durable_home/.config/dots/dots.conf" && ! -L "$durable_home/.config/dots/dots.conf" ]] || fail "durability migration left dots.conf active"
[[ ! -e "$durable_home/.config/dots/hooks/theme-set.d/10-sync-app-themes" ]] || fail "durability migration left legacy built-in hook"
[[ ! -e "$durable_home/.config/btop/themes/current.theme" && ! -L "$durable_home/.config/btop/themes/current.theme" ]] || fail "durability migration left old btop link"
[[ ! -e "$durable_home/.config/nvim/lua/plugins/theme.lua" && ! -L "$durable_home/.config/nvim/lua/plugins/theme.lua" ]] || fail "durability migration left old Neovim link"
[[ -L "$durable_home/.config/btop/themes/dots-system.theme" ]] || fail "durability migration did not install namespaced btop link"
[[ -L "$durable_home/.config/nvim/lua/plugins/dots-system.lua" ]] || fail "durability migration did not install namespaced Neovim link"
[[ $(jq -r '.theme' "$durable_home/.pi/agent/settings.json") == "user-choice" ]] || fail "durability migration replaced Pi preference"
assertions=$((assertions + 9))

# Historical comparison fixtures preserve the exact bytes that shipped in the
# releases these migrations repair. Keep this oracle independent of the files.
while read -r expected_hash fixture_path; do
  if command -v sha256sum >/dev/null 2>&1; then
    actual_hash=$(sha256sum "$ROOT/migrations/fixtures/$fixture_path" | awk '{ print $1 }')
  else
    actual_hash=$(shasum -a 256 "$ROOT/migrations/fixtures/$fixture_path" | awk '{ print $1 }')
  fi
  [[ $actual_hash == "$expected_hash" ]] || fail "historical migration fixture changed: $fixture_path"
done <<'FIXTURE_HASHES'
c4d6a9915f21f7a4053433cabe1c520899b4c77843b7621c8a78d010fc29cd10 1788046742/bashrc.old
1451062f6508004bdbddcc7d01c15e8e90d059adddc717644f5aee54d130345e 1788046742/zshrc.old
1df0274dfb3aa0fc185db91134806d5f9a58f45ebbf63bde7533059b65b04da4 1788051792/bashrc.41d3229
3031b42ffd15bf80246b3fe80f3f101a5270acb6dca9dba50d43063795b6ef9a 1788051792/bashrc.intermediate
29a35dff597821a19960102ec7cad67bcdf6209da15e0f1ce1a86748ca3341a0 1788051792/bashrc.old
b17c9b5f096fc125e97050e359171c6011d6b3c7d7e9ac28f630e75b4d4bb9db 1788051792/starship.old
40bbe06f4227062b5c06e575669b747dd939be76312637ee7237a1b2090707e0 1788051792/zshrc.41d3229
aa636273d55583af8b426c116637f58e13b607d7cf3534d6d1482bf0326a35c0 1788051792/zshrc.intermediate
958775ede0aeb25006633178e5456e22dba135f458d99ebaf3f9fadd5cd4ec70 1788051792/zshrc.old
FIXTURE_HASHES
assertions=$((assertions + 9))

# --- final durability migration updates only the exact previously shipped
# shell and Starship files, preserving customized copies.
final_fixtures="$ROOT/migrations/fixtures/1788051792"
final_home="$SANDBOX/final-migration-home"
mkdir -p "$final_home/.config"
cp "$final_fixtures/bashrc.41d3229" "$final_home/.bashrc"
cp "$final_fixtures/zshrc.41d3229" "$final_home/.zshrc"
cp "$final_fixtures/starship.old" "$final_home/.config/starship.toml"
HOME="$final_home" DOTS_PATH="$ROOT" bash "$ROOT/migrations/1788051792.sh" >/dev/null
cmp -s "$final_home/.bashrc" "$ROOT/default/bashrc" || fail "final migration did not update stock bashrc"
cmp -s "$final_home/.zshrc" "$ROOT/default/zshrc" || fail "final migration did not update stock zshrc"
cmp -s "$final_home/.config/starship.toml" "$ROOT/config/starship.toml" || fail "final migration did not update stock Starship"
[[ -f "$final_home/.local/state/dots/restart-shell-required" ]] || fail "final shell migration left no restart marker"
for historical_variant in old intermediate; do
  variant_home="$SANDBOX/final-migration-$historical_variant-home"
  mkdir -p "$variant_home"
  cp "$final_fixtures/bashrc.$historical_variant" "$variant_home/.bashrc"
  cp "$final_fixtures/zshrc.$historical_variant" "$variant_home/.zshrc"
  HOME="$variant_home" DOTS_PATH="$ROOT" bash "$ROOT/migrations/1788051792.sh" >/dev/null
  cmp -s "$variant_home/.bashrc" "$ROOT/default/bashrc" ||
    fail "final migration did not update $historical_variant bashrc"
  cmp -s "$variant_home/.zshrc" "$ROOT/default/zshrc" ||
    fail "final migration did not update $historical_variant zshrc"
done
custom_home="$SANDBOX/custom-final-migration-home"
mkdir -p "$custom_home/.config"
cp "$final_fixtures/bashrc.41d3229" "$custom_home/.bashrc"
cp "$final_fixtures/zshrc.41d3229" "$custom_home/.zshrc"
cp "$final_fixtures/starship.old" "$custom_home/.config/starship.toml"
printf '# custom bash\n' >>"$custom_home/.bashrc"
printf '# custom zsh\n' >>"$custom_home/.zshrc"
printf '# custom starship\n' >>"$custom_home/.config/starship.toml"
HOME="$custom_home" DOTS_PATH="$ROOT" bash "$ROOT/migrations/1788051792.sh" >/dev/null
[[ $(tail -1 "$custom_home/.bashrc") == "# custom bash" ]] || fail "final migration replaced customized bashrc"
[[ $(tail -1 "$custom_home/.zshrc") == "# custom zsh" ]] || fail "final migration replaced customized zshrc"
[[ $(tail -1 "$custom_home/.config/starship.toml") == "# custom starship" ]] ||
  fail "final migration replaced customized Starship config"
link_home="$SANDBOX/link-final-migration-home"
link_targets="$SANDBOX/link-final-migration-targets"
mkdir -p "$link_home/.config" "$link_targets"
cp "$final_fixtures/bashrc.41d3229" "$link_targets/bashrc"
cp "$final_fixtures/zshrc.41d3229" "$link_targets/zshrc"
cp "$final_fixtures/starship.old" "$link_targets/starship.toml"
ln -s "$link_targets/bashrc" "$link_home/.bashrc"
ln -s "$link_targets/zshrc" "$link_home/.zshrc"
ln -s "$link_targets/starship.toml" "$link_home/.config/starship.toml"
HOME="$link_home" DOTS_PATH="$ROOT" bash "$ROOT/migrations/1788051792.sh" >/dev/null
[[ -L $link_home/.bashrc ]] || fail "final migration replaced a stock bashrc symlink"
[[ -L $link_home/.zshrc ]] || fail "final migration replaced a stock zshrc symlink"
[[ -L $link_home/.config/starship.toml ]] || fail "final migration replaced a stock Starship symlink"
cmp -s "$link_targets/bashrc" "$final_fixtures/bashrc.41d3229" || fail "final migration altered a bashrc symlink target"
cmp -s "$link_targets/zshrc" "$final_fixtures/zshrc.41d3229" || fail "final migration altered a zshrc symlink target"
cmp -s "$link_targets/starship.toml" "$final_fixtures/starship.old" || fail "final migration altered a Starship symlink target"
assertions=$((assertions + 17))

# The final migration adopts valid legacy theme generations, rejects foreign
# pointers and invalid theme names, and re-renders a valid current theme.
theme_migration_repo="$SANDBOX/theme-migration-repo"
mkdir -p "$theme_migration_repo/install/helpers" \
  "$theme_migration_repo/migrations/fixtures" "$theme_migration_repo/bin"
cp "$ROOT/install/helpers/files.sh" "$ROOT/install/helpers/theme-generation.sh" \
  "$theme_migration_repo/install/helpers/"
cp -R "$ROOT/migrations/fixtures/1788051792" "$theme_migration_repo/migrations/fixtures/"
cat >"$theme_migration_repo/bin/dots-theme-set" <<'EOF'
#!/usr/bin/env bash
printf '%s\n' "$1" >"$HOME/theme-set-called"
EOF
chmod +x "$theme_migration_repo/bin/dots-theme-set"
theme_migration_home="$SANDBOX/theme-migration-home"
theme_state="$theme_migration_home/.local/state/dots"
mkdir -p "$theme_state/theme-generations/generation.A1/theme" \
  "$theme_state/theme-generations/recovery.B2/theme"
printf 'nord\n' >"$theme_state/theme-generations/generation.A1/theme.name"
printf 'rose-pine\n' >"$theme_state/theme-generations/recovery.B2/theme.name"
ln -s theme-generations/generation.A1 "$theme_state/current"
ln -s theme-generations/recovery.B2 "$theme_state/theme-previous"
HOME="$theme_migration_home" DOTS_PATH="$theme_migration_repo" \
  bash "$ROOT/migrations/1788051792.sh" >/dev/null
for generation in generation.A1 recovery.B2; do
  [[ $(cat "$theme_state/theme-generations/$generation/.dots-theme-generation") == \
    "dots-theme-generation-v1" ]] || fail "final migration did not adopt $generation"
done
[[ $(cat "$theme_migration_home/theme-set-called") == "nord" ]] ||
  fail "final migration did not re-render the current theme"
foreign_pointer_home="$SANDBOX/foreign-theme-pointer-home"
foreign_state="$foreign_pointer_home/.local/state/dots"
mkdir -p "$foreign_state"
ln -s ../../outside-theme "$foreign_state/current"
if HOME="$foreign_pointer_home" DOTS_PATH="$theme_migration_repo" \
  bash "$ROOT/migrations/1788051792.sh" >/dev/null 2>&1; then
  fail "final migration accepted a foreign theme pointer"
fi
[[ -L $foreign_state/current ]] || fail "final migration replaced a foreign theme pointer"
invalid_theme_home="$SANDBOX/invalid-current-theme-home"
invalid_theme_state="$invalid_theme_home/.local/state/dots"
mkdir -p "$invalid_theme_state/theme-generations/generation.C3/theme"
printf '../bad\n' >"$invalid_theme_state/theme-generations/generation.C3/theme.name"
ln -s theme-generations/generation.C3 "$invalid_theme_state/current"
if HOME="$invalid_theme_home" DOTS_PATH="$theme_migration_repo" \
  bash "$ROOT/migrations/1788051792.sh" >/dev/null 2>&1; then
  fail "final migration accepted an invalid current theme name"
fi
[[ ! -e $invalid_theme_home/theme-set-called ]] ||
  fail "final migration invoked theme rendering for an invalid theme name"
assertions=$((assertions + 7))

# --- virtualenv prompt migration updates only the exact stock Starship config.
venv_fixture="$ROOT/test/fixtures/1788300252/starship.old"
venv_home="$SANDBOX/venv-migration-home"
mkdir -p "$venv_home/.config"
cp "$venv_fixture" "$venv_home/.config/starship.toml"
HOME="$venv_home" DOTS_PATH="$ROOT" bash "$ROOT/migrations/1788300252.sh" >/dev/null
cmp -s "$venv_home/.config/starship.toml" "$ROOT/config/starship.toml" ||
  fail "virtualenv migration did not update stock Starship config"
custom_venv_home="$SANDBOX/custom-venv-migration-home"
mkdir -p "$custom_venv_home/.config"
cp "$venv_fixture" "$custom_venv_home/.config/starship.toml"
printf '# custom prompt\n' >>"$custom_venv_home/.config/starship.toml"
HOME="$custom_venv_home" DOTS_PATH="$ROOT" bash "$ROOT/migrations/1788300252.sh" >/dev/null
[[ $(tail -1 "$custom_venv_home/.config/starship.toml") == "# custom prompt" ]] ||
  fail "virtualenv migration replaced customized Starship config"
linked_venv_home="$SANDBOX/linked-venv-migration-home"
mkdir -p "$linked_venv_home/.config"
cp "$venv_fixture" "$linked_venv_home/starship-target"
