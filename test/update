normalize_mise_toml() {
  local file=$1 byte_dump

  byte_dump=$(LC_ALL=C od -An -v -t x1 "$file") || return
  [[ ! $byte_dump =~ (^|[[:space:]])00($|[[:space:]]) ]] || return 1
  iconv -f UTF-8 -t UTF-8 "$file" >/dev/null 2>&1 || return
  LC_ALL=C awk -f "$ROOT/test/toml-normalize.awk" "$file"
}
