HOME="$tmux_home" DOTS_PATH="$ROOT" PATH="$SANDBOX/tmux-stub:$PATH" \
  "$ROOT/bin/dots-theme-sync-tmux"
grep -Fq "source-file $tmux_home/.local/state/dots/current/theme/tmux.conf" \
  "$tmux_home/tmux-calls" ||
  fail "live tmux did not source the generated user template override"
if grep -q '^set-option ' "$tmux_home/tmux-calls"; then
  fail "live tmux duplicated generated config with hardcoded options"
fi
assertions=$((assertions + 3))

# Palette parsing accepts only the documented top-level TOML subset and
# decodes safe basic-string escapes before rendering.
palette_home="$SANDBOX/palette-parser-home"
palette_theme="$palette_home/theme"
mkdir -p "$palette_theme" "$palette_home/.config/dots/themed"
cp "$ROOT/themes/tokyo-night/colors.toml" "$palette_theme/colors.toml"
printf '  # spaced comment\ncustom = "quote: \\" slash: \\\\ tab:\\t unicode-tab:\\u0009 unicode:\\u263A" # trailing\n' >>\
  "$palette_theme/colors.toml"
printf '{{ custom }}\n' >"$palette_home/.config/dots/themed/parser.txt.tpl"
HOME="$palette_home" DOTS_PATH="$ROOT" "$ROOT/bin/dots-theme-set-templates" "$palette_theme"
[[ $(cat "$palette_theme/parser.txt") == $'quote: " slash: \\ tab:\t unicode-tab:\t unicode:☺' ]] ||
  fail "theme palette parser did not decode safe basic-string escapes"
rm "$palette_home/.config/dots/themed/parser.txt.tpl"

# An explicitly empty derived key remains present and therefore suppresses the
# fallback from selection rather than being confused with an unset key.
empty_derived="$SANDBOX/empty-derived-theme"
mkdir -p "$empty_derived"
cp "$ROOT/themes/tokyo-night/colors.toml" "$empty_derived/colors.toml"
printf 'selection_background = ""\n' >>"$empty_derived/colors.toml"
HOME="$palette_home" DOTS_PATH="$ROOT" "$ROOT/bin/dots-theme-set-templates" "$empty_derived"
grep -q '^selection-background = $' "$empty_derived/ghostty.conf" ||
  fail "explicit empty derived palette value was treated as unset"

for invalid_palette_line in \
  'accent = "duplicate"' \
  '[nested]' \
  'bad = "value" trailing' \
  'bad = "unsafe\nvalue"' \
  'bad = "unsafe\u000Avalue"' \
  'bad = "unsafe\u0001value"' \
  'bad = "unsafe\U0000007Fvalue"' \
  'bad = "unterminated'; do
  invalid_palette="$SANDBOX/invalid-palette-$RANDOM"
  mkdir -p "$invalid_palette"
  cp "$ROOT/themes/tokyo-night/colors.toml" "$invalid_palette/colors.toml"
  printf '%s\n' "$invalid_palette_line" >>"$invalid_palette/colors.toml"
  invalid_palette_error=""
  if invalid_palette_error=$(HOME="$palette_home" DOTS_PATH="$ROOT" \
    "$ROOT/bin/dots-theme-set-templates" "$invalid_palette" 2>&1); then
    fail "theme parser accepted unsupported palette syntax: $invalid_palette_line"
  fi
  assert_contains "$invalid_palette_error" "Invalid theme palette" \
    "invalid palette reports its source clearly"
done
assertions=$((assertions + 2))

nul_palette="$SANDBOX/invalid-palette-nul"
nul_callback_marker="$SANDBOX/nul-palette-callback"
mkdir -p "$nul_palette"
cp "$ROOT/themes/tokyo-night/colors.toml" "$nul_palette/colors.toml"
printf 'bad = "before\0after"\n' >>"$nul_palette/colors.toml"
source "$ROOT/install/helpers/theme-palette.sh"
nul_palette_callback() {
  touch "$nul_callback_marker"
}
if dots_theme_palette_parse "$nul_palette/colors.toml" nul_palette_callback >/dev/null 2>&1; then
  fail "theme palette parser accepted an actual NUL byte"
fi
[[ ! -e $nul_callback_marker ]] || fail "theme palette parser invoked a callback before rejecting NUL"
printf '{{ bad }}\n' >"$palette_home/.config/dots/themed/nul.txt.tpl"
if HOME="$palette_home" DOTS_PATH="$ROOT" \
  "$ROOT/bin/dots-theme-set-templates" "$nul_palette" >/dev/null 2>&1; then
  fail "theme renderer accepted a palette containing an actual NUL byte"
fi
[[ ! -e $nul_palette/nul.txt ]] || fail "theme renderer wrote output for a NUL-bearing palette"
rm "$palette_home/.config/dots/themed/nul.txt.tpl"
assertions=$((assertions + 3))

# Layout-only generation validation is shared with migrations without taking
# on the stricter theme-name and ownership-marker checks used by theme-set.
layout_root="$SANDBOX/generation-layout"
mkdir -p "$layout_root/theme-generations/generation.TEST/theme"
printf 'INVALID migration-era name\n' >\
  "$layout_root/theme-generations/generation.TEST/theme.name"
DOTS_PATH="$ROOT" source "$ROOT/install/helpers/theme-generation.sh"
dots_theme_generation_layout_valid "$layout_root" 'theme-generations/generation.TEST' ||
  fail "shared generation layout rejected migration-compatible structure"
if dots_theme_generation_target_valid "$layout_root" 'theme-generations/generation.TEST'; then
  fail "strict generation ownership accepted invalid name and missing marker"
fi
assertions=$((assertions + 2))

# Foreign files and links at integration targets are never replaced.
rm "$HOME/.config/btop/themes/dots-system.theme" "$HOME/.config/nvim/lua/plugins/dots-system.lua"
printf 'foreign btop\n' >"$HOME/.config/btop/themes/dots-system.theme"
printf 'foreign nvim target\n' >"$HOME/foreign-nvim-theme"
ln -s "$HOME/foreign-nvim-theme" "$HOME/.config/nvim/lua/plugins/dots-system.lua"
"$ROOT/bin/dots" theme set tokyo-night >/dev/null 2>&1
[[ $(cat "$HOME/.config/btop/themes/dots-system.theme") == "foreign btop" ]] || fail "btop sync replaced foreign file"
[[ $(readlink "$HOME/.config/nvim/lua/plugins/dots-system.lua") == "$HOME/foreign-nvim-theme" ]] || fail "Neovim sync replaced foreign link"
[[ $(cat "$HOME/foreign-nvim-theme") == "foreign nvim target" ]] || fail "Neovim sync overwrote foreign target"
assertions=$((assertions + 3))

# Theme identifiers and source trees are constrained before staging.
for invalid_theme in ../tokyo-night Tokyo-Night tokyo/night; do
  if "$ROOT/bin/dots" theme set "$invalid_theme" >/dev/null 2>&1; then
    fail "theme set accepted unsafe name: $invalid_theme"
  fi
done
mkdir -p "$HOME/.config/dots/themes/symlinked"
ln -s "$ROOT/themes/tokyo-night/colors.toml" "$HOME/.config/dots/themes/symlinked/colors.toml"
if "$ROOT/bin/dots" theme set symlinked >/dev/null 2>&1; then
  fail "theme set accepted a symlink payload"
fi
dangling_render="$SANDBOX/dangling-render"
dangling_render_target="$SANDBOX/dangling-render-target"
mkdir -p "$dangling_render"
cp "$ROOT/themes/tokyo-night/colors.toml" "$dangling_render/colors.toml"
ln -s "$dangling_render_target" "$dangling_render/obsidian.css"
if "$ROOT/bin/dots-theme-set-templates" "$dangling_render" >/dev/null 2>&1; then
  fail "theme renderer accepted a dangling output symlink"
fi
[[ ! -e $dangling_render_target ]] || fail "theme renderer created a dangling symlink target"
[[ -L $dangling_render/obsidian.css ]] || fail "theme renderer replaced a dangling output symlink"
nonregular_render="$SANDBOX/nonregular-render"
mkdir -p "$nonregular_render/claude.json"
cp "$ROOT/themes/tokyo-night/colors.toml" "$nonregular_render/colors.toml"
if "$ROOT/bin/dots-theme-set-templates" "$nonregular_render" >/dev/null 2>&1; then
  fail "theme renderer accepted a non-regular output override"
fi
[[ -d $nonregular_render/claude.json ]] || fail "theme renderer replaced a non-regular output override"
linked_theme_home="$SANDBOX/linked-theme-state-home"
linked_theme_target="$SANDBOX/linked-theme-state-target"
mkdir -p "$linked_theme_home" "$linked_theme_target"
ln -s "$linked_theme_target" "$linked_theme_home/.local"
if HOME="$linked_theme_home" DOTS_PATH="$ROOT" "$ROOT/bin/dots-theme-set" tokyo-night >/dev/null 2>&1; then
  fail "theme set accepted a symlinked state parent"
fi
[[ ! -e "$linked_theme_target/state/dots/theme.lock" ]] || fail "theme set locked through state symlink"
unsafe_theme_lock_home="$SANDBOX/unsafe-theme-lock-home"
mkdir -p "$unsafe_theme_lock_home/.local/state/dots"
printf 'foreign theme lock\n' >"$SANDBOX/foreign-theme-lock"
ln -s "$SANDBOX/foreign-theme-lock" "$unsafe_theme_lock_home/.local/state/dots/theme.lock"
if HOME="$unsafe_theme_lock_home" DOTS_PATH="$ROOT" "$ROOT/bin/dots-theme-set" tokyo-night >/dev/null 2>&1; then
  fail "theme set accepted a symlink lock file"
fi
[[ $(cat "$SANDBOX/foreign-theme-lock") == "foreign theme lock" ]] || fail "theme set altered lock symlink target"
unsafe_generations_home="$SANDBOX/unsafe-generations-home"
mkdir -p "$unsafe_generations_home/.local/state/dots" "$SANDBOX/foreign-generations"
ln -s "$SANDBOX/foreign-generations" "$unsafe_generations_home/.local/state/dots/theme-generations"
if HOME="$unsafe_generations_home" DOTS_PATH="$ROOT" "$ROOT/bin/dots-theme-set" tokyo-night >/dev/null 2>&1; then
  fail "theme set accepted a symlinked generations directory"
fi
[[ -z $(find "$SANDBOX/foreign-generations" -mindepth 1 -print -quit) ]] || fail "theme set staged through generations symlink"
occupied_recovery_home="$SANDBOX/occupied-recovery-home"
mkdir -p "$occupied_recovery_home/.local/state/dots"
printf 'foreign recovery\n' >"$occupied_recovery_home/.local/state/dots/.theme-current-recovery"
if HOME="$occupied_recovery_home" DOTS_PATH="$ROOT" "$ROOT/bin/dots-theme-set" tokyo-night >/dev/null 2>&1; then
  fail "theme set accepted a regular recovery pointer occupant"
fi
[[ $(cat "$occupied_recovery_home/.local/state/dots/.theme-current-recovery") == "foreign recovery" ]] || fail "theme set removed foreign recovery occupant"
invalid_recovery_home="$SANDBOX/invalid-recovery-home"
mkdir -p "$invalid_recovery_home/.local/state/dots"
ln -s 'theme-generations/generation.MISSING' "$invalid_recovery_home/.local/state/dots/.theme-current-recovery"
if HOME="$invalid_recovery_home" DOTS_PATH="$ROOT" "$ROOT/bin/dots-theme-set" tokyo-night >/dev/null 2>&1; then
  fail "theme set removed an invalid recovery symlink"
fi
[[ -L "$invalid_recovery_home/.local/state/dots/.theme-current-recovery" ]] || fail "invalid recovery symlink was removed"
assertions=$((assertions + 19))

# Sed metacharacters in trusted local palette values render as literal data.
mkdir -p "$HOME/.config/dots/themes/escaped" "$HOME/.config/dots/themed"
cp "$ROOT/themes/tokyo-night/colors.toml" "$HOME/.config/dots/themes/escaped/colors.toml"
printf 'label = "a\\\\b&|c"\n' >>"$HOME/.config/dots/themes/escaped/colors.toml"
printf '{{ label }}\n' >"$HOME/.config/dots/themed/escape.txt.tpl"
"$ROOT/bin/dots" theme set escaped >/dev/null 2>&1
[[ $(cat "$HOME/.local/state/dots/current/theme/escape.txt") == 'a\b&|c' ]] || fail "theme renderer corrupted sed metacharacters"
rm -rf "$HOME/.config/dots/themes/escaped" "$HOME/.config/dots/themed/escape.txt.tpl"
assertions=$((assertions + 1))

incomplete_theme="$HOME/.config/dots/themes/incomplete"
mkdir -p "$incomplete_theme"
printf 'background = "#000000"\n' >"$incomplete_theme/colors.toml"
before_incomplete=$(readlink "$HOME/.local/state/dots/current")
before_incomplete_name=$(cat "$HOME/.local/state/dots/current/theme.name")
if "$ROOT/bin/dots" theme set incomplete >/dev/null 2>&1; then
  fail "theme set published an incomplete palette"
fi
[[ $(readlink "$HOME/.local/state/dots/current") == "$before_incomplete" ]] || fail "incomplete palette changed current generation"
[[ $(cat "$HOME/.local/state/dots/current/theme.name") == "$before_incomplete_name" ]] || fail "incomplete palette changed active theme"
rm -rf "$incomplete_theme"
assertions=$((assertions + 3))

before_collision=$(readlink "$HOME/.local/state/dots/current")
if DOTS_THEME_TEST_PRECREATE_GENERATION=1 "$ROOT/bin/dots-theme-set" tokyo-night >/dev/null 2>&1; then
  fail "theme set published into a pre-created generation destination"
fi
[[ $(readlink "$HOME/.local/state/dots/current") == "$before_collision" ]] || fail "generation collision changed current theme"
collision_dir=""
for candidate in "$HOME/.local/state/dots/theme-generations"/generation.*; do
  [[ -d $candidate && ! -f $candidate/.dots-theme-generation ]] && collision_dir=$candidate
done
[[ -n $collision_dir ]] || fail "generation collision test left no foreign destination"
rm -rf "$collision_dir"
assertions=$((assertions + 3))

# Real SIGKILL failpoints prove pointer ordering and next-run cleanup at the
# lifecycle boundaries that cannot be covered by constructing state manually.
crash_theme_set() { # crash_theme_set <failpoint> <theme> [home]
  local failpoint=$1 theme=$2 crash_home=${3:-$HOME} rc=0
  HOME="$crash_home" DOTS_PATH="$ROOT" DOTS_THEME_TEST_CRASH_AT="$failpoint" \
    bash -c '"$1" "$2" & child=$!; wait "$child"' bash \
      "$ROOT/bin/dots-theme-set" "$theme" >/dev/null 2>&1 || rc=$?
  ((rc != 0)) || fail "theme failpoint did not terminate: $failpoint"
}

before_crash=$(readlink "$HOME/.local/state/dots/current")
crash_theme_set after-previous-pointer catppuccin
[[ $(readlink "$HOME/.local/state/dots/current") == "$before_crash" ]] || fail "pre-commit crash changed current theme"
[[ $(readlink "$HOME/.local/state/dots/theme-previous") == "$before_crash" ]] || fail "pre-commit crash lost rollback generation"
"$ROOT/bin/dots" theme set catppuccin >/dev/null 2>&1
catppuccin_generation=$(readlink "$HOME/.local/state/dots/current")
crash_theme_set after-current-pointer tokyo-night
[[ $(cat "$HOME/.local/state/dots/current/theme.name") == "tokyo-night" ]] || fail "post-commit crash left an incomplete current theme"
[[ $(readlink "$HOME/.local/state/dots/theme-previous") == "$catppuccin_generation" ]] || fail "post-commit crash lost the genuine previous generation"
[[ -d "$HOME/.local/state/dots/$catppuccin_generation" ]] || fail "post-commit crash deleted previous generation"

crash_theme_set after-staging-build catppuccin
find "$HOME/.local/state/dots/theme-generations" -maxdepth 1 -type d -name '.staging.*' | grep -q . || fail "staging failpoint left no crash artifact"
crash_theme_set after-generation-rename catppuccin
[[ $(cat "$HOME/.local/state/dots/current/theme.name") == "tokyo-night" ]] || fail "generation-rename crash published early"
"$ROOT/bin/dots" theme set catppuccin >/dev/null 2>&1
if find "$HOME/.local/state/dots/theme-generations" -maxdepth 1 -type d -name '.staging.*' | grep -q .; then
  fail "next theme run did not prune abandoned staging"
fi
crash_theme_set after-pointer-temp tokyo-night
find "$HOME/.local/state/dots" -maxdepth 1 -type d -name '.theme-pointer.*' | grep -q . || fail "pointer failpoint left no crash artifact"
"$ROOT/bin/dots" theme set tokyo-night >/dev/null 2>&1
if find "$HOME/.local/state/dots" -maxdepth 1 -type d -name '.theme-pointer.*' | grep -q .; then
  fail "next theme run did not clean pointer crash artifact"
fi
previous_before_recovery_crash=$(readlink "$HOME/.local/state/dots/current")
crash_theme_set after-recovery-removal catppuccin
[[ $(cat "$HOME/.local/state/dots/current/theme.name") == "catppuccin" ]] || fail "recovery-removal crash lost committed current theme"
[[ $(readlink "$HOME/.local/state/dots/theme-previous") == "$previous_before_recovery_crash" ]] || fail "recovery-removal crash lost previous generation"
rc=0
HOME="$HOME" DOTS_PATH="$ROOT" DOTS_THEME_TEST_CRASH_DURING_PRUNE=1 \
  bash -c '"$1" rose-pine & child=$!; wait "$child"' bash "$ROOT/bin/dots-theme-set" \
    >/dev/null 2>&1 || rc=$?
((rc != 0)) || fail "theme prune failpoint did not terminate"
find "$HOME/.local/state/dots/theme-generations" -maxdepth 1 -type d -name '.pruning.*' | grep -q . || fail "prune crash left no resumable trash"
"$ROOT/bin/dots-theme-set" rose-pine >/dev/null 2>&1
if find "$HOME/.local/state/dots/theme-generations" -maxdepth 1 -type d -name '.pruning.*' | grep -q .; then
  fail "next theme run did not resume prune cleanup"
fi
assertions=$((assertions + 18))

legacy_home="$SANDBOX/legacy-theme-home"
mkdir -p "$legacy_home/.local/state/dots/current/theme"
cp "$ROOT/themes/tokyo-night/colors.toml" "$legacy_home/.local/state/dots/current/theme/colors.toml"
printf 'tokyo-night\n' >"$legacy_home/.local/state/dots/current/theme.name"
crash_theme_set after-legacy-move catppuccin "$legacy_home"
[[ ! -e "$legacy_home/.local/state/dots/current" && -L "$legacy_home/.local/state/dots/.theme-current-recovery" ]] || fail "legacy crash did not leave recoverable state"
HOME="$legacy_home" DOTS_PATH="$ROOT" "$ROOT/bin/dots-theme-set" catppuccin >/dev/null 2>&1
[[ $(cat "$legacy_home/.local/state/dots/current/theme.name") == "catppuccin" ]] || fail "legacy crash recovery did not complete theme"
legacy_previous=$(readlink "$legacy_home/.local/state/dots/theme-previous")
[[ -d "$legacy_home/.local/state/dots/$legacy_previous" ]] || fail "legacy crash recovery lost prior generation"
pre_move_legacy_home="$SANDBOX/pre-move-legacy-home"
mkdir -p "$pre_move_legacy_home/.local/state/dots/current/theme"
cp "$ROOT/themes/tokyo-night/colors.toml" "$pre_move_legacy_home/.local/state/dots/current/theme/colors.toml"
printf 'tokyo-night\n' >"$pre_move_legacy_home/.local/state/dots/current/theme.name"
crash_theme_set before-legacy-move catppuccin "$pre_move_legacy_home"
[[ -d "$pre_move_legacy_home/.local/state/dots/current" && -L "$pre_move_legacy_home/.local/state/dots/.theme-current-recovery" ]] || fail "pre-move crash did not preserve legacy current"
HOME="$pre_move_legacy_home" DOTS_PATH="$ROOT" "$ROOT/bin/dots-theme-set" catppuccin >/dev/null 2>&1
[[ $(cat "$pre_move_legacy_home/.local/state/dots/current/theme.name") == "catppuccin" ]] || fail "pre-move legacy recovery did not complete"
malformed_legacy_home="$SANDBOX/malformed-legacy-home"
mkdir -p "$malformed_legacy_home/.local/state/dots/current/theme"
if HOME="$malformed_legacy_home" DOTS_PATH="$ROOT" "$ROOT/bin/dots-theme-set" catppuccin >/dev/null 2>&1; then
  fail "theme set converted legacy state without theme.name"
fi
[[ -d "$malformed_legacy_home/.local/state/dots/current" ]] || fail "malformed legacy state was moved"
foreign_marker_home="$SANDBOX/foreign-legacy-marker-home"
mkdir -p "$foreign_marker_home/.local/state/dots/current/theme"
printf 'tokyo-night\n' >"$foreign_marker_home/.local/state/dots/current/theme.name"
printf 'foreign-marker\n' >"$foreign_marker_home/.local/state/dots/current/.dots-theme-generation"
if HOME="$foreign_marker_home" DOTS_PATH="$ROOT" "$ROOT/bin/dots-theme-set" catppuccin >/dev/null 2>&1; then
  fail "theme set overwrote a foreign legacy marker"
fi
[[ $(cat "$foreign_marker_home/.local/state/dots/current/.dots-theme-generation") == "foreign-marker" ]] || fail "legacy marker was overwritten"
legacy_symlink_home="$SANDBOX/legacy-symlink-home"
mkdir -p "$legacy_symlink_home/.local/state/dots/current/theme"
printf 'tokyo-night\n' >"$legacy_symlink_home/.local/state/dots/current/theme.name"
printf 'foreign legacy source\n' >"$SANDBOX/foreign-legacy-source"
ln -s "$SANDBOX/foreign-legacy-source" "$legacy_symlink_home/.local/state/dots/current/theme/linked"
if HOME="$legacy_symlink_home" DOTS_PATH="$ROOT" "$ROOT/bin/dots-theme-set" catppuccin >/dev/null 2>&1; then
  fail "theme set converted a legacy tree containing symlinks"
fi
[[ -L "$legacy_symlink_home/.local/state/dots/current/theme/linked" ]] || fail "legacy symlink tree was mutated before refusal"
assertions=$((assertions + 11))

# Generation and rollback state must be real entries owned by the dots state
# tree, never symlinks or occupied foreign paths.
foreign_state_home="$SANDBOX/foreign-theme-state-home"
HOME="$foreign_state_home" DOTS_PATH="$ROOT" "$ROOT/bin/dots-theme-set" tokyo-night >/dev/null 2>&1
foreign_target=$(readlink "$foreign_state_home/.local/state/dots/current")
printf 'extra\n' >>"$foreign_state_home/.local/state/dots/$foreign_target/.dots-theme-generation"
if HOME="$foreign_state_home" DOTS_PATH="$ROOT" "$ROOT/bin/dots-theme-set" catppuccin >/dev/null 2>&1; then
  fail "theme set accepted a generation marker with trailing data"
fi
printf 'dots-theme-generation-v1\n' >"$foreign_state_home/.local/state/dots/$foreign_target/.dots-theme-generation"
printf 'tokyo-night\nextra\n' >"$foreign_state_home/.local/state/dots/$foreign_target/theme.name"
if HOME="$foreign_state_home" DOTS_PATH="$ROOT" "$ROOT/bin/dots-theme-set" catppuccin >/dev/null 2>&1; then
  fail "theme set accepted a multiline generation theme name"
fi
printf 'tokyo-night\n' >"$foreign_state_home/.local/state/dots/$foreign_target/theme.name"
rm -rf "$foreign_state_home/.local/state/dots/$foreign_target"
mkdir -p "$SANDBOX/foreign-generation-target"
ln -s "$SANDBOX/foreign-generation-target" "$foreign_state_home/.local/state/dots/$foreign_target"
if HOME="$foreign_state_home" DOTS_PATH="$ROOT" "$ROOT/bin/dots-theme-set" catppuccin >/dev/null 2>&1; then
  fail "theme set accepted a symlinked generation root"
fi
rm "$foreign_state_home/.local/state/dots/current" "$foreign_state_home/.local/state/dots/$foreign_target"
foreign_real="$foreign_state_home/.local/state/dots/theme-generations/generation.FOREIGN"
mkdir -p "$foreign_real/theme"
printf 'foreign\n' >"$foreign_real/theme.name"
ln -s 'theme-generations/generation.FOREIGN' "$foreign_state_home/.local/state/dots/current"
if HOME="$foreign_state_home" DOTS_PATH="$ROOT" "$ROOT/bin/dots-theme-set" catppuccin >/dev/null 2>&1; then
  fail "theme set accepted an unmarked real generation"
fi
[[ -d $foreign_real ]] || fail "theme set deleted unmarked foreign generation"
rm "$foreign_state_home/.local/state/dots/current"
rm -rf "$foreign_real"
unreferenced_foreign="$foreign_state_home/.local/state/dots/theme-generations/generation.UNOWNED"
mkdir -p "$unreferenced_foreign/theme"
printf 'foreign\n' >"$unreferenced_foreign/theme.name"
if HOME="$foreign_state_home" DOTS_PATH="$ROOT" "$ROOT/bin/dots-theme-set" catppuccin >/dev/null 2>&1; then
  fail "theme set pruned an unreferenced unowned generation"
fi
[[ -d $unreferenced_foreign ]] || fail "theme set deleted unreferenced foreign generation"
rm -rf "$unreferenced_foreign"
mkdir -p "$foreign_state_home/.local/state/dots/theme-previous"
if HOME="$foreign_state_home" DOTS_PATH="$ROOT" "$ROOT/bin/dots-theme-set" catppuccin >/dev/null 2>&1; then
  fail "theme set accepted an occupied foreign previous path"
fi
[[ -d "$foreign_state_home/.local/state/dots/theme-previous" ]] || fail "theme set removed foreign previous path"
assertions=$((assertions + 9))

# Concurrent requests serialize and leave one complete, self-consistent theme.
"$ROOT/bin/dots" theme set catppuccin >/dev/null 2>&1 &
theme_pid_a=$!
"$ROOT/bin/dots" theme set tokyo-night >/dev/null 2>&1 &
theme_pid_b=$!
wait "$theme_pid_a"
wait "$theme_pid_b"
final_theme=$(cat "$HOME/.local/state/dots/current/theme.name")
[[ $final_theme == "catppuccin" || $final_theme == "tokyo-night" ]] || fail "concurrent theme state is inconsistent"
[[ -f "$HOME/.local/state/dots/current/theme/colors.toml" ]] || fail "concurrent theme lost active generation"
if find "$HOME/.local/state/dots/theme-generations" -maxdepth 1 -name '.staging.*' | grep -q .; then
  fail "concurrent theme left staging state"
fi
generation_count=$(find "$HOME/.local/state/dots/theme-generations" -mindepth 1 -maxdepth 1 -type d \( -name 'generation.*' -o -name 'recovery.*' \) | wc -l | tr -d ' ')
((generation_count <= 2)) || fail "theme retention kept more than active and previous generations"
assertions=$((assertions + 4))

# A restart repairs the narrow legacy-conversion interruption window from its
# durable recovery pointer before publishing the requested generation.
recovery_target=$(readlink "$HOME/.local/state/dots/current")
rm "$HOME/.local/state/dots/current"
ln -s "$recovery_target" "$HOME/.local/state/dots/.theme-current-recovery"
"$ROOT/bin/dots" theme set tokyo-night >/dev/null 2>&1
[[ -L "$HOME/.local/state/dots/current" ]] || fail "theme recovery did not restore current pointer"
[[ ! -e "$HOME/.local/state/dots/.theme-current-recovery" && ! -L "$HOME/.local/state/dots/.theme-current-recovery" ]] || fail "theme recovery marker not cleared"
[[ $(cat "$HOME/.local/state/dots/current/theme.name") == "tokyo-night" ]] || fail "theme recovery published inconsistent name"
assertions=$((assertions + 3))

# Theme flow: current + list marker
out=$("$ROOT/bin/dots" theme current)
assert_contains "$out" "tokyo-night" "theme current reports active theme"
out=$("$ROOT/bin/dots" theme list)
assert_contains "$out" "tokyo-night (current)" "theme list marks current"
assert_contains "$out" "catppuccin" "theme list shows other themes"

# Theme flow: unknown theme errors
if "$ROOT/bin/dots" theme set no-such-theme >/dev/null 2>&1; then
  fail "unknown theme should exit non-zero"
fi
assertions=$((assertions + 1))

# Migrations: pending detection and run-once markers
export DOTS_MIGRATION_STATE="$HOME/.local/state/dots/migrations"
mkdir -p "$SANDBOX/repo/migrations" "$SANDBOX/repo/bin" "$SANDBOX/repo/install/helpers"
cp "$ROOT/bin/dots-migrate" "$ROOT/bin/dots-path-resolve" "$ROOT/bin/dots-ensure-flock" \
  "$ROOT/bin/dots-update-restart" "$SANDBOX/repo/bin/"
cp "$ROOT/install/helpers/files.sh" "$ROOT/install/helpers/runtime.sh" \
  "$SANDBOX/repo/install/helpers/"
echo 'echo "migration ran" > "$HOME/migration-proof"' >"$SANDBOX/repo/migrations/1700000000.sh"
printf '%s\n' "$SANDBOX/repo" >"$HOME/.config/dots/path"

mkdir -p "$DOTS_MIGRATION_STATE"
printf 'external marker\n' >"$SANDBOX/external-migration-marker"
ln -s "$SANDBOX/external-migration-marker" "$DOTS_MIGRATION_STATE/1700000000.sh"
rc=0
DOTS_PATH="$SANDBOX/repo" "$ROOT/bin/dots-migrate" --pending >/dev/null 2>&1 || rc=$?
((rc == 2)) || fail "unsafe migration marker should make pending state indeterminate (got $rc)"
[[ $(cat "$SANDBOX/external-migration-marker") == "external marker" ]] || fail "migration check altered marker target"
rm "$DOTS_MIGRATION_STATE/1700000000.sh"
printf 'not-an-empty-marker\n' >"$DOTS_MIGRATION_STATE/1700000000.sh"
rc=0
DOTS_PATH="$SANDBOX/repo" "$ROOT/bin/dots-migrate" --pending >/dev/null 2>&1 || rc=$?
((rc == 2)) || fail "corrupt regular marker should make pending state indeterminate (got $rc)"
rm "$DOTS_MIGRATION_STATE/1700000000.sh"
out=$(DOTS_PATH="$SANDBOX/repo" "$ROOT/bin/dots-migrate" --pending)
assert_contains "$out" "1700000000.sh" "pending migration listed"
DOTS_PATH="$SANDBOX/repo" "$ROOT/bin/dots-migrate" >/dev/null
[[ -f "$HOME/migration-proof" ]] || fail "migration did not run"
[[ -f "$DOTS_MIGRATION_STATE/1700000000.sh" ]] || fail "migration marker not written"
if DOTS_PATH="$SANDBOX/repo" "$ROOT/bin/dots-migrate" --pending >/dev/null; then
  fail "migration still pending after run"
fi
assertions=$((assertions + 6))

# Pending checks never wait behind a running migration and report the state as
# indeterminate rather than claiming there are no migrations.
exec 7>>"$DOTS_MIGRATION_STATE/migrate.lock"
flock 7
pending_status="$SANDBOX/pending-migration-status"
(
  rc=0
  DOTS_PATH="$SANDBOX/repo" "$ROOT/bin/dots-migrate" --pending >/dev/null 2>&1 || rc=$?
  printf '%s\n' "$rc" >"$pending_status"
) &
pending_pid=$!
for ((i = 0; i < 20; i++)); do
  [[ -f $pending_status ]] && break
  sleep 0.01
done
if [[ ! -f $pending_status ]]; then
  kill "$pending_pid" 2>/dev/null || true
  wait "$pending_pid" 2>/dev/null || true
  fail "pending migration check blocked on the migration lock"
fi
wait "$pending_pid"
rc=$(<"$pending_status")
((rc == 2)) || fail "locked pending migration check should be indeterminate (got $rc)"
flock -u 7
exec 7>&-
assertions=$((assertions + 1))

# Standalone migration runs serialize their marker check and execution.
mkdir -p "$SANDBOX/concurrent-repo/migrations" "$SANDBOX/concurrent-repo/bin" \
  "$SANDBOX/concurrent-repo/install/helpers"
cp "$ROOT/bin/dots-migrate" "$ROOT/bin/dots-path-resolve" "$ROOT/bin/dots-ensure-flock" \
  "$ROOT/bin/dots-update-restart" "$SANDBOX/concurrent-repo/bin/"
cp "$ROOT/install/helpers/files.sh" "$ROOT/install/helpers/runtime.sh" \
  "$SANDBOX/concurrent-repo/install/helpers/"
cat >"$SANDBOX/concurrent-repo/migrations/1700000001.sh" <<'EOF'
printf 'run\n' >>"$HOME/concurrent-migration-proof"
sleep 0.2
EOF
concurrent_state="$HOME/.local/state/dots/concurrent-migrations"
printf '%s\n' "$SANDBOX/concurrent-repo" >"$HOME/.config/dots/path"
DOTS_PATH="$SANDBOX/concurrent-repo" DOTS_MIGRATION_STATE="$concurrent_state" \
  "$ROOT/bin/dots-migrate" >/dev/null &
migrate_pid_a=$!
DOTS_PATH="$SANDBOX/concurrent-repo" DOTS_MIGRATION_STATE="$concurrent_state" \
  "$ROOT/bin/dots-migrate" >/dev/null &
migrate_pid_b=$!
wait "$migrate_pid_a"
wait "$migrate_pid_b"
[[ $(wc -l <"$HOME/concurrent-migration-proof" | tr -d ' ') == "1" ]] || fail "concurrent migration executed more than once"
assertions=$((assertions + 1))

# A failed migration remains pending without preventing later migrations from
# committing their own successful markers.
printf 'exit 7\n' >"$SANDBOX/concurrent-repo/migrations/1700000002.sh"
printf 'touch "$HOME/later-migration-proof"\n' >"$SANDBOX/concurrent-repo/migrations/1700000003.sh"
rc=0
DOTS_PATH="$SANDBOX/concurrent-repo" DOTS_MIGRATION_STATE="$concurrent_state" \
  "$ROOT/bin/dots-migrate" >/dev/null 2>&1 || rc=$?
((rc == 7)) || fail "migration batch did not preserve its failure status (got $rc)"
[[ ! -e $concurrent_state/1700000002.sh ]] || fail "failed migration was marked complete"
[[ -f $HOME/later-migration-proof && -f $concurrent_state/1700000003.sh ]] ||
  fail "later migration did not complete after an earlier failure"
assertions=$((assertions + 3))

# Standalone migrate reports restart markers, while dots update retains that
# reporting step until the end of its pipeline.
restart_repo="$SANDBOX/restart-migrate-repo"
restart_state="$HOME/.local/state/dots/restart-migrations"
mkdir -p "$restart_repo/migrations" "$restart_repo/bin" "$restart_repo/install/helpers"
cp "$ROOT/bin/dots-migrate" "$ROOT/bin/dots-path-resolve" "$ROOT/bin/dots-ensure-flock" \
  "$restart_repo/bin/"
cp "$ROOT/install/helpers/files.sh" "$ROOT/install/helpers/runtime.sh" \
  "$restart_repo/install/helpers/"
printf 'touch "$HOME/restart-migration-one"\n' >"$restart_repo/migrations/1700000010.sh"
cat >"$restart_repo/bin/dots-update-restart" <<'EOF'
#!/usr/bin/env bash
printf 'reported\n' >>"$HOME/restart-reports"
EOF
chmod +x "$restart_repo/bin/dots-update-restart"
printf '%s\n' "$restart_repo" >"$HOME/.config/dots/path"
DOTS_PATH="$restart_repo" DOTS_MIGRATION_STATE="$restart_state" \
  "$ROOT/bin/dots-migrate" >/dev/null
[[ $(wc -l <"$HOME/restart-reports" | tr -d ' ') == "1" ]] ||
  fail "standalone migration did not report restart markers"
printf 'touch "$HOME/restart-migration-two"\n' >"$restart_repo/migrations/1700000011.sh"
DOTS_PATH="$restart_repo" DOTS_MIGRATION_STATE="$restart_state" DOTS_UPDATE_LOCK_PID=123 \
  "$ROOT/bin/dots-migrate" >/dev/null
[[ -f $HOME/restart-migration-two ]] || fail "update-owned migration did not run"
[[ $(wc -l <"$HOME/restart-reports" | tr -d ' ') == "1" ]] ||
  fail "update-owned migration reported restart markers mid-pipeline"
assertions=$((assertions + 3))

# Migration discovery handles tabs in a valid checkout path without record
# serialization or field splitting.
tab_repo="$SANDBOX/"$'tab\tmigration-repo'
mkdir -p "$tab_repo/migrations" "$tab_repo/bin" "$tab_repo/install/helpers"
cp "$ROOT/bin/dots-migrate" "$ROOT/bin/dots-path-resolve" "$ROOT/bin/dots-ensure-flock" \
  "$ROOT/bin/dots-update-restart" "$tab_repo/bin/"
cp "$ROOT/install/helpers/files.sh" "$ROOT/install/helpers/runtime.sh" \
  "$tab_repo/install/helpers/"
printf 'printf tab-ran >"$HOME/tab-migration-proof"\n' >"$tab_repo/migrations/1700000002.sh"
tab_state="$HOME/.local/state/dots/tab-migrations"
printf '%s\n' "$tab_repo" >"$HOME/.config/dots/path"
out=$(DOTS_PATH="$tab_repo" DOTS_MIGRATION_STATE="$tab_state" "$ROOT/bin/dots-migrate" --pending)
assert_contains "$out" "1700000002.sh" "tab-path migration listed"
DOTS_PATH="$tab_repo" DOTS_MIGRATION_STATE="$tab_state" "$ROOT/bin/dots-migrate" >/dev/null
[[ $(cat "$HOME/tab-migration-proof") == "tab-ran" ]] || fail "tab-path migration did not execute"
printf '%s\n' "$ROOT" >"$HOME/.config/dots/path"
assertions=$((assertions + 1))

# done markers
mkdir -p "$HOME/.local/state/dots/done"
ln -s "$SANDBOX/dangling-done-target" "$HOME/.local/state/dots/done/unsafe-marker"
if "$ROOT/bin/dots-done" mark unsafe-marker >/dev/null 2>&1; then
  fail "done mark accepted a dangling marker symlink"
fi
[[ ! -e "$SANDBOX/dangling-done-target" ]] || fail "done mark created symlink target"
rm "$HOME/.local/state/dots/done/unsafe-marker"
"$ROOT/bin/dots-done" mark test-marker
"$ROOT/bin/dots-done" check test-marker || fail "done marker not recorded"
if "$ROOT/bin/dots-done" ensure test-marker 2>/dev/null; then
  fail "removed ensure action should be rejected"
fi
assertions=$((assertions + 4))

echo "ok: $assertions assertions passed (cli)"
