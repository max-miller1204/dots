printf 'foreign legacy source\n' >"$SANDBOX/foreign-legacy-source"
ln -s "$SANDBOX/foreign-legacy-source" "$legacy_symlink_home/.local/state/dots/current/theme/linked"
if HOME="$legacy_symlink_home" DOTS_PATH="$ROOT" "$ROOT/bin/dots-theme-set" catppuccin >/dev/null 2>&1; then
  fail "theme set converted a legacy tree containing symlinks"
fi
[[ -L "$legacy_symlink_home/.local/state/dots/current/theme/linked" ]] || fail "legacy symlink tree was mutated before refusal"
assertions=$((assertions + 11))

# Generation and rollback state must be real entries owned by the dots state
# tree, never symlinks or occupied foreign paths.
foreign_state_home="$SANDBOX/foreign-theme-state-home"
HOME="$foreign_state_home" DOTS_PATH="$ROOT" "$ROOT/bin/dots-theme-set" tokyo-night >/dev/null 2>&1
foreign_target=$(readlink "$foreign_state_home/.local/state/dots/current")
printf 'extra\n' >>"$foreign_state_home/.local/state/dots/$foreign_target/.dots-theme-generation"
if HOME="$foreign_state_home" DOTS_PATH="$ROOT" "$ROOT/bin/dots-theme-set" catppuccin >/dev/null 2>&1; then
  fail "theme set accepted a generation marker with trailing data"
fi
printf 'dots-theme-generation-v1\n' >"$foreign_state_home/.local/state/dots/$foreign_target/.dots-theme-generation"
printf 'tokyo-night\nextra\n' >"$foreign_state_home/.local/state/dots/$foreign_target/theme.name"
if HOME="$foreign_state_home" DOTS_PATH="$ROOT" "$ROOT/bin/dots-theme-set" catppuccin >/dev/null 2>&1; then
  fail "theme set accepted a multiline generation theme name"
fi
printf 'tokyo-night\n' >"$foreign_state_home/.local/state/dots/$foreign_target/theme.name"
rm -rf "$foreign_state_home/.local/state/dots/$foreign_target"
mkdir -p "$SANDBOX/foreign-generation-target"
ln -s "$SANDBOX/foreign-generation-target" "$foreign_state_home/.local/state/dots/$foreign_target"
if HOME="$foreign_state_home" DOTS_PATH="$ROOT" "$ROOT/bin/dots-theme-set" catppuccin >/dev/null 2>&1; then
  fail "theme set accepted a symlinked generation root"
fi
rm "$foreign_state_home/.local/state/dots/current" "$foreign_state_home/.local/state/dots/$foreign_target"
foreign_real="$foreign_state_home/.local/state/dots/theme-generations/generation.FOREIGN"
mkdir -p "$foreign_real/theme"
printf 'foreign\n' >"$foreign_real/theme.name"
ln -s 'theme-generations/generation.FOREIGN' "$foreign_state_home/.local/state/dots/current"
if HOME="$foreign_state_home" DOTS_PATH="$ROOT" "$ROOT/bin/dots-theme-set" catppuccin >/dev/null 2>&1; then
  fail "theme set accepted an unmarked real generation"
fi
[[ -d $foreign_real ]] || fail "theme set deleted unmarked foreign generation"
rm "$foreign_state_home/.local/state/dots/current"
rm -rf "$foreign_real"
unreferenced_foreign="$foreign_state_home/.local/state/dots/theme-generations/generation.UNOWNED"
mkdir -p "$unreferenced_foreign/theme"
printf 'foreign\n' >"$unreferenced_foreign/theme.name"
if HOME="$foreign_state_home" DOTS_PATH="$ROOT" "$ROOT/bin/dots-theme-set" catppuccin >/dev/null 2>&1; then
  fail "theme set pruned an unreferenced unowned generation"
fi
[[ -d $unreferenced_foreign ]] || fail "theme set deleted unreferenced foreign generation"
rm -rf "$unreferenced_foreign"
mkdir -p "$foreign_state_home/.local/state/dots/theme-previous"
if HOME="$foreign_state_home" DOTS_PATH="$ROOT" "$ROOT/bin/dots-theme-set" catppuccin >/dev/null 2>&1; then
  fail "theme set accepted an occupied foreign previous path"
fi
[[ -d "$foreign_state_home/.local/state/dots/theme-previous" ]] || fail "theme set removed foreign previous path"
assertions=$((assertions + 9))

# Concurrent requests serialize and leave one complete, self-consistent theme.
"$ROOT/bin/dots" theme set catppuccin >/dev/null 2>&1 &
theme_pid_a=$!
"$ROOT/bin/dots" theme set tokyo-night >/dev/null 2>&1 &
theme_pid_b=$!
wait "$theme_pid_a"
wait "$theme_pid_b"
final_theme=$(cat "$HOME/.local/state/dots/current/theme.name")
[[ $final_theme == "catppuccin" || $final_theme == "tokyo-night" ]] || fail "concurrent theme state is inconsistent"
[[ -f "$HOME/.local/state/dots/current/theme/colors.toml" ]] || fail "concurrent theme lost active generation"
if find "$HOME/.local/state/dots/theme-generations" -maxdepth 1 -name '.staging.*' | grep -q .; then
  fail "concurrent theme left staging state"
fi
generation_count=$(find "$HOME/.local/state/dots/theme-generations" -mindepth 1 -maxdepth 1 -type d \( -name 'generation.*' -o -name 'recovery.*' \) | wc -l | tr -d ' ')
((generation_count <= 2)) || fail "theme retention kept more than active and previous generations"
assertions=$((assertions + 4))

# A restart repairs the narrow legacy-conversion interruption window from its
# durable recovery pointer before publishing the requested generation.
recovery_target=$(readlink "$HOME/.local/state/dots/current")
rm "$HOME/.local/state/dots/current"
ln -s "$recovery_target" "$HOME/.local/state/dots/.theme-current-recovery"
"$ROOT/bin/dots" theme set tokyo-night >/dev/null 2>&1
[[ -L "$HOME/.local/state/dots/current" ]] || fail "theme recovery did not restore current pointer"
[[ ! -e "$HOME/.local/state/dots/.theme-current-recovery" && ! -L "$HOME/.local/state/dots/.theme-current-recovery" ]] || fail "theme recovery marker not cleared"
[[ $(cat "$HOME/.local/state/dots/current/theme.name") == "tokyo-night" ]] || fail "theme recovery published inconsistent name"
assertions=$((assertions + 3))

# Theme flow: current + list marker
out=$("$ROOT/bin/dots" theme current)
assert_contains "$out" "tokyo-night" "theme current reports active theme"
out=$("$ROOT/bin/dots" theme list)
assert_contains "$out" "tokyo-night (current)" "theme list marks current"
assert_contains "$out" "catppuccin" "theme list shows other themes"

# Theme flow: unknown theme errors
if "$ROOT/bin/dots" theme set no-such-theme >/dev/null 2>&1; then
  fail "unknown theme should exit non-zero"
fi
assertions=$((assertions + 1))

# Migrations: pending detection and run-once markers
export DOTS_MIGRATION_STATE="$HOME/.local/state/dots/migrations"
mkdir -p "$SANDBOX/repo/migrations" "$SANDBOX/repo/bin" "$SANDBOX/repo/install/helpers"
cp "$ROOT/bin/dots-migrate" "$ROOT/bin/dots-path-resolve" "$ROOT/bin/dots-ensure-flock" \
  "$ROOT/bin/dots-update-restart" "$SANDBOX/repo/bin/"
cp "$ROOT/install/helpers/files.sh" "$SANDBOX/repo/install/helpers/files.sh"
echo 'echo "migration ran" > "$HOME/migration-proof"' >"$SANDBOX/repo/migrations/1700000000.sh"
printf '%s\n' "$SANDBOX/repo" >"$HOME/.config/dots/path"

mkdir -p "$DOTS_MIGRATION_STATE"
printf 'external marker\n' >"$SANDBOX/external-migration-marker"
ln -s "$SANDBOX/external-migration-marker" "$DOTS_MIGRATION_STATE/1700000000.sh"
if DOTS_PATH="$SANDBOX/repo" "$ROOT/bin/dots-migrate" --pending >/dev/null 2>&1; then
  fail "migration check accepted a marker symlink"
fi
[[ $(cat "$SANDBOX/external-migration-marker") == "external marker" ]] || fail "migration check altered marker target"
rm "$DOTS_MIGRATION_STATE/1700000000.sh"
out=$(DOTS_PATH="$SANDBOX/repo" "$ROOT/bin/dots-migrate" --pending)
assert_contains "$out" "1700000000.sh" "pending migration listed"
DOTS_PATH="$SANDBOX/repo" "$ROOT/bin/dots-migrate" >/dev/null
[[ -f "$HOME/migration-proof" ]] || fail "migration did not run"
[[ -f "$DOTS_MIGRATION_STATE/1700000000.sh" ]] || fail "migration marker not written"
if DOTS_PATH="$SANDBOX/repo" "$ROOT/bin/dots-migrate" --pending >/dev/null; then
  fail "migration still pending after run"
fi
assertions=$((assertions + 5))

# Standalone migration runs serialize their marker check and execution.
mkdir -p "$SANDBOX/concurrent-repo/migrations" "$SANDBOX/concurrent-repo/bin" \
  "$SANDBOX/concurrent-repo/install/helpers"
cp "$ROOT/bin/dots-migrate" "$ROOT/bin/dots-path-resolve" "$ROOT/bin/dots-ensure-flock" \
  "$ROOT/bin/dots-update-restart" "$SANDBOX/concurrent-repo/bin/"
cp "$ROOT/install/helpers/files.sh" "$SANDBOX/concurrent-repo/install/helpers/files.sh"
cat >"$SANDBOX/concurrent-repo/migrations/1700000001.sh" <<'EOF'
printf 'run\n' >>"$HOME/concurrent-migration-proof"
sleep 0.2
EOF
concurrent_state="$HOME/.local/state/dots/concurrent-migrations"
printf '%s\n' "$SANDBOX/concurrent-repo" >"$HOME/.config/dots/path"
DOTS_PATH="$SANDBOX/concurrent-repo" DOTS_MIGRATION_STATE="$concurrent_state" \
  "$ROOT/bin/dots-migrate" >/dev/null &
migrate_pid_a=$!
DOTS_PATH="$SANDBOX/concurrent-repo" DOTS_MIGRATION_STATE="$concurrent_state" \
  "$ROOT/bin/dots-migrate" >/dev/null &
migrate_pid_b=$!
wait "$migrate_pid_a"
wait "$migrate_pid_b"
[[ $(wc -l <"$HOME/concurrent-migration-proof" | tr -d ' ') == "1" ]] || fail "concurrent migration executed more than once"
assertions=$((assertions + 1))

# Migration discovery handles tabs in a valid checkout path without record
# serialization or field splitting.
tab_repo="$SANDBOX/"$'tab\tmigration-repo'
mkdir -p "$tab_repo/migrations" "$tab_repo/bin" "$tab_repo/install/helpers"
cp "$ROOT/bin/dots-migrate" "$ROOT/bin/dots-path-resolve" "$ROOT/bin/dots-ensure-flock" \
  "$ROOT/bin/dots-update-restart" "$tab_repo/bin/"
cp "$ROOT/install/helpers/files.sh" "$tab_repo/install/helpers/files.sh"
printf 'printf tab-ran >"$HOME/tab-migration-proof"\n' >"$tab_repo/migrations/1700000002.sh"
tab_state="$HOME/.local/state/dots/tab-migrations"
printf '%s\n' "$tab_repo" >"$HOME/.config/dots/path"
out=$(DOTS_PATH="$tab_repo" DOTS_MIGRATION_STATE="$tab_state" "$ROOT/bin/dots-migrate" --pending)
assert_contains "$out" "1700000002.sh" "tab-path migration listed"
DOTS_PATH="$tab_repo" DOTS_MIGRATION_STATE="$tab_state" "$ROOT/bin/dots-migrate" >/dev/null
[[ $(cat "$HOME/tab-migration-proof") == "tab-ran" ]] || fail "tab-path migration did not execute"
printf '%s\n' "$ROOT" >"$HOME/.config/dots/path"
assertions=$((assertions + 1))

# done markers
mkdir -p "$HOME/.local/state/dots/done"
ln -s "$SANDBOX/dangling-done-target" "$HOME/.local/state/dots/done/unsafe-marker"
if "$ROOT/bin/dots-done" mark unsafe-marker >/dev/null 2>&1; then
  fail "done mark accepted a dangling marker symlink"
fi
[[ ! -e "$SANDBOX/dangling-done-target" ]] || fail "done mark created symlink target"
rm "$HOME/.local/state/dots/done/unsafe-marker"
"$ROOT/bin/dots-done" mark test-marker
"$ROOT/bin/dots-done" check test-marker || fail "done marker not recorded"
if "$ROOT/bin/dots-done" ensure test-marker 2>/dev/null; then
  fail "ensure should fail on an existing marker"
fi
assertions=$((assertions + 4))

echo "ok: $assertions assertions passed (cli)"
