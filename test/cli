#!/usr/bin/env bash

# CLI test suite: router listing/routing, config refresh, theme rendering,
# migrations. Runs against a sandbox $HOME so the real one is never touched.

set -eo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
source "$ROOT/test/helpers.sh"

# Syntax-check every script
for f in "$ROOT"/bin/*; do
  bash -n "$f" || fail "syntax error in $f"
done
while IFS= read -r f; do
  bash -n "$f" || fail "syntax error in $f"
done < <(find "$ROOT/install" "$ROOT/test" -type f \( -name '*.sh' -o -name 'cli' -o -name 'update' -o -name 'all' \))
assertions=$((assertions + 1))

setup_sandbox

# Router: group listing
out=$("$ROOT/bin/dots")
assert_contains "$out" "theme" "root listing shows theme group"
assert_contains "$out" "update" "root listing shows update group"

# Router: group command listing
out=$("$ROOT/bin/dots" theme)
assert_contains "$out" "theme-set" "group listing shows theme-set"

# Router: `dots help <group>` lists a group whose name is itself a binary,
# without running it
out=$("$ROOT/bin/dots" help update)
assert_contains "$out" "update-available" "help <group> lists subcommands"

# Router: hidden commands stay hidden
out=$("$ROOT/bin/dots")
case "$out" in
  *done*) fail "hidden 'done' group leaked into root listing" ;;
esac
assertions=$((assertions + 1))

# Router: greedy routing to two-segment command
out=$("$ROOT/bin/dots" version)
assert_contains "$out" "dots " "dots version routes"

# Router: unknown command errors
if "$ROOT/bin/dots" no-such-thing >/dev/null 2>&1; then
  fail "unknown command should exit non-zero"
fi
assertions=$((assertions + 1))

# Router: `<command> --help` describes the command instead of running it.
# Greedy routing used to hand the flag straight to the command, so
# `dots install --help` performed a full install.
out=$("$ROOT/bin/dots" install --help)
assert_contains "$out" "Usage: dots install" "install --help prints usage"
[[ -e "$HOME/.config/mise/config.toml" ]] && fail "install --help ran the install"
assertions=$((assertions + 1))

# Router: command help renders args and examples from the metadata
out=$("$ROOT/bin/dots" theme set --help)
assert_contains "$out" "Usage: dots theme set <theme-name>" "command help shows args"
assert_contains "$out" "dots theme set tokyo-night" "command help shows examples"
[[ -e "$HOME/.local/state/dots/current/theme.name" ]] && fail "theme set --help applied a theme"
assertions=$((assertions + 1))

# Router: -h is equivalent to --help
out=$("$ROOT/bin/dots" version -h)
assert_contains "$out" "Usage: dots version" "-h prints usage"

# Router: the flag is only intercepted when it is the sole remaining argument,
# so commands that take their own flags still receive them
if "$ROOT/bin/dots" theme set no-such-theme --help >/dev/null 2>&1; then
  fail "--help after an argument should reach the command"
fi
assertions=$((assertions + 1))

# Router: a group with no binary of its own still lists its commands
out=$("$ROOT/bin/dots" pkg --help)
assert_contains "$out" "pkg-add" "group --help lists subcommands"

# Router: examples are split on the literal ';;' separator only. A single
# semicolon inside one example must not split it -- IFS=';;' would, because
# IFS holds a set of single characters rather than a delimiter string.
tmpbin=$SANDBOX/probe-repo/bin
mkdir -p "$tmpbin"
cat >"$tmpbin/dots-semicolon-probe" <<'PROBE'
#!/usr/bin/env bash
# dots:summary=Probe for separator handling
# dots:args=<arg>
# dots:examples=dots semicolon probe one; echo done;;dots semicolon probe two
exit 0
PROBE
chmod +x "$tmpbin/dots-semicolon-probe"
cp "$ROOT/bin/dots" "$ROOT/bin/dots-path-resolve" "$tmpbin/"
out=$(DOTS_PATH="${tmpbin%/bin}" "$tmpbin/dots" semicolon probe --help)
assert_contains "$out" "dots semicolon probe one; echo done" "single ';' stays inside one example"
assert_contains "$out" "dots semicolon probe two" "';;' still separates examples"
if [[ $(grep -c '^  dots semicolon probe' <<<"$out") -ne 2 ]]; then
  fail "expected exactly 2 examples, got: $out"
fi
assertions=$((assertions + 1))

# Non-interactive Bash gets bootstrap environment only, not interactive UX.
mkdir -p "$HOME/.config/dots"
printf '%s\n' "$ROOT" >"$HOME/.config/dots/path"
DOTS_PATH="$ROOT" bash -c 'source "$1"; ! type n >/dev/null 2>&1' \
  bash "$ROOT/default/bashrc" || fail "non-interactive bashrc loaded interactive functions"
PATH="/usr/bin:/bin" DOTS_PATH="$ROOT" bash -c 'source "$1"; [[ $PATH == "$DOTS_PATH/bin:"* ]]' \
  bash "$ROOT/default/bashrc" || fail "non-interactive bashrc missed env bootstrap"
assertions=$((assertions + 2))

mkdir -p "$SANDBOX/eza-stub"
printf '#!/usr/bin/env bash\nexit 0\n' >"$SANDBOX/eza-stub/eza"
chmod +x "$SANDBOX/eza-stub/eza"
alias_out=$(PATH="$SANDBOX/eza-stub:/usr/bin:/bin" bash -c \
  'source "$1"; alias ls; alias ll; alias lt' bash "$ROOT/default/bash/aliases")
case "$alias_out" in
  *--icons*) fail "eza aliases enabled unprovisioned icons" ;;
esac
assert_contains "$alias_out" "--group-directories-first" "eza aliases preserve directory grouping"
assert_contains "$alias_out" "--tree --level=2 --long --git" "eza tree alias preserves portable options"
assertions=$((assertions + 1))

# Direct commands that have not sourced shell startup still honor the serialized
# canonical checkout path.
serialized_repo="$SANDBOX/serialized checkout"
mkdir -p "$serialized_repo/themes/serialized-probe" "$serialized_repo/default" "$serialized_repo/bin"
cp -R "$ROOT/default/bash" "$serialized_repo/default/bash"
cp "$ROOT/bin/dots-theme-list" "$ROOT/bin/dots-path-resolve" "$serialized_repo/bin/"
printf 'accent = "#000000"\n' >"$serialized_repo/themes/serialized-probe/colors.toml"
printf '%s\n' "$serialized_repo" >"$HOME/.config/dots/path"
out=$(env -u DOTS_PATH "$ROOT/bin/dots-theme-list")
assert_contains "$out" "serialized-probe" "direct command resolved serialized checkout"
env -u DOTS_PATH PATH=/usr/bin:/bin bash -c 'source "$1"; [[ $DOTS_PATH == "$2" ]]' \
  bash "$ROOT/default/bashrc" "$serialized_repo" || fail "Bash rc ignored serialized checkout"
env -u DOTS_PATH PATH=/usr/bin:/bin zsh -c 'source "$1"; [[ $DOTS_PATH == "$2" ]]' \
  zsh "$ROOT/default/zshrc" "$serialized_repo" || fail "Zsh rc ignored serialized checkout"
stale_repo="$SANDBOX/stale checkout"
env DOTS_PATH="$stale_repo" PATH=/usr/bin:/bin bash -c 'source "$1"; [[ $DOTS_PATH == "$2" ]]' \
  bash "$ROOT/default/bashrc" "$serialized_repo" || fail "Bash rc preferred inherited checkout over canonical path"
env DOTS_PATH="$stale_repo" PATH=/usr/bin:/bin zsh -c 'source "$1"; [[ $DOTS_PATH == "$2" ]]' \
  zsh "$ROOT/default/zshrc" "$serialized_repo" || fail "Zsh rc preferred inherited checkout over canonical path"
[[ $(DOTS_PATH="$stale_repo" "$ROOT/bin/dots-path-resolve") == "$serialized_repo" ]] ||
  fail "path resolver preferred inherited checkout over canonical path"
assertions=$((assertions + 3))
printf 'bad:path\n' >"$HOME/.config/dots/path"
if env -u DOTS_PATH "$ROOT/bin/dots-theme-list" >/dev/null 2>&1; then
  fail "direct command accepted malformed checkout path data"
fi
printf '%s\n\n' "$serialized_repo" >"$HOME/.config/dots/path"
env -u DOTS_PATH PATH=/usr/bin:/bin bash -c 'source "$1"; [[ $DOTS_PATH == "$HOME/dotfiles" ]]' \
  bash "$ROOT/default/bash/env-bootstrap" || fail "Bash bootstrap accepted a multiline checkout path"
env -u DOTS_PATH PATH=/usr/bin:/bin zsh -c 'source "$1"; [[ $DOTS_PATH == "$HOME/dotfiles" ]]' \
  zsh "$ROOT/default/bash/env-bootstrap" || fail "Zsh bootstrap accepted a multiline checkout path"
# A command reached through an older checkout delegates execution to the
# serialized checkout instead of mixing stale code with canonical data.
canonical_probe="$SANDBOX/canonical-probe"
obsolete_probe="$SANDBOX/obsolete-probe"
mkdir -p "$canonical_probe/bin" "$obsolete_probe/bin"
printf '#!/usr/bin/env bash\necho canonical-code\n' >"$canonical_probe/bin/dots-version"
printf '#!/usr/bin/env bash\necho canonical-router\n' >"$canonical_probe/bin/dots"
chmod +x "$canonical_probe/bin/dots-version" "$canonical_probe/bin/dots"
cp "$ROOT/bin/dots-version" "$ROOT/bin/dots-path-resolve" "$ROOT/bin/dots" "$obsolete_probe/bin/"
printf '%s\n' "$canonical_probe" >"$HOME/.config/dots/path"
[[ $(DOTS_PATH="$obsolete_probe" "$obsolete_probe/bin/dots-version") == "canonical-code" ]] || fail "direct stale command did not delegate to canonical checkout"
[[ $(DOTS_PATH="$obsolete_probe" "$obsolete_probe/bin/dots" version) == "canonical-router" ]] || fail "stale router did not delegate to canonical checkout"
for delegated_command in dots-hook dots-pkg-add dots-pkg-drop dots-theme-current dots-done \
  dots-update-analyze-logs dots-update-requires-free-space dots-update-restart; do
  printf '#!/usr/bin/env bash\necho %s\n' "$delegated_command" >"$canonical_probe/bin/$delegated_command"
  chmod +x "$canonical_probe/bin/$delegated_command"
  cp "$ROOT/bin/$delegated_command" "$obsolete_probe/bin/$delegated_command"
  [[ $(DOTS_PATH="$obsolete_probe" "$obsolete_probe/bin/$delegated_command") == "$delegated_command" ]] ||
    fail "stale $delegated_command did not delegate to canonical checkout"
done

rm "$HOME/.config/dots/path"
printf '%s\n' "$ROOT" >"$SANDBOX/external-path-data"
ln -s "$SANDBOX/external-path-data" "$HOME/.config/dots/path"
if env -u DOTS_PATH "$ROOT/bin/dots-path-resolve" >/dev/null 2>&1; then
  fail "path resolver accepted a symlinked path file"
fi
if env -u DOTS_PATH PATH=/usr/bin:/bin bash -c 'source "$1"' \
  bash "$ROOT/default/bash/env-bootstrap" >/dev/null 2>&1; then
  fail "shell bootstrap accepted a symlinked path file"
fi
rm "$HOME/.config/dots/path"
ln -s "$SANDBOX/missing-path-data" "$HOME/.config/dots/path"
if env -u DOTS_PATH "$ROOT/bin/dots-path-resolve" >/dev/null 2>&1; then
  fail "path resolver accepted a dangling path-file symlink"
fi
rm "$HOME/.config/dots/path"
mkfifo "$HOME/.config/dots/path"
if env -u DOTS_PATH "$ROOT/bin/dots-path-resolve" >/dev/null 2>&1; then
  fail "path resolver accepted a FIFO path file"
fi
for startup_shell in bash zsh; do
  env -u DOTS_PATH PATH=/usr/bin:/bin "$startup_shell" -c 'source "$1"' \
    "$startup_shell" "$ROOT/default/bash/env-bootstrap" >/dev/null 2>&1 &
  startup_pid=$!
  startup_finished=""
  for ((attempt = 0; attempt < 40; attempt++)); do
    if ! kill -0 "$startup_pid" 2>/dev/null; then
      startup_finished=1
      break
    fi
    sleep 0.05
  done
  if [[ -z $startup_finished ]]; then
    kill -KILL "$startup_pid" 2>/dev/null || true
    wait "$startup_pid" 2>/dev/null || true
    fail "$startup_shell startup blocked on FIFO checkout path"
  fi
  startup_rc=0
  wait "$startup_pid" || startup_rc=$?
  ((startup_rc != 0)) || fail "$startup_shell startup accepted FIFO checkout path"
done
rm "$HOME/.config/dots/path"
printf '%s\n' "$ROOT" >"$HOME/.config/dots/path"
assertions=$((assertions + 21))

# Hooks continue after one failure but report aggregate failure to callers.
mkdir -p "$HOME/.config/dots/hooks/audit.d"
printf 'exit 7\n' >"$HOME/.config/dots/hooks/audit.d/10-fail"
printf 'touch "$HOME/hook-after-failure"\n' >"$HOME/.config/dots/hooks/audit.d/20-continue"
if "$ROOT/bin/dots-hook" audit >/dev/null 2>&1; then
  fail "dots-hook hid a hook failure"
fi
[[ -f "$HOME/hook-after-failure" ]] || fail "dots-hook stopped before later hooks"
assertions=$((assertions + 2))

# refresh-config: seeds a file, then backs up a modified copy
"$ROOT/bin/dots" refresh config git/config
[[ -f "$HOME/.config/git/config" ]] || fail "refresh config did not seed git/config"
echo "# local edit" >>"$HOME/.config/git/config"
"$ROOT/bin/dots" refresh config git/config >/dev/null
[[ -f "$HOME/.config/git/config" ]] || fail "refresh config lost git/config"
ls "$HOME/.config/git/config.bak."* >/dev/null 2>&1 || fail "refresh config kept no backup"
cmp -s "$HOME/.config/git/config" "$ROOT/config/git/config" || fail "refresh config did not restore default"
assertions=$((assertions + 1))

# Config replacement never follows valid or dangling destination symlinks.
mkdir -p "$HOME/symlink-targets" "$HOME/.config/gh"
printf 'keep target\n' >"$HOME/symlink-targets/gh"
ln -s "$HOME/symlink-targets/gh" "$HOME/.config/gh/config.yml"
"$ROOT/bin/dots-refresh-config" gh/config.yml >/dev/null
[[ $(cat "$HOME/symlink-targets/gh") == "keep target" ]] || fail "refresh overwrote symlink target"
[[ -f "$HOME/.config/gh/config.yml" && ! -L "$HOME/.config/gh/config.yml" ]] || fail "refresh did not replace symlink safely"
find "$HOME/.config/gh" -path '*/config.yml.bak.*/original' -type l | grep -q . || fail "refresh did not preserve symlink backup"
mkdir -p "$HOME/.config/git"
ln -s "$HOME/symlink-targets/missing" "$HOME/.config/git/ignore"
"$ROOT/bin/dots-refresh-config" git/ignore >/dev/null
[[ ! -e "$HOME/symlink-targets/missing" ]] || fail "refresh created dangling symlink target"
[[ -f "$HOME/.config/git/ignore" && ! -L "$HOME/.config/git/ignore" ]] || fail "refresh did not replace dangling symlink"

mkdir -p "$HOME/symlink-targets/herdr-parent"
ln -s "$HOME/symlink-targets/herdr-parent" "$HOME/.config/herdr"
if "$ROOT/bin/dots-refresh-config" herdr/config.toml >/dev/null 2>&1; then
  fail "refresh accepted a symlinked parent directory"
fi
[[ ! -e "$HOME/symlink-targets/herdr-parent/config.toml" ]] || fail "refresh wrote through a parent symlink"
rm "$HOME/.config/herdr"

mkdir -p "$HOME/.config/opencode/tui.jsonc"
if "$ROOT/bin/dots-refresh-config" opencode/tui.jsonc >/dev/null 2>&1; then
  fail "refresh replaced a real directory"
fi
rmdir "$HOME/.config/opencode/tui.jsonc"
assertions=$((assertions + 8))

# Import and hook installation enforce their repository/HOME ownership roots.
fake_repo="$SANDBOX/import-repo"
mkdir -p "$fake_repo/install/helpers" "$fake_repo/config" "$fake_repo/bin" "$SANDBOX/import-outside"
cp "$ROOT/install/helpers/files.sh" "$fake_repo/install/helpers/files.sh"
cp "$ROOT/bin/dots-config-import" "$ROOT/bin/dots-path-resolve" "$fake_repo/bin/"
ln -s "$SANDBOX/import-outside" "$fake_repo/config/nvim"
mkdir -p "$HOME/.config/nvim"
printf 'return {}\n' >"$HOME/.config/nvim/test.lua"
printf '%s\n' "$fake_repo" >"$HOME/.config/dots/path"
if "$ROOT/bin/dots-config-import" nvim/test.lua >/dev/null 2>&1; then
  fail "config import accepted a symlinked repository parent"
fi
[[ ! -e "$SANDBOX/import-outside/test.lua" ]] || fail "config import wrote outside the repository"
printf '%s\n' "$ROOT" >"$HOME/.config/dots/path"

hook_source="$SANDBOX/safe-hook"
printf '#!/usr/bin/env bash\n' >"$hook_source"
mkdir -p "$HOME/.config/dots" "$SANDBOX/hook-outside"
mv "$HOME/.config/dots/hooks" "$HOME/.config/dots/hooks.saved"
ln -s "$SANDBOX/hook-outside" "$HOME/.config/dots/hooks"
if "$ROOT/bin/dots-hook-install" post-update "$hook_source" >/dev/null 2>&1; then
  fail "hook install accepted a symlinked hooks parent"
fi
[[ ! -e "$SANDBOX/hook-outside/post-update.d/safe-hook" ]] || fail "hook install wrote through parent symlink"
if "$ROOT/bin/dots-hook-install" ../escape "$hook_source" >/dev/null 2>&1; then
  fail "hook install accepted an unsafe event"
fi
rm "$HOME/.config/dots/hooks"
mv "$HOME/.config/dots/hooks.saved" "$HOME/.config/dots/hooks"
assertions=$((assertions + 5))

# Reinstall --force also replaces links without touching their targets.
printf 'keep reinstall target\n' >"$HOME/symlink-targets/starship"
ln -s "$HOME/symlink-targets/starship" "$HOME/.config/starship.toml"
"$ROOT/bin/dots-reinstall-configs" --force >/dev/null
[[ $(cat "$HOME/symlink-targets/starship") == "keep reinstall target" ]] || fail "reinstall overwrote symlink target"
[[ -f "$HOME/.config/starship.toml" && ! -L "$HOME/.config/starship.toml" ]] || fail "reinstall did not replace symlink safely"
assertions=$((assertions + 2))

# A SIGKILL before discard publication leaves the old destination intact.
printf 'old atomic value\n' >"$SANDBOX/atomic-dest"
printf 'new atomic value\n' >"$SANDBOX/atomic-src"
cat >"$SANDBOX/crash-replace" <<'EOF'
#!/usr/bin/env bash
source "$DOTS_FILES_HELPER"
dots_file_replace "$ATOMIC_SRC" "$ATOMIC_DEST" "$ATOMIC_POLICY"
EOF
chmod +x "$SANDBOX/crash-replace"
rc=0
HOME="$HOME" DOTS_FILE_TEST_CRASH_BEFORE_PUBLISH=1 \
  DOTS_FILES_HELPER="$ROOT/install/helpers/files.sh" \
  ATOMIC_SRC="$SANDBOX/atomic-src" ATOMIC_DEST="$SANDBOX/atomic-dest" ATOMIC_POLICY=discard \
  bash -c '"$1" & child=$!; wait "$child"' bash "$SANDBOX/crash-replace" \
    >/dev/null 2>&1 || rc=$?
((rc != 0)) || fail "discard replacement failpoint did not terminate"
[[ $(cat "$SANDBOX/atomic-dest") == "old atomic value" ]] || fail "discard crash removed the old destination"
printf 'old backup value\n' >"$SANDBOX/atomic-backup-dest"
rc=0
HOME="$HOME" DOTS_FILE_TEST_CRASH_BEFORE_PUBLISH=1 \
  DOTS_FILES_HELPER="$ROOT/install/helpers/files.sh" \
  ATOMIC_SRC="$SANDBOX/atomic-src" ATOMIC_DEST="$SANDBOX/atomic-backup-dest" ATOMIC_POLICY=backup \
  bash -c '"$1" & child=$!; wait "$child"' bash "$SANDBOX/crash-replace" \
    >/dev/null 2>&1 || rc=$?
((rc != 0)) || fail "backup replacement failpoint did not terminate"
[[ $(cat "$SANDBOX/atomic-backup-dest") == "old backup value" ]] || fail "backup crash removed the live destination"
backup_copy=$(find "$SANDBOX" -path '*/atomic-backup-dest.bak.*/original' -type f -print -quit)
[[ -n $backup_copy && $(cat "$backup_copy") == "old backup value" ]] || fail "backup crash did not preserve backup copy"
assertions=$((assertions + 5))

cat >"$SANDBOX/sync-owned-payload" <<'EOF'
#!/usr/bin/env bash
source "$DOTS_FILES_HELPER"
dots_file_sync_owned_payload "$OWNED_SRC" "$OWNED_DEST" "$OWNED_MARKER" "test theme"
EOF
chmod +x "$SANDBOX/sync-owned-payload"
owned_src="$SANDBOX/owned-source"
owned_dest="$SANDBOX/owned-destination"
owned_marker="$SANDBOX/owned-destination.dots-owned"
printf 'first payload\n' >"$owned_src"
rc=0
HOME="$HOME" DOTS_FILE_TEST_CRASH_AFTER_PAYLOAD=1 \
  DOTS_FILES_HELPER="$ROOT/install/helpers/files.sh" \
  OWNED_SRC="$owned_src" OWNED_DEST="$owned_dest" OWNED_MARKER="$owned_marker" \
  bash -c '"$1" & child=$!; wait "$child"' bash "$SANDBOX/sync-owned-payload" \
    >/dev/null 2>&1 || rc=$?
((rc != 0)) || fail "owned payload failpoint did not terminate"
[[ $(cat "$owned_dest") == "first payload" ]] || fail "owned payload interruption lost published bytes"
[[ ! -e $owned_marker ]] || fail "owned payload interruption prematurely published ownership"
[[ -f $owned_marker.precommit ]] || fail "owned payload interruption lost precommit evidence"
printf 'second payload\n' >"$owned_src"
HOME="$HOME" DOTS_FILES_HELPER="$ROOT/install/helpers/files.sh" \
  OWNED_SRC="$owned_src" OWNED_DEST="$owned_dest" OWNED_MARKER="$owned_marker" \
  "$SANDBOX/sync-owned-payload"
[[ $(cat "$owned_dest") == "second payload" ]] || fail "owned payload recovery did not apply current bytes"
[[ $(cat "$owned_marker") == "dots-owned-theme-payload-v1" ]] || fail "owned payload recovery did not publish ownership"
[[ ! -e $owned_marker.precommit ]] || fail "owned payload recovery left precommit evidence"

foreign_dest="$SANDBOX/foreign-owned-destination"
foreign_marker="$SANDBOX/foreign-owned-destination.dots-owned"
printf 'intended payload\n' >"$owned_src"
rc=0
HOME="$HOME" DOTS_FILE_TEST_CRASH_AFTER_PAYLOAD=1 \
  DOTS_FILES_HELPER="$ROOT/install/helpers/files.sh" \
  OWNED_SRC="$owned_src" OWNED_DEST="$foreign_dest" OWNED_MARKER="$foreign_marker" \
  bash -c '"$1" & child=$!; wait "$child"' bash "$SANDBOX/sync-owned-payload" \
    >/dev/null 2>&1 || rc=$?
((rc != 0)) || fail "foreign replacement setup failpoint did not terminate"
printf 'foreign replacement\n' >"$foreign_dest"
printf 'later payload\n' >"$owned_src"
if HOME="$HOME" DOTS_FILES_HELPER="$ROOT/install/helpers/files.sh" \
  OWNED_SRC="$owned_src" OWNED_DEST="$foreign_dest" OWNED_MARKER="$foreign_marker" \
  "$SANDBOX/sync-owned-payload" >/dev/null 2>&1; then
  fail "owned payload recovery claimed foreign replacement bytes"
fi
[[ $(cat "$foreign_dest") == "foreign replacement" ]] || fail "owned payload recovery altered foreign replacement"
[[ ! -e $foreign_marker ]] || fail "owned payload recovery marked foreign replacement"
[[ ! -e $foreign_marker.precommit ]] || fail "owned payload recovery retained stale precommit evidence"
assertions=$((assertions + 12))

# Multiple replacements produce distinct backups even within one second.
printf '# edit one\n' >>"$HOME/.config/git/config"
"$ROOT/bin/dots-refresh-config" git/config >/dev/null
printf '# edit two\n' >>"$HOME/.config/git/config"
"$ROOT/bin/dots-refresh-config" git/config >/dev/null
backup_count=$(find "$HOME/.config/git" -maxdepth 1 -type d -name 'config.bak.*' | wc -l | tr -d ' ')
((backup_count >= 3)) || fail "refresh backups collided"
assertions=$((assertions + 1))

# refresh-config: rejects traversal
if "$ROOT/bin/dots" refresh config "../evil" >/dev/null 2>&1; then
  fail "refresh config accepted a traversal path"
fi
assertions=$((assertions + 1))

# Theme flow: migrate a legacy real current directory, then render and publish
# one atomic generation pointer.
mkdir -p "$HOME/.local/state/dots/current/theme"
printf 'legacy\n' >"$HOME/.local/state/dots/current/theme/legacy-proof"
printf 'legacy\n' >"$HOME/.local/state/dots/current/theme.name"
"$ROOT/bin/dots" theme set tokyo-night >/dev/null
[[ -L "$HOME/.local/state/dots/current" ]] || fail "theme current path is not an atomic pointer"
[[ -L "$HOME/.local/state/dots/theme-previous" ]] || fail "legacy theme was not retained for recovery"
theme_dir="$HOME/.local/state/dots/current/theme"
[[ -f "$theme_dir/btop.theme" ]] || fail "theme set did not render btop.theme"
grep -q '1a1b26' "$theme_dir/btop.theme" || fail "btop.theme missing tokyo-night background"
grep -q 'selection-background = #292e42' "$theme_dir/ghostty.conf" || fail "derived selection_background not rendered"
grep -q '122,162,247' "$theme_dir/colors.sh" || fail "rgb placeholder not rendered"
[[ $(cat "$HOME/.local/state/dots/current/theme.name") == "tokyo-night" ]] || fail "theme.name not recorded"
[[ -f "$theme_dir/neovim.lua" ]] || fail "theme set did not render neovim.lua"
[[ -f "$theme_dir/obsidian.css" ]] || fail "theme set did not render obsidian.css"
[[ -f "$theme_dir/pi.json" ]] || fail "theme set did not render pi.json"
[[ -f "$theme_dir/claude.json" ]] || fail "theme set did not render claude.json"
[[ -f "$theme_dir/tmux.conf" ]] || fail "theme set did not render tmux.conf"
if grep -R -q '{{' "$theme_dir"; then
  fail "rendered theme contains unresolved placeholders"
fi
command -v jq >/dev/null 2>&1 || fail "jq is required for theme integration tests"
jq empty "$theme_dir/pi.json" "$theme_dir/claude.json" || fail "rendered agent theme is invalid JSON"
assertions=$((assertions + 14))

# Theme integrations are maintained first-party code. Ordinary theme changes
# sync payloads without taking over Pi/Claude preferences; activation is explicit.
mkdir -p "$HOME/.config/dots/hooks/theme-set.d" "$HOME/.config/btop" \
  "$HOME/.config/nvim" "$HOME/.pi/agent" "$HOME/.claude"
