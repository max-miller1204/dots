#!/usr/bin/env bash

# dots:summary=Run pending dots migrations
# dots:args=[--pending|--check]

set -euo pipefail

mode="run"

usage() {
  echo "Usage: dots-migrate [--pending|--check]"
}

source "${BASH_SOURCE[0]%/*}/../install/helpers/runtime.sh"
source "$DOTS_PATH/install/helpers/files.sh"

while (($#)); do
  case "$1" in
    --pending | --check)
      mode="pending"
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      exit 1
      ;;
  esac
done
STATE_DIR="${DOTS_MIGRATION_STATE:-$HOME/.local/state/dots/migrations}"
MIGRATIONS_DIR="$DOTS_PATH/migrations"

pending_migrations() {
  local file name marker

  [[ -d $MIGRATIONS_DIR ]] || return 0
  for file in "$MIGRATIONS_DIR"/*.sh; do
    [[ -f $file ]] || continue
    name=${file##*/}
    marker="$STATE_DIR/$name"
    if [[ -L $marker || ( -e $marker && ( ! -f $marker || -s $marker ) ) ]]; then
      echo "Refusing unsafe or corrupt migration marker: $marker" >&2
      return 2
    fi
    [[ -f $marker ]] || printf '%s\n' "$name"
  done
}

MIGRATION_LOCK="$STATE_DIR/migrate.lock"
"$SELF_DIR/dots-ensure-flock"
dots_lock_open_fd9 "$MIGRATION_LOCK" Migration
if [[ $mode == "pending" ]]; then
  if ! flock -n 9; then
    echo "Cannot determine pending migrations while another migration is running." >&2
    exit 2
  fi
  pending_rc=0
  pending_output=$(pending_migrations) || pending_rc=$?
  if ((pending_rc != 0)); then
    exit "$pending_rc"
  elif [[ -n $pending_output ]]; then
    printf '%s\n' "$pending_output"
    exit 0
  else
    exit 1
  fi
fi

flock 9

[[ -d $MIGRATIONS_DIR ]] || exit 0

empty_marker=$(mktemp "${TMPDIR:-/tmp}/dots-migration-marker.XXXXXX")
trap 'rm -f "$empty_marker"' EXIT
migration_rc=0
for file in "$MIGRATIONS_DIR"/*.sh; do
  [[ -f $file ]] || continue
  name=${file##*/}
  marker="$STATE_DIR/$name"
  if [[ -L $marker || ( -e $marker && ( ! -f $marker || -s $marker ) ) ]]; then
    echo "Refusing unsafe or corrupt migration marker: $marker" >&2
    exit 2
  fi
  if [[ ! -f $marker ]]; then
    echo -e "\033[32m\nRunning migration (${name%.sh})\033[0m"
    file_rc=0
    DOTS_PATH="$DOTS_PATH" bash -euo pipefail "$file" 9>&- || file_rc=$?
    if ((file_rc == 0)); then
      dots_file_replace "$empty_marker" "$marker" discard
    else
      echo "Migration failed (${name%.sh}, exit $file_rc); continuing." >&2
      if ((migration_rc == 0)); then
        migration_rc=$file_rc
      fi
    fi
  fi
done

# Migrations may leave restart-*-required markers; report them here too so a
# standalone `dots migrate` surfaces them instead of leaving them for the
# next `dots update`.
if [[ -z ${DOTS_UPDATE_LOCK_PID:-} ]]; then
  "$SELF_DIR/dots-update-restart" 9>&-
fi
flock -u 9
exec 9>&-
exit "$migration_rc"
