#!/usr/bin/env bash

# dots:summary=Sync the generated theme to Claude Code
# dots:args=[--activate]

set -euo pipefail

source "${BASH_SOURCE[0]%/*}/../install/helpers/runtime.sh"
source "$DOTS_PATH/install/helpers/theme-sync.sh"
config_dir="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
dots_theme_sync_json_app dots-theme-sync-claude Claude "$config_dir" \
  claude.json "$config_dir/themes/dots.json" custom:dots "$@"
