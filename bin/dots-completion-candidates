#!/usr/bin/env bash
# dots:hidden=true

# Print context-aware completion candidates for the dots Bash and Zsh
# adapters. Arguments are the fully entered words after `dots`; the shell
# adapters filter the output against the word currently being typed.

if ((BASH_VERSINFO[0] < 4)); then
  exit 0
fi

DOTS_BIN_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd) || exit 0
DOTS_PATH=${DOTS_PATH:-${DOTS_BIN_DIR%/bin}}
DOTS_METADATA_SCAN_LIMIT=20
source "$DOTS_PATH/install/helpers/metadata.sh"
source "$DOTS_PATH/install/helpers/files.sh"

DOTS_COMPLETION_NUL=""
if [[ ${1:-} == "--null" ]]; then
  DOTS_COMPLETION_NUL=1
  shift
fi

declare -A emitted=()

visible_command() { # visible_command <file>
  [[ -f $1 && -x $1 && $(dots_command_metadata "$1" hidden) != "true" ]]
}

emit() { # emit <candidate>
  [[ -n $1 && -z ${emitted[$1]:-} ]] || return 0
  emitted[$1]=1
  if [[ -n $DOTS_COMPLETION_NUL ]]; then
    printf '%s\0' "$1"
  else
    printf '%s\n' "$1"
  fi
}

has_visible_prefix() { # has_visible_prefix <dots-command-prefix>
  local prefix=$1 file
  for file in "$DOTS_BIN_DIR/$prefix" "$DOTS_BIN_DIR/$prefix"-*; do
    visible_command "$file" && return 0
  done
  return 1
}

emit_subcommands() { # emit_subcommands <dots-command-prefix>
  local prefix=$1 file base rest next
  for file in "$DOTS_BIN_DIR/$prefix"-*; do
    visible_command "$file" || continue
    base=${file##*/}
    rest=${base#"$prefix"-}
    next=${rest%%-*}
    emit "$next"
  done
}

emit_argument_candidates() { # emit_argument_candidates <file> <argument-count>
  local file=$1 argument_count=$2 args_spec remaining option token value item name

  args_spec=$(dots_command_metadata "$file" args)
  remaining=$args_spec
  while [[ $remaining =~ (--[[:alnum:]][[:alnum:]-]*) ]]; do
    option=${BASH_REMATCH[1]}
    emit "$option"
    remaining=${remaining#*"$option"}
  done

  if ((argument_count == 0)); then
    for token in $args_spec; do
      token=${token#[}
      token=${token%]}
      token=${token#<}
      token=${token%>}
      if [[ $token == *"|"* && $token != -* ]]; then
        while IFS= read -r value; do
          emit "$value"
        done <<<"${token//|/$'\n'}"
      fi
    done
  fi

  ((argument_count == 0)) || return 0

  case ${file##*/} in
    dots-theme-set)
      for item in "$DOTS_PATH"/themes/* "$HOME"/.config/dots/themes/*; do
        name=${item##*/}
        if [[ -d $item && ! -L $item && $name =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]]; then
          emit "$name"
        fi
      done
      ;;
    dots-hook | dots-hook-install)
      emit post-update
      emit theme-set
      for item in "$DOTS_PATH"/config/dots/hooks/* "$HOME"/.config/dots/hooks/*; do
        [[ -e $item || -L $item ]] || continue
        name=${item##*/}
        name=${name%.d}
        [[ $name == *.sample ]] || emit "$name"
      done
      ;;
    dots-refresh-config)
      while IFS= read -r -d '' item; do
        value=${item#./}
        [[ $value == *..* ]] || emit "$value"
      done < <(dots_config_find_files "$DOTS_PATH/config")
      ;;
    dots-config-import)
      while IFS= read -r -d '' item; do
        value=${item#./}
        [[ $value == *..* ]] || emit "$value"
      done < <(dots_config_find_files "$HOME/.config")
      ;;
  esac
}

# `dots help <group>` accepts the same visible first-level groups as `dots`.
if [[ ${1:-} == "help" || ${1:-} == "-h" || ${1:-} == "--help" ]]; then
  (($# == 1)) && emit_subcommands dots
  exit 0
fi

prefix=dots
command_argc=0
for word in "$@"; do
  [[ $word == -* ]] && break
  candidate="$prefix-$word"
  has_visible_prefix "$candidate" || break
  prefix=$candidate
  command_argc=$((command_argc + 1))
done

# Offer deeper commands only while every completed positional word still
# belongs to the command path. Once arguments begin, only argument candidates
# are relevant.
if (($# == command_argc)); then
  emit_subcommands "$prefix"
fi

command_file="$DOTS_BIN_DIR/$prefix"
argument_count=$(( $# - command_argc ))
if [[ $prefix == "dots" || -f $command_file && -x $command_file ]] &&
  [[ $prefix == "dots" || $(dots_command_metadata "$command_file" hidden) != "true" ]]; then
  if ((argument_count == 0)); then
    emit -h
    emit --help
  fi
  [[ $prefix == "dots" ]] || emit_argument_candidates "$command_file" "$argument_count"
fi
