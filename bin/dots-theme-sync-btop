#!/usr/bin/env bash

# dots:summary=Sync the generated theme to btop
# dots:hidden=true

set -euo pipefail

source "${BASH_SOURCE[0]%/*}/../install/helpers/runtime.sh"
source "$DOTS_PATH/install/helpers/theme-sync.sh"

config_dir="${BTOP_CONFIG_DIR:-$HOME/.config/btop}"
dots_theme_sync_link \
  btop.theme "btop theme" "$config_dir" "$config_dir/themes/dots-system.theme"

# btop reloads its selected theme on SIGUSR2.
[[ -z $DOTS_THEME_SYNC_APPLIED ]] || pkill -USR2 -x btop 2>/dev/null || true
