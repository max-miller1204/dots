#!/usr/bin/env bash

# dots:hidden=true
# Resolve the editable dots checkout independently from the active runtime.

set -eo pipefail

path_file="$HOME/.config/dots/source-path"
if [[ ( -e $path_file || -L $path_file ) && ( -L $path_file || ! -f $path_file ) ]]; then
  echo "Refusing non-regular dots source path file: $path_file" >&2
  exit 1
fi
if [[ -f $path_file ]]; then
  mapfile -t configured_lines <"$path_file"
  if ((${#configured_lines[@]} != 1)) || [[ -z ${configured_lines[0]} || ${configured_lines[0]} == *:* ]]; then
    echo "Invalid dots source path file: $path_file" >&2
    exit 1
  fi
  source_path=${configured_lines[0]}
else
  self_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
  source_path=$("$self_dir/dots-path-resolve") || exit 1
fi
if ! git -C "$source_path" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "Dots source path is not a Git checkout: $source_path" >&2
  exit 1
fi
cd -- "$source_path"
pwd -P
