#!/usr/bin/env bash

# dots:summary=Run a command while holding the per-user update lock
# dots:args=<command> [args...]
# dots:hidden=true
#
# flock(1) holds the lock on fd 9's open file description, which the exec'd
# command inherits: the kernel releases it when the last holder exits — any
# exit, including SIGKILL — so there is no stale state to reclaim and no
# signal forwarding to get right. Ubuntu/WSL ship flock in util-linux; on
# macOS install/config/macos.sh installs the discoteq port (brew), whose
# fd mode, -n, and -E behavior we verified against util-linux's. The lock
# path avoids TMPDIR, which differs between GUI and cron/ssh contexts on
# macOS and would split the lock across them.

set -eo pipefail

if (($# < 1)); then
  echo "Usage: dots-update-lock <command> [args...]" >&2
  exit 1
fi

SELF_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
DOTS_PATH=$("$SELF_DIR/dots-path-resolve")
DOTS_PATH=$(cd -- "$DOTS_PATH" && pwd)
if [[ $SELF_DIR != "$DOTS_PATH/bin" ]]; then
  exec "$DOTS_PATH/bin/dots-update-lock" "$@"
fi
source "$DOTS_PATH/install/helpers/files.sh"
"$SELF_DIR/dots-ensure-flock"

LOCK="${DOTS_UPDATE_LOCK:-$HOME/.local/state/dots/update.lock}"
dots_file_assert_safe_parents "$LOCK" "$HOME"
mkdir -p "${LOCK%/*}"
dots_file_assert_safe_parents "$LOCK" "$HOME"
if [[ -L $LOCK || ( -e $LOCK && ! -f $LOCK ) ]]; then
  echo "Refusing unsafe update lock path: $LOCK" >&2
  exit 1
fi

# Append mode does not alter a path that is swapped during open. Validate the
# opened inode against the path before locking or writing through the fd.
exec 9>>"$LOCK"
if [[ -L $LOCK || ! -f $LOCK ]]; then
  echo "Update lock path changed during open: $LOCK" >&2
  exit 1
fi
if [[ $(uname -s) == "Darwin" ]]; then
  lock_id=$(stat -f '%d:%i' "$LOCK")
  fd_id=$(perl -e 'open(my $fh, "<&=9") or exit 1; my @s = stat($fh); print "$s[0]:$s[1]"')
else
  lock_id=$(stat -Lc '%d:%i' "$LOCK")
  fd_id=$(stat -Lc '%d:%i' /proc/self/fd/9)
fi
if [[ $lock_id != "$fd_id" ]]; then
  echo "Update lock path changed during open: $LOCK" >&2
  exit 1
fi

# -E gives contention its own exit code, so a real flock(2) failure (an
# unsupported filesystem, say) is not misreported as a running update.
rc=0
flock -n -E 99 9 || rc=$?
if ((rc == 99)); then
  holder=""
  holder=$(tail -n 1 "$LOCK" 2>/dev/null) || true
  holder=${holder//[^0-9]/}
  echo "Another dots update is already running${holder:+ (pid $holder)}." >&2
  exit 1
elif ((rc != 0)); then
  echo "Could not take the update lock: flock failed (exit $rc) on $LOCK." >&2
  exit 1
fi

# Holder breadcrumb for the refusal message above — informational only. Append
# through the verified fd; never reopen the pathname after validation.
printf '%s\n' "$$" >&9

export DOTS_UPDATE_LOCK_PID=$$
exec "$@"
