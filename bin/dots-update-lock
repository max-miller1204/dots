#!/usr/bin/env bash

# dots:summary=Run a command while holding the per-user update lock
# dots:args=<command> [args...]
# dots:hidden=true
#
# flock(1) holds the lock on fd 9's open file description, which the exec'd
# command inherits: the kernel releases it when the last holder exits — any
# exit, including SIGKILL — so there is no stale state to reclaim and no
# signal forwarding to get right. Ubuntu/WSL ship flock in util-linux; on
# macOS install/config/macos.sh installs the discoteq port (brew), whose
# fd mode, -n, and -E behavior we verified against util-linux's. The lock
# path avoids TMPDIR, which differs between GUI and cron/ssh contexts on
# macOS and would split the lock across them.

set -eo pipefail

if (($# < 1)); then
  echo "Usage: dots-update-lock <command> [args...]" >&2
  exit 1
fi

if ! command -v flock >/dev/null 2>&1; then
  echo "flock(1) not found. On macOS: brew install flock (dots install handles this)." >&2
  exit 1
fi

LOCK="${DOTS_UPDATE_LOCK:-$HOME/.local/state/dots/update.lock}"
mkdir -p "$(dirname "$LOCK")"

# Append mode, so opening never clobbers a live holder's pid note.
exec 9>>"$LOCK"

if ! flock -n 9; then
  holder=$(head -c 64 "$LOCK" 2>/dev/null | tr -dc '0-9')
  echo "Another dots update is already running${holder:+ (pid $holder)}." >&2
  exit 1
fi

# Holder breadcrumb for the refusal message above — informational only; the
# kernel, not this file, owns the lock.
: >"$LOCK"
printf '%s\n' "$$" >&9

export DOTS_UPDATE_LOCK_PID=$$
exec "$@"
