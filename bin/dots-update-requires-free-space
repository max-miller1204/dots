#!/usr/bin/env bash

# dots:summary=Abort the update when free disk space is too low
# dots:hidden=true
#
# Ported from omarchy: silently skipped when free space cannot be
# determined; DOTS_UPDATE_FORCE=1 bypasses. Threshold defaults to 1 GiB
# (mise toolchain downloads), overridable via DOTS_UPDATE_MIN_FREE_KB.

set -o pipefail

SELF_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
DOTS_PATH=${DOTS_PATH:-$("$SELF_DIR/dots-path-resolve")}
DOTS_PATH=$(cd -- "$DOTS_PATH" && pwd) || exit 1
if [[ $SELF_DIR != "$DOTS_PATH/bin" ]]; then exec "$DOTS_PATH/bin/dots-update-requires-free-space" "$@"; fi

[[ ${DOTS_UPDATE_FORCE:-} == "1" ]] && exit 0

min_free_kb=${DOTS_UPDATE_MIN_FREE_KB:-1048576}

# Fail closed on a malformed threshold — a unit suffix like "1G" would
# otherwise error out of (( )) and silently disable the guard.
if [[ ! $min_free_kb =~ ^[0-9]+$ ]]; then
  echo "Invalid DOTS_UPDATE_MIN_FREE_KB: '$min_free_kb' (whole KiB required)." >&2
  exit 1
fi

# Count from the end: the filesystem source name can contain spaces
# (macOS's 'map auto_home'), which shifts positional fields but leaves
# Available at NF-2.
avail_kb=$(df -Pk "$HOME" 2>/dev/null | awk 'NR == 2 { print $(NF - 2) }')
[[ $avail_kb =~ ^[0-9]+$ ]] || exit 0

if ((avail_kb < min_free_kb)); then
  echo "Not enough free disk space for an update:" >&2
  echo "  available: $((avail_kb / 1024)) MiB, required: $((min_free_kb / 1024)) MiB" >&2
  echo "Free some space, or bypass with DOTS_UPDATE_FORCE=1." >&2
  exit 1
fi
