#!/usr/bin/env bash

# dots:summary=Update dotfiles: pull the repo, sync packages, run migrations and hooks
#
# The omarchy update pipeline, ported:
#   lock -> transcript (script(1) pty) -> free-space check -> git pull
#   -> mise sync -> migrations -> post-update hook -> log analysis
#   -> restart checks
#
# Three exec stages: acquire the flock'd fd (dots-update-lock), re-exec
# under script(1) so the run is recorded on a real pty, then run the
# pipeline (--transcribed marks the innermost stage; it is honored only
# when the lock sentinel names our direct parent — the script(1) stage —
# so hooks, migrations, and their descendants cannot re-enter with it).

set -eo pipefail

SELF_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
DOTS_PATH=${DOTS_PATH:-$("$SELF_DIR/dots-path-resolve")}
DOTS_PATH=$(cd -- "$DOTS_PATH" && pwd)
if [[ $SELF_DIR != "$DOTS_PATH/bin" ]]; then
  exec "$DOTS_PATH/bin/dots-update" "$@"
fi
source "$DOTS_PATH/install/helpers/files.sh"
STATE_DIR="$HOME/.local/state/dots"
dots_file_assert_safe_parents "$STATE_DIR/update.log" "$HOME"
UPDATE_LOCK="${DOTS_UPDATE_LOCK:-$STATE_DIR/update.lock}"

update_lock_fd_valid() {
  local lock_id fd_id

  { true >&9; } 2>/dev/null || return 1
  command -v flock >/dev/null 2>&1 || return 1
  if [[ $(uname -s) == "Darwin" ]]; then
    lock_id=$(stat -f '%i' "$UPDATE_LOCK" 2>/dev/null) || return 1
    fd_id=$(stat -f '%i' /dev/fd/9 2>/dev/null) || return 1
  else
    lock_id=$(stat -Lc '%d:%i' "$UPDATE_LOCK" 2>/dev/null) || return 1
    fd_id=$(stat -Lc '%d:%i' /proc/self/fd/9 2>/dev/null) || return 1
  fi
  [[ $lock_id == "$fd_id" ]] || return 1

  # Re-locking the inherited open file description succeeds. A forged fd on
  # the real file either acquires the lock (making the run safe) or fails while
  # another updater owns it.
  flock -n 9
}

# The sentinel is the lock holder's PID, which script(1) inherits through
# the exec chain — so the transcribed stage is exactly the process whose
# parent carries it. An exported copy reaching hooks or daemons they leave
# behind cannot equal the caller's own $PPID.
transcribed=""
if [[ ${1:-} == "--transcribed" && ${DOTS_UPDATE_LOCK_PID:-} == "$PPID" ]] && update_lock_fd_valid; then
  transcribed=1
  shift
fi

# No public options exist; swallowing an unknown flag (say, --dry-run) and
# running a real update anyway would be worse than refusing.
if (($#)); then
  echo "dots-update: unknown arguments: $*" >&2
  echo "Usage: dots update" >&2
  exit 1
fi

if [[ ! -d $DOTS_PATH ]]; then
  echo "No dotfiles checkout at $DOTS_PATH" >&2
  exit 1
fi

LOG_FILE="$STATE_DIR/update.log"
PREV_LOG_FILE="$LOG_FILE.prev"
PREV_NOTE_MARKER="$STATE_DIR/update-prev-incomplete"
TERMINAL_STATUS_FILE="$STATE_DIR/update-terminal-status"
for owned_state_file in "$LOG_FILE" "$PREV_LOG_FILE" "$PREV_NOTE_MARKER" "$TERMINAL_STATUS_FILE"; do
  dots_file_assert_safe_parents "$owned_state_file" "$HOME"
  if [[ -L $owned_state_file || ( -e $owned_state_file && ! -f $owned_state_file ) ]]; then
    echo "Refusing unsafe update state path: $owned_state_file" >&2
    exit 1
  fi
done

if [[ -z $transcribed ]]; then
  # Stage 1: serialize with any other running update. Stage 2 may only run
  # in the lock wrapper's own exec'd process: the sentinel must equal our
  # PID and the lock fd must actually be open, so a stale exported
  # sentinel colliding with a reused PID still goes through the lock.
  if [[ ${DOTS_UPDATE_LOCK_PID:-} != "$$" ]]; then
    exec "$SELF_DIR/dots-update-lock" "$SELF_DIR/dots-update"
  fi
  if ! update_lock_fd_valid; then
    echo "Inherited update lock proof is invalid; refusing to continue." >&2
    exit 1
  fi

  # Stage 2 (locked): rotate a dead run's transcript before script(1)
  # truncates the log. A previous transcript with no terminal status marker
  # means that run died — preserve it and leave a note marker for the
  # transcribed stage to report.
  mkdir -p "$STATE_DIR"
  if [[ -e $LOG_FILE && ! -f $TERMINAL_STATUS_FILE ]]; then
    # Publish the warning marker before moving the only transcript. A death at
    # either boundary therefore leaves enough state for the next run to report.
    note_source=$(mktemp "${TMPDIR:-/tmp}/dots-update-note.XXXXXX")
    dots_file_replace "$note_source" "$PREV_NOTE_MARKER" discard
    rm -f "$note_source"
    if [[ ${DOTS_UPDATE_TEST_CRASH_AFTER_NOTE:-} == "1" ]]; then
      kill -KILL "$$"
    fi
    mv -f "$LOG_FILE" "$PREV_LOG_FILE"
  elif [[ -e $LOG_FILE ]]; then
    dots_file_remove "$LOG_FILE" discard
  fi
  # A status file only describes the transcript just handled. Remove it after
  # the old log is gone, so a death here cannot misclassify that old log.
  dots_file_remove "$TERMINAL_STATUS_FILE" discard

  # Re-exec under script(1) for a transcript recorded off a real pty (child
  # programs keep colors/progress, and the log is complete when script
  # exits). script ships in the macOS base system and in Ubuntu's Essential
  # bsdutils, so a missing one is a broken host, not a mode to degrade
  # into: running without a transcript would blind crash detection and the
  # analyzer.
  if ! command -v script >/dev/null 2>&1; then
    echo "script(1) not found; it ships with macOS and with bsdutils on Ubuntu/WSL." >&2
    exit 1
  fi

  # Hand script(1) the caller's tty only for an interactive foreground run
  # (so git can still prompt); pipes, sockets, closed stdin, and background
  # jobs get /dev/null — script would drain a pipe into the transcript,
  # die on a socket, hang on a closed fd, or SIGTTOU-stop the run from a
  # background process group, all while holding the lock.
  if [[ ! -t 0 ]] || (($(ps -o tpgid= -p $$) != $(ps -o pgid= -p $$))); then
    exec </dev/null
  fi

  # BSD and util-linux script disagree on flags: BSD takes the command as
  # trailing args and propagates its exit status by default; util-linux
  # needs -e for the status and -c with a command string, which it hands
  # to $SHELL — pinned to the running bash so the quoting always parses.
  if [[ $(uname -s) == "Darwin" ]]; then
    exec script -qF "$LOG_FILE" "$SELF_DIR/dots-update" --transcribed
  else
    inner="$SELF_DIR/dots-update"
    SHELL=$BASH exec script -qefc "${inner@Q} --transcribed" "$LOG_FILE"
  fi
fi

# Stage 3 (locked + transcribed): the pipeline. The lock lives on fd 9 in
# the script(1) parent recording us; close our inherited copy so no child
# (git, mise, migrations, hooks) can leave a daemon holding the lock.
exec 9>&-

# Signal deaths exit through the shell so both script(1) dialects report
# the usual 128+n (BSD script would otherwise pass the raw signal number
# through as the exit status). No end marker is written, so the next run
# still reports the interrupted transcript.
trap 'exit 130' INT
trap 'exit 143' TERM

mark_update_terminal() {
  local status_source
  status_source=$(mktemp "${TMPDIR:-/tmp}/dots-update-status.XXXXXX")
  dots_file_replace "$status_source" "$TERMINAL_STATUS_FILE" discard
  rm -f "$status_source"
}

# A deliberate abort still marks the transcript as finished, so the next run
# doesn't misreport it as a crash.
abort_update() {
  echo "Update aborted."
  mark_update_terminal
  exit "$1"
}

echo "=== dots update: $(date) ==="
if [[ -f $PREV_NOTE_MARKER ]]; then
  echo "Note: the previous update did not finish cleanly (transcript: $LOG_FILE.prev)."
  dots_file_remove "$PREV_NOTE_MARKER" discard
fi

"$SELF_DIR/dots-update-requires-free-space" || abort_update "$?"

degraded_steps=()

# 1. Fast-forward the checkout, but never touch local work in progress.
if git -C "$DOTS_PATH" rev-parse --git-dir >/dev/null 2>&1; then
  if [[ -z $(git -C "$DOTS_PATH" status --porcelain --untracked-files=normal) ]]; then
    if git -C "$DOTS_PATH" remote get-url origin >/dev/null 2>&1; then
      echo "Updating dotfiles checkout..."
      if ! git -C "$DOTS_PATH" pull --ff-only; then
        echo "Could not fast-forward; resolve manually." >&2
        degraded_steps+=("git pull")
      fi
    else
      echo "No git remote configured; checkout convergence cannot be verified." >&2
      degraded_steps+=("git remote")
    fi
  else
    echo "Checkout has local changes; skipping pull." >&2
    degraded_steps+=("git pull (local changes)")
  fi
else
  echo "Dotfiles path is not a Git checkout; skipping pull." >&2
  degraded_steps+=("git checkout")
fi

# 2. Packages: install anything newly pinned in the manifest, then upgrade.
if command -v mise >/dev/null 2>&1; then
  echo "Syncing mise tools..."
  mise install || degraded_steps+=("mise install")
  mise upgrade || degraded_steps+=("mise upgrade")
  mise self-update --yes >/dev/null 2>&1 || degraded_steps+=("mise self-update")
else
  echo "mise is unavailable; tool convergence failed." >&2
  degraded_steps+=("mise unavailable")
fi

# 3. Migrations, then the post-update hook — same order as omarchy update.
# A migration failure must not skip the analyzer and restart report below.
migrate_rc=0
"$SELF_DIR/dots-migrate" || migrate_rc=$?
if ((migrate_rc == 0)); then
  "$SELF_DIR/dots-hook" post-update || degraded_steps+=("post-update hook")
else
  echo "Migrations failed (exit $migrate_rc); skipping the post-update hook."
fi

# 4. Point at problems buried in the transcript, then report restarts. These
# reporting failures degrade the run but still publish terminal status.
"$SELF_DIR/dots-update-analyze-logs" "$LOG_FILE" || degraded_steps+=("log analysis")
"$SELF_DIR/dots-update-restart" || degraded_steps+=("restart reporting")

if ((migrate_rc != 0)); then
  echo "Update failed: migrations exited $migrate_rc."
  echo "Update incomplete."
  mark_update_terminal
  exit "$migrate_rc"
fi

if ((${#degraded_steps[@]})); then
  echo
  echo "Update did not fully converge:" >&2
  printf '  - %s\n' "${degraded_steps[@]}" >&2
  echo "Update incomplete."
  mark_update_terminal
  exit 2
fi

echo "Update complete."
mark_update_terminal
