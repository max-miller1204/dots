#!/usr/bin/env bash

# dots:summary=Update dotfiles: pull the repo, sync packages, run migrations and hooks
#
# The omarchy update pipeline, ported:
#   lock -> transcript (script(1) pty) -> free-space check -> git pull
#   -> mise sync -> migrations -> post-update hook -> log analysis
#   -> restart checks
#
# Three exec stages: acquire the flock'd fd (dots-update-lock), re-exec
# under script(1) so the run is recorded on a real pty, then run the
# pipeline (--transcribed marks the innermost stage; it is argv, not env,
# so it cannot leak into nested invocations from hooks).

set -eo pipefail

SELF_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
DOTS_PATH=${DOTS_PATH:-$HOME/dotfiles}

transcribed=""
if [[ ${1:-} == "--transcribed" && -n ${DOTS_UPDATE_LOCK_PID:-} ]]; then
  transcribed=1
  shift
fi

# No public options exist; swallowing an unknown flag (say, --dry-run) and
# running a real update anyway would be worse than refusing.
if (($#)); then
  echo "dots-update: unknown arguments: $*" >&2
  echo "Usage: dots update" >&2
  exit 1
fi

if [[ ! -d $DOTS_PATH ]]; then
  echo "No dotfiles checkout at $DOTS_PATH" >&2
  exit 1
fi

STATE_DIR="$HOME/.local/state/dots"
LOG_FILE="$STATE_DIR/update.log"
PREV_NOTE_MARKER="$STATE_DIR/update-prev-incomplete"

if [[ -z $transcribed ]]; then
  # Stage 1: serialize with any other running update. The sentinel is the
  # lock holder's own PID and honored only by that same process, so an
  # exported copy reaching hooks, migrations, or their descendants cannot
  # let a nested `dots update` bypass the lock.
  if [[ ${DOTS_UPDATE_LOCK_PID:-} != "$$" ]]; then
    exec "$SELF_DIR/dots-update-lock" "$SELF_DIR/dots-update"
  fi

  # Stage 2 (locked): rotate a dead run's transcript before script(1)
  # truncates the log. A previous transcript with neither end marker
  # ("Update complete." / "Update aborted.") means that run died — preserve
  # it and leave a note marker for the transcribed stage to report.
  mkdir -p "$STATE_DIR"
  if [[ -s $LOG_FILE ]] && ! grep -Eq "Update (complete|aborted)\." "$LOG_FILE"; then
    mv -f "$LOG_FILE" "$LOG_FILE.prev"
    touch "$PREV_NOTE_MARKER"
  fi

  # Re-exec under script(1) for a transcript recorded off a real pty (child
  # programs keep colors/progress, and the log is complete when script
  # exits). BSD and util-linux script disagree on flags: BSD takes the
  # command as trailing args and propagates its exit status by default;
  # util-linux needs -e for the status and -c with a command string.
  if command -v script >/dev/null 2>&1; then
    if [[ $(uname -s) == "Darwin" ]]; then
      exec script -qF "$LOG_FILE" "$SELF_DIR/dots-update" --transcribed
    else
      exec script -qefc "$(printf '%q %q' "$SELF_DIR/dots-update" --transcribed)" "$LOG_FILE"
    fi
  fi
  echo "script(1) not found; running without a transcript."
  : >"$LOG_FILE"
  exec "$SELF_DIR/dots-update" --transcribed
fi

# Stage 3 (locked + transcribed): the pipeline.

# A deliberate abort still marks the transcript as finished, so the next run
# doesn't misreport it as a crash.
abort_update() {
  echo "Update aborted."
  exit "$1"
}

echo "=== dots update: $(date) ==="
if [[ -f $PREV_NOTE_MARKER ]]; then
  rm -f "$PREV_NOTE_MARKER"
  echo "Note: the previous update did not finish cleanly (transcript: $LOG_FILE.prev)."
fi

"$SELF_DIR/dots-update-requires-free-space" || abort_update "$?"

# 1. Fast-forward the checkout, but never touch local work in progress.
if git -C "$DOTS_PATH" rev-parse --git-dir >/dev/null 2>&1; then
  if git -C "$DOTS_PATH" diff --quiet && git -C "$DOTS_PATH" diff --cached --quiet; then
    if git -C "$DOTS_PATH" remote get-url origin >/dev/null 2>&1; then
      echo "Updating dotfiles checkout..."
      git -C "$DOTS_PATH" pull --ff-only || echo "Could not fast-forward; resolve manually."
    else
      echo "No git remote configured; skipping pull."
    fi
  else
    echo "Checkout has local changes; skipping pull."
  fi
fi

# 2. Packages: install anything newly pinned in the manifest, then upgrade.
if command -v mise >/dev/null 2>&1; then
  echo "Syncing mise tools..."
  mise install || true
  mise upgrade || true
  mise self-update --yes >/dev/null 2>&1 || true
fi

# 3. Migrations, then the post-update hook — same order as omarchy update.
# A migration failure must not skip the analyzer and restart report below.
# Both run with the lock fd (9) closed, so a daemon they start cannot hold
# the update lock forever.
migrate_rc=0
"$SELF_DIR/dots-migrate" 9>&- || migrate_rc=$?
if ((migrate_rc == 0)); then
  "$SELF_DIR/dots-hook" post-update 9>&-
else
  echo "Migrations failed (exit $migrate_rc); skipping the post-update hook."
fi

# 4. Point at problems buried in the transcript, then report restarts.
"$SELF_DIR/dots-update-analyze-logs" "$LOG_FILE"
"$SELF_DIR/dots-update-restart"

if ((migrate_rc != 0)); then
  echo "Update failed: migrations exited $migrate_rc."
  exit "$migrate_rc"
fi

echo "Update complete."
