#!/usr/bin/env bash

# dots:summary=Report components needing a restart after an update
# dots:hidden=true
#
# Migrations and hooks signal a needed restart by touching
# ~/.local/state/dots/restart-<component>-required. Each marker is reported
# once and cleared (omarchy's restart-marker pattern).

set -eo pipefail

source "${BASH_SOURCE[0]%/*}/../install/helpers/runtime.sh"
source "$DOTS_PATH/install/helpers/files.sh"

state_dir="$HOME/.local/state/dots"
dots_file_assert_safe_parents "$state_dir/restart-probe-required" "$HOME"

for marker in "$state_dir"/restart-*-required; do
  [[ -f $marker || -L $marker ]] || continue
  if [[ -L $marker || ! -f $marker ]]; then
    echo "Refusing unsafe restart marker: $marker" >&2
    exit 1
  fi
  name=${marker##*/restart-}
  name=${name%-required}
  case "$name" in
    shell) echo 'Restart required: shell: open a new terminal or run: exec "$SHELL" -l' ;;
    *) echo "Restart required: $name" ;;
  esac
  rm -f "$marker"
done

exit 0
