#!/usr/bin/env bash

# dots:summary=Sync the generated theme to Pi
# dots:args=[--activate]

set -euo pipefail

source "${BASH_SOURCE[0]%/*}/../install/helpers/runtime.sh"
source "$DOTS_PATH/install/helpers/theme-sync.sh"
config_dir="${PI_AGENT_DIR:-$HOME/.pi/agent}"
dots_theme_sync_json_app dots-theme-sync-pi Pi "$config_dir" \
  pi.json "$config_dir/themes/dots-system.json" dots-system "$@"
