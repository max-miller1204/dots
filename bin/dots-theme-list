#!/usr/bin/env bash

# dots:summary=List available themes
# dots:examples=dots theme list

SELF_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
DOTS_PATH=$("$SELF_DIR/dots-path-resolve") || exit 1
DOTS_PATH=$(cd -- "$DOTS_PATH" && pwd) || exit 1
if [[ $SELF_DIR != "$DOTS_PATH/bin" ]]; then exec "$DOTS_PATH/bin/${BASH_SOURCE[0]##*/}" "$@"; fi

current=""
[[ -f $HOME/.local/state/dots/current/theme.name ]] &&
  current=$(<"$HOME/.local/state/dots/current/theme.name")

{
  for dir in "$DOTS_PATH/themes"/*/ "$HOME/.config/dots/themes"/*/; do
    [[ -d $dir ]] || continue
    basename "$dir"
  done
} | sort -u | while IFS= read -r name; do
  if [[ $name == $current ]]; then
    echo "$name (current)"
  else
    echo "$name"
  fi
done
