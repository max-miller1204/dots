#!/usr/bin/env bash

# dots:summary=Check whether dotfiles updates are available
# dots:examples=dots update available
#
# Exit codes, distinct so scripts can tell the states apart:
#   0 — updates available (pending commits printed)
#   1 — up to date
#   2 — cannot determine (not a checkout, no remote, or no upstream)
# A failed fetch is quiet and falls back to the existing remote-tracking
# state, so this works offline (omarchy-update-available semantics).

set -o pipefail

SELF_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
DOTS_PATH=${DOTS_PATH:-$("$SELF_DIR/dots-path-resolve")} || exit 2
DOTS_PATH=$(cd -- "$DOTS_PATH" && pwd) || exit 2
if [[ $SELF_DIR != "$DOTS_PATH/bin" ]]; then
  exec "$DOTS_PATH/bin/dots-update-available" "$@"
fi
source "$DOTS_PATH/install/helpers/files.sh"
UPDATE_LOCK="${DOTS_UPDATE_LOCK:-$HOME/.local/state/dots/update.lock}"

"$SELF_DIR/dots-ensure-flock" || exit 2
dots_file_assert_safe_parents "$UPDATE_LOCK" "$HOME" || exit 2
mkdir -p "${UPDATE_LOCK%/*}"
dots_file_assert_safe_parents "$UPDATE_LOCK" "$HOME" || exit 2
if [[ -L $UPDATE_LOCK || ( -e $UPDATE_LOCK && ! -f $UPDATE_LOCK ) ]]; then
  echo "Cannot check updates with an unsafe lock path: $UPDATE_LOCK" >&2
  exit 2
fi
exec 8>>"$UPDATE_LOCK"
if [[ -L $UPDATE_LOCK || ! -f $UPDATE_LOCK ]]; then
  echo "Update lock path changed during open: $UPDATE_LOCK" >&2
  exit 2
fi
if [[ $(uname -s) == "Darwin" ]]; then
  lock_id=$(stat -f '%i' "$UPDATE_LOCK")
  fd_id=$(stat -f '%i' /dev/fd/8)
else
  lock_id=$(stat -Lc '%d:%i' "$UPDATE_LOCK")
  fd_id=$(stat -Lc '%d:%i' /proc/self/fd/8)
fi
if [[ $lock_id != "$fd_id" ]]; then
  echo "Update lock path changed during open: $UPDATE_LOCK" >&2
  exit 2
fi
if ! flock -n 8; then
  echo "Cannot check updates while dots update is running." >&2
  exit 2
fi

if ! git -C "$DOTS_PATH" rev-parse --git-dir >/dev/null 2>&1; then
  echo "Not a git checkout: $DOTS_PATH" >&2
  exit 2
fi

if ! git -C "$DOTS_PATH" remote get-url origin >/dev/null 2>&1; then
  echo "No git remote configured." >&2
  exit 2
fi

git -C "$DOTS_PATH" fetch -q 2>/dev/null || true

if ! upstream=$(git -C "$DOTS_PATH" rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null); then
  echo "No upstream tracking branch." >&2
  exit 2
fi

if ! behind=$(git -C "$DOTS_PATH" rev-list --count "HEAD..$upstream" 2>/dev/null); then
  echo "Cannot determine update status." >&2
  exit 2
fi

if ((behind > 0)); then
  echo "dots updates available ($behind commits):"
  git -C "$DOTS_PATH" --no-pager log --oneline "HEAD..$upstream"
  exit 0
else
  echo "dots is up to date."
  exit 1
fi
