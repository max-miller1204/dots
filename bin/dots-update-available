#!/usr/bin/env bash

# dots:summary=Check whether dotfiles updates are available
# dots:examples=dots update available
#
# Exit codes, distinct so scripts can tell the states apart:
#   0: updates available (release version or pending commits printed)
#   1: up to date
#   2: cannot determine (release metadata unavailable, or no Git upstream)
# Stable mode compares published versions; developer mode compares Git.

set -o pipefail

DOTS_RUNTIME_ERROR_STATUS=2
source "${BASH_SOURCE[0]%/*}/../install/helpers/runtime.sh"
source "$DOTS_PATH/install/helpers/files.sh"
source "$DOTS_PATH/install/helpers/releases.sh"
UPDATE_LOCK="${DOTS_UPDATE_LOCK:-$HOME/.local/state/dots/update.lock}"

"$SELF_DIR/dots-ensure-flock" || exit 2
dots_lock_open_fd9 "$UPDATE_LOCK" Update || exit 2
if ! flock -n 9; then
  echo "Cannot check updates while dots update is running." >&2
  exit 2
fi

if dots_release_is_stable_mode; then
  current=$(dots_release_pointer_version "$DOTS_RELEASE_CURRENT" 2>/dev/null) || {
    echo "Cannot determine the active dots release." >&2
    exit 2
  }
  if ! dots_release_fetch_latest_manifest; then
    echo "Cannot check published dots releases." >&2
    exit 2
  fi
  compare_rc=0
  dots_release_compare_versions "$DOTS_LATEST_VERSION" "$current" || compare_rc=$?
  case "$compare_rc" in
    0)
      echo "dots $current is up to date."
      exit 1
      ;;
    1)
      echo "dots $DOTS_LATEST_VERSION is available (installed: $current)."
      exit 0
      ;;
    2)
      echo "dots $current is newer than the latest published release $DOTS_LATEST_VERSION."
      exit 1
      ;;
    *)
      echo "Cannot compare dots release versions." >&2
      exit 2
      ;;
  esac
fi

if ! git -C "$DOTS_PATH" rev-parse --git-dir >/dev/null 2>&1; then
  echo "Not a git checkout: $DOTS_PATH" >&2
  exit 2
fi

if ! git -C "$DOTS_PATH" remote get-url origin >/dev/null 2>&1; then
  echo "No git remote configured." >&2
  exit 2
fi

git -C "$DOTS_PATH" fetch -q 2>/dev/null || true

if ! upstream=$(git -C "$DOTS_PATH" rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null); then
  echo "No upstream tracking branch." >&2
  exit 2
fi

if ! behind=$(git -C "$DOTS_PATH" rev-list --count "HEAD..$upstream" 2>/dev/null); then
  echo "Cannot determine update status." >&2
  exit 2
fi

if ((behind > 0)); then
  echo "dots updates available ($behind commits):"
  git -C "$DOTS_PATH" --no-pager log --oneline "HEAD..$upstream"
  exit 0
else
  echo "dots is up to date."
  exit 1
fi
