#!/usr/bin/env bash

# dots:hidden=true
# Resolve the checkout for commands that run without shell startup state.

set -eo pipefail

if [[ -n ${DOTS_PATH:-} ]]; then
  if [[ $DOTS_PATH == *$'\n'* || $DOTS_PATH == *:* ]]; then
    echo "Invalid DOTS_PATH value" >&2
    exit 1
  fi
  printf '%s\n' "$DOTS_PATH"
  exit 0
fi

path_file="$HOME/.config/dots/path"
if [[ ( -e $path_file || -L $path_file ) && ( -L $path_file || ! -f $path_file ) ]]; then
  echo "Refusing non-regular checkout path file: $path_file" >&2
  exit 1
fi
if [[ -f $path_file ]]; then
  mapfile -t configured_lines <"$path_file"
  if ((${#configured_lines[@]} != 1)) || [[ -z ${configured_lines[0]} || ${configured_lines[0]} == *:* ]]; then
    echo "Invalid checkout path file: $path_file" >&2
    exit 1
  fi
  printf '%s\n' "${configured_lines[0]}"
else
  self_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
  cd -- "$self_dir/.."
  pwd
fi
