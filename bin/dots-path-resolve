#!/usr/bin/env bash

# dots:hidden=true
# Resolve the active dots runtime for commands without shell startup state.

set -eo pipefail

self_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
source "$self_dir/../install/helpers/files.sh"
path_file="$HOME/.config/dots/path"
if ! dots_file_assert_safe_parents "$path_file" "$HOME" >/dev/null 2>&1; then
  echo "Refusing unsafe dots runtime path hierarchy: $path_file" >&2
  exit 1
fi
if [[ ( -e $path_file || -L $path_file ) && ( -L $path_file || ! -f $path_file ) ]]; then
  echo "Refusing non-regular dots runtime path file: $path_file" >&2
  exit 1
fi
if [[ -f $path_file ]]; then
  mapfile -t configured_lines <"$path_file"
  if ((${#configured_lines[@]} != 1)) ||
    [[ -z ${configured_lines[0]} || ${configured_lines[0]} != /* || ${configured_lines[0]} == *:* ]]; then
    echo "Invalid dots runtime path file: $path_file" >&2
    exit 1
  fi
  printf '%s\n' "${configured_lines[0]}"
elif [[ -n ${DOTS_PATH:-} ]]; then
  if [[ $DOTS_PATH != /* || $DOTS_PATH == *$'\n'* || $DOTS_PATH == *:* ]]; then
    echo "Invalid DOTS_PATH value" >&2
    exit 1
  fi
  printf '%s\n' "$DOTS_PATH"
else
  cd -- "$self_dir/.."
  pwd
fi
