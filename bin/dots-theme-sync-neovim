#!/usr/bin/env bash

# dots:summary=Sync the generated theme to Neovim
# dots:hidden=true

set -euo pipefail

SELF_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
DOTS_PATH=$("$SELF_DIR/dots-path-resolve")
DOTS_PATH=$(cd -- "$DOTS_PATH" && pwd)
if [[ $SELF_DIR != "$DOTS_PATH/bin" ]]; then exec "$DOTS_PATH/bin/${BASH_SOURCE[0]##*/}" "$@"; fi
source "$DOTS_PATH/install/helpers/theme-sync.sh"

config_dir="${NVIM_CONFIG_DIR:-$HOME/.config/nvim}"
dots_theme_sync_link \
  neovim.lua "Neovim theme" "$config_dir" "$config_dir/lua/plugins/dots-system.lua"
