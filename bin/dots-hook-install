#!/usr/bin/env bash

# dots:summary=Install a script as a hook for an event
# dots:args=<event> <script-path>
# dots:examples=dots hook install post-update ~/my-hook

set -e

source "${BASH_SOURCE[0]%/*}/../install/helpers/runtime.sh"
source "$DOTS_PATH/install/helpers/files.sh"

event=${1:-}
script=${2:-}

if [[ -z $event || -z $script ]]; then
  echo "Usage: dots-hook-install <event> <script-path>" >&2
  exit 1
fi

if [[ ! $event =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]]; then
  echo "Hook event must use lowercase letters, digits, and internal hyphens: $event" >&2
  exit 1
fi

if [[ ! -f $script ]]; then
  echo "No such file: $script" >&2
  exit 1
fi

script_name=$(basename "$script")
if [[ ! $script_name =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
  echo "Hook script name contains unsafe characters: $script_name" >&2
  exit 1
fi

hook_dir="$HOME/.config/dots/hooks/$event.d"
hook_path="$hook_dir/$script_name"
dots_file_replace "$script" "$hook_path" discard
chmod +x "$hook_path"
echo "Installed hook: $hook_path"
