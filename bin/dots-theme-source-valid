#!/usr/bin/env bash

# dots:hidden=true
# Validate one generated source beneath an owned retained theme generation.

set -euo pipefail

pointer_name=current
if [[ ${1:-} == "--previous" ]]; then
  pointer_name=theme-previous
  shift
fi
if (( $# != 1 )) || [[ $1 == */* || -z $1 ]]; then
  echo "Usage: dots-theme-source-valid [--previous] <generated-filename>" >&2
  exit 1
fi

state_root="$HOME/.local/state/dots"
pointer="$state_root/$pointer_name"
[[ -L $pointer ]] || exit 1
target=$(readlink "$pointer")
[[ $target =~ ^theme-generations/(generation|recovery)\.[A-Za-z0-9]+$ ]] || exit 1
generation="$state_root/$target"
marker="$generation/.dots-theme-generation"
name_file="$generation/theme.name"
source_path="$generation/theme/$1"

[[ ! -L $generation && -d $generation ]] || exit 1
[[ ! -L $generation/theme && -d $generation/theme ]] || exit 1
[[ ! -L $marker && -f $marker ]] || exit 1
mapfile -t marker_lines <"$marker"
((${#marker_lines[@]} == 1)) && [[ ${marker_lines[0]} == "dots-theme-generation-v1" ]] || exit 1
[[ ! -L $name_file && -f $name_file ]] || exit 1
mapfile -t name_lines <"$name_file"
((${#name_lines[@]} == 1)) && [[ ${name_lines[0]} =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]] || exit 1
[[ ! -L $source_path && -f $source_path ]]
