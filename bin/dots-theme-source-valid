#!/usr/bin/env bash

# dots:hidden=true
# Validate one generated source beneath an owned retained theme generation.

set -euo pipefail

source "${BASH_SOURCE[0]%/*}/../install/helpers/runtime.sh"
source "$DOTS_PATH/install/helpers/theme-generation.sh"

pointer_name=current
if [[ ${1:-} == "--previous" ]]; then
  pointer_name=theme-previous
  shift
fi
if (( $# != 1 )) || [[ $1 == */* || -z $1 ]]; then
  echo "Usage: dots-theme-source-valid [--previous] <generated-filename>" >&2
  exit 1
fi

state_root="$HOME/.local/state/dots"
pointer="$state_root/$pointer_name"
[[ -L $pointer ]] || exit 1
target=$(readlink "$pointer")
dots_theme_generation_target_valid "$state_root" "$target" || exit 1
source_path="$state_root/$target/theme/$1"
[[ ! -L $source_path && -f $source_path ]]
