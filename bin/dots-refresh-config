#!/usr/bin/env bash

# dots:summary=Copy a shipped config from $DOTS_PATH/config into ~/.config (backs up your version)
# dots:args=<config-path>
# dots:examples=dots refresh config git/config

set -eo pipefail

SELF_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
DOTS_PATH=${DOTS_PATH:-$("$SELF_DIR/dots-path-resolve")}
DOTS_PATH=$(cd -- "$DOTS_PATH" && pwd)
if [[ $SELF_DIR != "$DOTS_PATH/bin" ]]; then exec "$DOTS_PATH/bin/dots-refresh-config" "$@"; fi
source "$DOTS_PATH/install/helpers/files.sh"

config_file=${1:-}

if [[ -z $config_file ]]; then
  cat <<USAGE
  Usage: $0 [config_file]

  Must provide a file path relative to .config to be refreshed.
  To copy $DOTS_PATH/config/git/config to ~/.config/git/config:

    $0 git/config
USAGE
  exit 1
fi

# Unlike omarchy, reject traversal outright instead of documenting the hazard.
if [[ $config_file == /* || $config_file == *..* ]]; then
  echo "Config path must be relative, without '..': $config_file" >&2
  exit 1
fi

user_config_file="${HOME}/.config/$config_file"
default_config_file="$DOTS_PATH/config/$config_file"

if [[ ! -e $default_config_file ]]; then
  echo "Not a shipped config: $config_file" >&2
  exit 1
fi

dots_file_replace "$default_config_file" "$user_config_file" backup

if [[ -n $DOTS_FILE_BACKUP ]]; then
  echo -e "\033[31mReplaced $user_config_file with the shipped default.\nSaved backup as ${DOTS_FILE_BACKUP}.\n\n\033[32mChanges:\033[0m"
  if [[ -L $DOTS_FILE_BACKUP ]]; then
    echo "Previous destination was a symlink to: $(readlink "$DOTS_FILE_BACKUP")"
  else
    diff "$user_config_file" "$DOTS_FILE_BACKUP" || true
  fi
fi
