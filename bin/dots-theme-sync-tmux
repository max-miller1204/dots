#!/usr/bin/env bash

# dots:summary=Refresh live tmux styles from the current theme
# dots:hidden=true

set -euo pipefail

SELF_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
DOTS_PATH=$("$SELF_DIR/dots-path-resolve")
DOTS_PATH=$(cd -- "$DOTS_PATH" && pwd)
if [[ $SELF_DIR != "$DOTS_PATH/bin" ]]; then exec "$DOTS_PATH/bin/${BASH_SOURCE[0]##*/}" "$@"; fi
tmux_path="$HOME/.local/state/dots/current/theme/tmux.conf"

"$DOTS_PATH/bin/dots-cmd-present" tmux || exit 0
[[ -f $tmux_path ]] || exit 0
"$SELF_DIR/dots-theme-source-valid" tmux.conf || {
  echo "Refusing unowned tmux theme source: $tmux_path" >&2
  exit 1
}
tmux list-sessions >/dev/null 2>&1 || exit 0

# Source the same generated config used by new servers. This preserves the
# renderer's user-template precedence instead of duplicating palette logic.
tmux source-file "$tmux_path" 2>/dev/null || true
tmux refresh-client -S 2>/dev/null || tmux refresh-client 2>/dev/null || true
