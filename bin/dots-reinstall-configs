#!/usr/bin/env bash

# dots:summary=Reset every config to the shipped defaults (clobbers your copies)
# dots:args=[--force]

set -eo pipefail

source "${BASH_SOURCE[0]%/*}/../install/helpers/runtime.sh"
source "$DOTS_PATH/install/helpers/files.sh"

# Omarchy's equivalent replays /etc/skel over $HOME without backup. Same
# semantics here, but behind a confirmation since there is no snapshot to
# fall back on.
if [[ ${1:-} != "--force" ]]; then
  echo "This overwrites your ~/.config copies of every file in $DOTS_PATH/config,"
  echo "plus ~/.bashrc, ~/.bash_profile, ~/.zshenv, and ~/.zshrc, with the shipped defaults."
  echo "No backups are kept."
  printf 'Continue? [y/N] '
  read -r reply
  [[ $reply == "y" || $reply == "Y" ]] || { echo "Aborted."; exit 1; }
fi

reinstall_config_file() {
  local file=$1

  file=${file#./}
  dots_file_replace "$DOTS_PATH/config/$file" "$HOME/.config/$file" discard
}
dots_config_for_each_file "$DOTS_PATH/config" reinstall_config_file

dots_file_replace "$DOTS_PATH/default/bashrc" "$HOME/.bashrc" discard
dots_file_replace "$DOTS_PATH/default/bash_profile" "$HOME/.bash_profile" discard
dots_file_replace "$DOTS_PATH/default/zshenv" "$HOME/.zshenv" discard
dots_file_replace "$DOTS_PATH/default/zshrc" "$HOME/.zshrc" discard

echo "Configs reset to shipped defaults."
