#!/bin/bash

# dots:summary=Reset every config to the shipped defaults (clobbers your copies)
# dots:args=[--force]

set -eo pipefail

DOTS_PATH=${DOTS_PATH:-$HOME/dotfiles}

# Omarchy's equivalent replays /etc/skel over $HOME without backup. Same
# semantics here, but behind a confirmation since there is no snapshot to
# fall back on.
if [[ ${1:-} != "--force" ]]; then
  echo "This overwrites your ~/.config copies of every file in $DOTS_PATH/config,"
  echo "plus ~/.bashrc, ~/.bash_profile, and ~/.zshrc, with the shipped defaults."
  echo "No backups are kept."
  printf 'Continue? [y/N] '
  read -r reply
  [[ $reply == "y" || $reply == "Y" ]] || { echo "Aborted."; exit 1; }
fi

(
  cd "$DOTS_PATH/config"
  find . -type f ! -name '.DS_Store' | while IFS= read -r file; do
    file=${file#./}
    mkdir -p "$(dirname "$HOME/.config/$file")"
    cp -f "$file" "$HOME/.config/$file"
  done
)

cp -f "$DOTS_PATH/default/bashrc" "$HOME/.bashrc"
cp -f "$DOTS_PATH/default/bash_profile" "$HOME/.bash_profile"
cp -f "$DOTS_PATH/default/zshrc" "$HOME/.zshrc"

echo "Configs reset to shipped defaults."
