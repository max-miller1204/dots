#!/usr/bin/env bash

# The dots command router, modeled on omarchy's bin/omarchy.
#
# Routing: `dots theme set tokyo-night` greedily resolves to the longest
# matching binary (dots-theme-set) and passes the rest as arguments.
# `dots <group>` with no matching binary lists that group's commands.
#
# Requires Bash >= 4 (Homebrew provides the command runtime on macOS, where
# Zsh remains the login shell and the system /bin/bash is 3.2).

if ((BASH_VERSINFO[0] < 4)); then
  echo "dots requires bash >= 4; this is bash ${BASH_VERSION}." >&2
  echo "On macOS: brew install bash for the command runtime (and ensure it is first on PATH)." >&2
  exit 1
fi

set -o pipefail

DOTS_BIN_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
DOTS_PATH=$("$DOTS_BIN_DIR/dots-path-resolve") || exit 1
DOTS_PATH=$(cd -- "$DOTS_PATH" && pwd) || exit 1
export DOTS_PATH
if [[ $DOTS_BIN_DIR != "$DOTS_PATH/bin" ]]; then
  exec "$DOTS_PATH/bin/dots" "$@"
fi
METADATA_SCAN_LIMIT=20

# The authoritative list of user-facing command groups. A group whose commands
# are all `# dots:hidden=true` gets no entry and is omitted from the listing.
declare -A GROUP_DESCRIPTIONS

GROUP_DESCRIPTIONS[config]="Configuration helpers"
GROUP_DESCRIPTIONS[dev]="Developer checkout controls"
GROUP_DESCRIPTIONS[hook]="User hook runner"
GROUP_DESCRIPTIONS[install]="First-time setup"
GROUP_DESCRIPTIONS[migrate]="Migration runner"
GROUP_DESCRIPTIONS[pkg]="Package management helpers (mise)"
GROUP_DESCRIPTIONS[refresh]="Reset a config file to the repo default"
GROUP_DESCRIPTIONS[reinstall]="Reinstall and reset workflows"
GROUP_DESCRIPTIONS[theme]="Theme management"
GROUP_DESCRIPTIONS[update]="Dotfiles and system updates"
GROUP_DESCRIPTIONS[version]="Version management"

metadata() { # metadata <file> <key>
  head -n "$METADATA_SCAN_LIMIT" "$1" | sed -n "s/^# dots:$2=//p" | head -1
}

command_group() { # command_group <basename>  (dots-theme-set -> theme)
  local rest=${1#dots-}
  echo "${rest%%-*}"
}

trim() { # trim <string>
  local s=$1
  # ${s%%[![:space:]]*} is the leading whitespace run; strip it as a prefix
  s=${s#"${s%%[![:space:]]*}"}
  # ${s##*[![:space:]]} is the trailing whitespace run; strip it as a suffix
  s=${s%"${s##*[![:space:]]}"}
  echo "$s"
}

# Per-command help, rendered from the same `# dots:` metadata the listings
# use. Reachable as `dots <command> --help`: greedy routing would otherwise
# hand the flag to the command, and most commands ignore unknown flags and
# just run.
command_help() { # command_help <file>
  local file=$1 base name summary args examples example

  base=${file##*/}
  name=${base#dots-}
  name=${name//-/ }
  summary=$(metadata "$file" summary)
  args=$(metadata "$file" args)
  examples=$(metadata "$file" examples)

  if [[ -n $summary ]]; then
    echo "dots $name - $summary"
  else
    echo "dots $name"
  fi

  echo
  if [[ -n $args ]]; then
    echo "Usage: dots $name $args"
  else
    echo "Usage: dots $name"
  fi

  if [[ -n $examples ]]; then
    echo
    echo "Examples:"
    # Split on the literal ';;' separator by turning each one into a newline
    # and reading the fields. IFS cannot do this: it holds a set of single
    # characters, so IFS=';;' is just IFS=';' and would also split an example
    # that contains a single semicolon. Metadata is scanned line by line, so
    # an example can never itself contain a newline.
    while IFS= read -r example; do
      example=$(trim "$example")
      [[ -n $example ]] && printf '  %s\n' "$example"
    done <<<"${examples//;;/$'\n'}"
  fi
}

list_groups() {
  local file base group
  local -A seen=()

  echo "dots — personal dotfiles, the omarchy way"
  echo
  echo "Usage: dots <group> [command] [args...]"
  echo
  echo "Groups:"

  for file in "$DOTS_BIN_DIR"/dots-*; do
    [[ -f $file && -x $file ]] || continue
    [[ $(metadata "$file" hidden) == "true" ]] && continue
    base=${file##*/}
    group=$(command_group "$base")
    [[ -n ${seen[$group]:-} ]] && continue
    seen[$group]=1
    if [[ -n ${GROUP_DESCRIPTIONS[$group]:-} ]]; then
      printf '  %-12s %s\n' "$group" "${GROUP_DESCRIPTIONS[$group]}"
    fi
  done

  echo
  echo "Run 'dots help <group>' to list its commands."
}

list_group() { # list_group <group>
  local group=$1 file base summary found=0

  echo "dots $group commands:"
  for file in "$DOTS_BIN_DIR/dots-$group" "$DOTS_BIN_DIR/dots-$group"-*; do
    [[ -f $file && -x $file ]] || continue
    [[ $(metadata "$file" hidden) == "true" ]] && continue
    base=${file##*/}
    summary=$(metadata "$file" summary)
    printf '  %-24s %s\n' "${base#dots-}" "$summary"
    found=1
  done

  if ((found == 0)); then
    echo "  (no visible commands)"
  fi
}

main() {
  if (($# == 0)); then
    list_groups
    exit 0
  fi

  # `dots help <group>` is the safe discovery path: greedy routing means a
  # bare `dots update` RUNS the update, so the group listing must be
  # reachable without executing anything.
  case "$1" in
    -h | --help | help)
      if [[ -n ${2:-} ]]; then
        if [[ -n ${GROUP_DESCRIPTIONS[$2]:-} ]]; then
          list_group "$2"
          exit 0
        fi
        echo "dots: unknown group: $2" >&2
        exit 1
      fi
      list_groups
      exit 0
      ;;
  esac

  # Greedy longest-match routing.
  local candidate="dots" best="" best_argc=0 i=0 arg
  for arg in "$@"; do
    i=$((i + 1))
    candidate="$candidate-$arg"
    if [[ -f "$DOTS_BIN_DIR/$candidate" && -x "$DOTS_BIN_DIR/$candidate" ]]; then
      best=$candidate
      best_argc=$i
    fi
  done

  if [[ -n $best ]]; then
    local -a rest=("${@:$((best_argc + 1))}")
    if ((${#rest[@]} == 1)) && [[ ${rest[0]} == -h || ${rest[0]} == --help ]]; then
      command_help "$DOTS_BIN_DIR/$best"
      exit 0
    fi
    exec "$DOTS_BIN_DIR/$best" "${rest[@]}"
  fi

  if [[ -n ${GROUP_DESCRIPTIONS[$1]:-} ]]; then
    list_group "$1"
    exit 0
  fi

  echo "dots: unknown command: $*" >&2
  echo "Run 'dots' to list available groups." >&2
  exit 1
}

main "$@"
