#!/usr/bin/env bash

# dots:summary=Install stable dots releases, packages, configs, and shell integration
# dots:args=[--developer]
#
# Stable is the default. --developer installs directly from this checkout.

# macOS ships Bash 3.2 and defaults accounts to Zsh. The installer must
# bootstrap its command runtime before it sources helpers that use Bash 4+
# features. This does not register Bash in /etc/shells or change the user's
# login shell.
if ((BASH_VERSINFO[0] < 4)); then
  if [[ $(uname -s) != "Darwin" ]]; then
    echo "dots requires Bash >= 4; this is Bash ${BASH_VERSION}." >&2
    exit 1
  fi

  brew_bin=$(command -v brew 2>/dev/null || true)
  # Tests can supply a sandboxed known-path fallback without invoking host Homebrew.
  if [[ -z $brew_bin && -x ${DOTS_TEST_HOMEBREW_BIN:-} ]]; then
    brew_bin=$DOTS_TEST_HOMEBREW_BIN
  elif [[ -z $brew_bin && -x /opt/homebrew/bin/brew ]]; then
    brew_bin=/opt/homebrew/bin/brew
  elif [[ -z $brew_bin && -x /usr/local/bin/brew ]]; then
    brew_bin=/usr/local/bin/brew
  fi
  if [[ -z $brew_bin ]]; then
    echo "Homebrew is required on macOS to install the dots Bash runtime and flock." >&2
    exit 1
  fi

  brew_prefix=$("$brew_bin" --prefix) || exit 1
  export PATH="$brew_prefix/bin:$brew_prefix/sbin:$PATH"
  modern_bash="$brew_prefix/bin/bash"
  if [[ ! -x $modern_bash ]]; then
    "$brew_bin" install bash || exit 1
  fi
  if [[ ! -x $modern_bash ]]; then
    echo "Homebrew Bash was not installed at $modern_bash." >&2
    exit 1
  fi
  exec "$modern_bash" "$0" "$@"
fi

set -eo pipefail

DOTS_PATH=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
export DOTS_PATH
export PATH="$DOTS_PATH/bin:$PATH"

source "$DOTS_PATH/install/helpers/files.sh"
source "$DOTS_PATH/install/helpers/releases.sh"
source "$DOTS_PATH/install/config/flock.sh"

original_args=("$@")
install_mode=stable
bootstrap_version=""
bootstrap_archive=""
bootstrap_sha=""
if [[ ${1:-} == "--developer" ]]; then
  install_mode=developer
  shift
elif [[ ${1:-} == "--release-runtime" ]]; then
  install_mode=release-runtime
  shift
elif [[ ${1:-} == "--bootstrap-release" ]]; then
  install_mode=bootstrap-release
  shift
  if (($# != 3)); then
    echo "Invalid internal release bootstrap invocation." >&2
    exit 1
  fi
  bootstrap_version=$1
  bootstrap_archive=$2
  bootstrap_sha=$3
  shift 3
fi
if (($#)); then
  echo "Usage: dots install [--developer]" >&2
  exit 1
fi

# Any reinstall is also the repair path when the previously recorded runtime
# has been deleted. Repair that one broken authority before delegating to the
# lock wrapper, which otherwise cannot resolve a runnable lock command. Invalid
# or unsafe path files still fail closed instead of being overwritten.
configured_runtime=$(dots_release_configured_path 2>/dev/null) || configured_runtime=""
if [[ -n $configured_runtime && ! -d $configured_runtime ]]; then
  dots_release_write_path "$DOTS_PATH"
fi

if ! dots_release_lock_fd_valid; then
  exec "$DOTS_PATH/bin/dots-update-lock" "$0" "${original_args[@]}"
fi

if [[ $install_mode == "stable" ]]; then
  if git -C "$DOTS_PATH" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    dots_release_write_source_path "$DOTS_PATH"
  fi
  echo "Installing the latest stable dots release..."
  dots_release_install_latest
  exec "$DOTS_RELEASE_CURRENT/bin/dots-install" --release-runtime
elif [[ $install_mode == "bootstrap-release" ]]; then
  packaged_version=$(<"$DOTS_PATH/version")
  if [[ $packaged_version != "$bootstrap_version" ]]; then
    echo "Refusing a release bootstrap whose payload version does not match." >&2
    exit 1
  fi
  echo "Installing dots $bootstrap_version..."
  dots_release_install_archive "$bootstrap_version" "$bootstrap_archive" "$bootstrap_sha"
  dots_release_activate "$bootstrap_version"
  exec "$DOTS_RELEASE_CURRENT/bin/dots-install" --release-runtime
elif [[ $install_mode == "developer" ]]; then
  if git -C "$DOTS_PATH" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    dots_release_write_source_path "$DOTS_PATH"
  fi
else
  current_version=$(dots_release_pointer_version "$DOTS_RELEASE_CURRENT" 2>/dev/null) || current_version=""
  current_runtime=$(cd -- "$DOTS_RELEASE_CURRENT" 2>/dev/null && pwd -P) || current_runtime=""
  invoked_runtime=$(cd -- "$DOTS_PATH" && pwd -P)
  if ! dots_release_is_stable_mode || [[ -z $current_version || $invoked_runtime != "$current_runtime" ]]; then
    echo "Refusing release installation outside the managed dots release path." >&2
    exit 1
  fi
fi

dots_file_assert_safe_parents "$HOME/.local/state/dots/install.log" "$HOME"
mkdir -p "$HOME/.local/state/dots"
source "$DOTS_PATH/install/helpers/logging.sh"

echo "Installing dots from $DOTS_PATH"

# Store the active runtime as plain data, never sourced shell code. A newline cannot
# be represented by the one-line format, and a colon cannot be represented as
# one PATH entry, so reject both with an actionable error.
if [[ $DOTS_PATH != /* || $DOTS_PATH == *$'\n'* || $DOTS_PATH == *:* ]]; then
  echo "The dots runtime path cannot contain a newline or colon: $DOTS_PATH" >&2
  exit 1
fi
dots_path_source=$(mktemp "${TMPDIR:-/tmp}/dots-path.XXXXXX")
printf '%s\n' "$DOTS_PATH" >"$dots_path_source"
if ! dots_file_replace "$dots_path_source" "$HOME/.config/dots/path" backup; then
  rm -f "$dots_path_source"
  exit 1
fi
rm -f "$dots_path_source"
if [[ -n $DOTS_FILE_BACKUP ]]; then
  echo "Updated ~/.config/dots/path (backup at $DOTS_FILE_BACKUP)"
else
  echo "Recorded runtime location in ~/.config/dots/path"
fi

# Publish the repaired runtime path before consulting legacy completion state:
# an unsafe completion marker must still fail closed, but must not prevent this
# checkout-authority repair.
install_done=0
done_rc=0
dots-done check install && install_done=1 || done_rc=$?
if ((done_rc > 1)); then
  echo "Cannot determine install completion safely." >&2
  exit "$done_rc"
fi

# Older installs stored executable shell text here. It is no longer sourced;
# preserve and remove it so there is only one checkout-location authority.
if [[ -e $HOME/.config/dots/dots.conf || -L $HOME/.config/dots/dots.conf ]]; then
  dots_file_remove "$HOME/.config/dots/dots.conf" backup
  echo "Retired ~/.config/dots/dots.conf (backup at $DOTS_FILE_BACKUP)"
fi

# Keep the install lock until every convergence step has committed. Commands
# that may run user code receive fd 9 closed while this installer retains it.

# 1. mise needs its live manifest before it can install the pinned tools.
# Seed this one config first; the complete pass below is then a no-op for it.
echo "Seeding mise config into ~/.config..."
dots-refresh-config mise/config.toml

# 2. Packages. A missing mise or failed install aborts the entire install.
source "$DOTS_PATH/install/packages.sh"

# Existing installs must repair their prior stock files before the seeding pass
# replaces them. Clear the update-lock sentinel along with fd 9 so this
# standalone install reports any restart markers produced by migrations.
if ((install_done == 1)); then
  DOTS_UPDATE_LOCK_PID="" "$DOTS_PATH/bin/dots-migrate" 9>&-
fi

# 3. Seed configs: config/** -> ~/.config/**, backing up anything replaced
echo "Seeding configs into ~/.config..."
seed_config_file() {
  local file=$1

  dots-refresh-config "${file#./}"
}
dots_config_for_each_file "$DOTS_PATH/config" seed_config_file

# 4. Shell integration: seed rc files, backing up differing versions
seed_home_file() { # seed_home_file <repo-file> <home-file>
  local src="$DOTS_PATH/$1" dest="$HOME/$2"

  dots_file_replace "$src" "$dest" backup
  if [[ -n $DOTS_FILE_BACKUP ]]; then
    echo "Replaced $dest (backup at $DOTS_FILE_BACKUP)"
  fi
}

seed_home_file default/bashrc .bashrc
seed_home_file default/bash_profile .bash_profile
seed_home_file default/zshenv .zshenv
seed_home_file default/zshrc .zshrc

# 5. System-side and user-side setup
source "$DOTS_PATH/install/config/all.sh"
source "$DOTS_PATH/install/user/all.sh"

# 6. On first install, mark all shipped migrations as applied: a fresh
# install already reflects them (omarchy does the same for new users).
if ((install_done == 0)); then
  empty_marker=$(mktemp "${TMPDIR:-/tmp}/dots-install-migration-marker.XXXXXX")
  trap 'rm -f "$empty_marker"' EXIT
  for migration in "$DOTS_PATH"/migrations/*.sh; do
    [[ -f $migration ]] || continue
    marker="$HOME/.local/state/dots/migrations/$(basename "$migration")"
    dots_file_replace "$empty_marker" "$marker" discard
  done
  rm -f "$empty_marker"
  empty_marker=""
  trap - EXIT
fi

# Existing installations ran migrations before config seeding so stock-file
# repairs could still recognize their inputs. Fresh installs just marked every
# shipped migration, so they have nothing to run.
"$DOTS_PATH/bin/dots-hook" post-install 9>&-
dots-done mark install
exec 9>&-
unset DOTS_UPDATE_LOCK_PID

echo
echo 'Done. Open a new terminal (or run: exec "$SHELL" -l), then try: dots'
