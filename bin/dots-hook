#!/usr/bin/env bash

# dots:summary=Run a named hook from ~/.config/dots/hooks/<name> and ~/.config/dots/hooks/<name>.d/
# dots:args=<name> [args...]

set -e

source "${BASH_SOURCE[0]%/*}/../install/helpers/runtime.sh"

if (( $# < 1 )); then
  echo "Usage: dots-hook <name> [args...]" >&2
  exit 1
fi

name=$1
if [[ ! $name =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]]; then
  echo "Hook event must use lowercase letters, digits, and internal hyphens: $name" >&2
  exit 1
fi

HOOK_PATH="$HOME/.config/dots/hooks/$name"
HOOK_DIR="$HOOK_PATH.d"
shift

hook_rc=0
run_hook() {
  local hook=$1
  shift

  if ! bash "$hook" "$@"; then
    echo "Hook failed: $hook" >&2
    hook_rc=1
  fi
}

if [[ -f $HOOK_PATH ]]; then
  run_hook "$HOOK_PATH" "$@"
fi

if [[ -d $HOOK_DIR ]]; then
  for hook in "$HOOK_DIR"/*; do
    [[ -f $hook ]] || continue
    [[ $hook == *.sample ]] && continue
    run_hook "$hook" "$@"
  done
fi

exit "$hook_rc"
