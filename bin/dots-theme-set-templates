#!/usr/bin/env bash

# dots:summary=Render themed templates into a staged theme directory
# dots:args=<staged-theme-dir>
# dots:hidden=true
#
# Renders default/themed/*.tpl (and user templates from ~/.config/dots/themed/)
# into the staged theme using values from its colors.toml. Supported
# placeholders, per key in colors.toml:
#
#   {{ key }}        -> #7aa2f7
#   {{ key_strip }}  -> 7aa2f7
#   {{ key_rgb }}    -> 122,162,247
#
# Derived keys (as in omarchy): selection_background = selection,
# selection_foreground = bright_foreground, unless the theme defines them.
# Omarchy's mix/gradient helpers are not implemented.
#
# Rendering only happens when the staged theme has colors.toml. Existing
# regular files are never overwritten, so a hand-written
# themes/<name>/btop.theme wins over default/themed/btop.theme.tpl; symlinks and
# non-regular occupants are rejected. User templates are processed before
# built-ins, so a user template with the same output filename shadows the
# built-in. Publication also fails if supported placeholders remain unresolved.

set -eo pipefail

source "${BASH_SOURCE[0]%/*}/../install/helpers/runtime.sh"

staging=${1:?Usage: dots-theme-set-templates <staged-theme-dir>}
colors_file="$staging/colors.toml"

[[ -f $colors_file ]] || exit 0
source "$DOTS_PATH/install/helpers/theme-palette.sh"

sedfile=$(mktemp "${TMPDIR:-/tmp}/dots-theme-rules.XXXXXX")
trap 'rm -f "$sedfile"' EXIT

escape_sed_replacement() {
  printf '%s' "$1" | sed 's/[\\&|]/\\&/g'
}

emit_rules() { # emit_rules <key> <value>
  local key=$1 val=$2 stripped escaped r g b

  stripped=$(escape_sed_replacement "${val#\#}")
  printf 's|{{ *%s_strip *}}|%s|g\n' "$key" "$stripped"

  if [[ $val =~ ^#([0-9a-fA-F][0-9a-fA-F])([0-9a-fA-F][0-9a-fA-F])([0-9a-fA-F][0-9a-fA-F])$ ]]; then
    r=$((16#${BASH_REMATCH[1]}))
    g=$((16#${BASH_REMATCH[2]}))
    b=$((16#${BASH_REMATCH[3]}))
    printf 's|{{ *%s_rgb *}}|%s,%s,%s|g\n' "$key" "$r" "$g" "$b"
  fi

  escaped=$(escape_sed_replacement "$val")
  printf 's|{{ *%s *}}|%s|g\n' "$key" "$escaped"
}

selection_value=""
bright_foreground_value=""
has_selection=""
has_bright_foreground=""
has_selection_background=""
has_selection_foreground=""

# shellcheck disable=SC2329 # invoked by dots_theme_palette_parse
palette_rule() { # palette_rule <key> <decoded-value>
  local key=$1 val=$2
  emit_rules "$key" "$val" >>"$sedfile"

  case $key in
    selection)
      selection_value=$val
      has_selection=1
      ;;
    bright_foreground)
      bright_foreground_value=$val
      has_bright_foreground=1
      ;;
    selection_background) has_selection_background=1 ;;
    selection_foreground) has_selection_foreground=1 ;;
  esac
}

dots_theme_palette_parse "$colors_file" palette_rule

if [[ -z $has_selection_background && -n $has_selection && -n $selection_value ]]; then
  emit_rules selection_background "$selection_value" >>"$sedfile"
fi
if [[ -z $has_selection_foreground && -n $has_bright_foreground && -n $bright_foreground_value ]]; then
  emit_rules selection_foreground "$bright_foreground_value" >>"$sedfile"
fi

render() { # render <template>: output lands in staging, named without .tpl
  local tpl=$1 out
  out="$staging/$(basename "${tpl%.tpl}")"
  if [[ -L $out || ( -e $out && ! -f $out ) ]]; then
    echo "Refusing non-regular rendered output: $out" >&2
    return 1
  fi
  [[ -f $out ]] && return 0
  sed -f "$sedfile" "$tpl" >"$out"
  if LC_ALL=C grep -Eq '\{\{[[:space:]]*[A-Za-z0-9_]+[[:space:]]*\}\}' "$out"; then
    echo "Unresolved theme placeholder in rendered output: $out" >&2
    return 1
  fi
}

for tpl in "$HOME/.config/dots/themed"/*.tpl; do
  [[ -f $tpl ]] && render "$tpl"
done

for tpl in "$DOTS_PATH/default/themed"/*.tpl; do
  [[ -f $tpl ]] && render "$tpl"
done

exit 0
