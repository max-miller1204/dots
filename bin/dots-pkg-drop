#!/usr/bin/env bash

# dots:summary=Remove a tool from the global mise config
# dots:args=<tool...>
# dots:examples=dots pkg drop ripgrep

set -eo pipefail

SELF_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
DOTS_PATH=$("$SELF_DIR/dots-path-resolve")
DOTS_PATH=$(cd -- "$DOTS_PATH" && pwd)
if [[ $SELF_DIR != "$DOTS_PATH/bin" ]]; then exec "$DOTS_PATH/bin/${BASH_SOURCE[0]##*/}" "$@"; fi

if (( $# < 1 )); then
  echo "Usage: dots-pkg-drop <tool...>" >&2
  exit 1
fi

if ! command -v mise >/dev/null 2>&1; then
  echo "mise is not installed. See https://mise.jdx.dev/getting-started.html" >&2
  exit 1
fi

mise unuse --global "$@"

echo
echo "Removed from ~/.config/mise/config.toml. Persist it in the repo with:"
echo "  dots config import mise/config.toml"
