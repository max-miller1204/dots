#!/usr/bin/env bash

# dots:summary=Adopt a file from ~/.config into the repo's config/ tree
# dots:args=<config-path>
# dots:examples=dots config import mise/config.toml

set -eo pipefail

SELF_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
DOTS_PATH=$("$SELF_DIR/dots-path-resolve")
DOTS_PATH=$(cd -- "$DOTS_PATH" && pwd)
if [[ $SELF_DIR != "$DOTS_PATH/bin" ]]; then exec "$DOTS_PATH/bin/${BASH_SOURCE[0]##*/}" "$@"; fi
source "$DOTS_PATH/install/helpers/files.sh"

config_file=${1:-}

if [[ -z $config_file ]]; then
  echo "Usage: dots-config-import <path-relative-to-~/.config>" >&2
  exit 1
fi

if [[ $config_file == /* || $config_file == *..* ]]; then
  echo "Config path must be relative, without '..': $config_file" >&2
  exit 1
fi

src="$HOME/.config/$config_file"
if ! source_path=$("$SELF_DIR/dots-source-resolve"); then
  echo "Config import needs an editable source checkout." >&2
  exit 1
fi
dest="$source_path/config/$config_file"

if [[ ! -f $src ]]; then
  echo "No such file: $src" >&2
  exit 1
fi

dots_file_replace "$src" "$dest" discard "$source_path"

echo "Imported ~/.config/$config_file into $source_path/config/$config_file"
echo "Review and commit it: git -C \"$source_path\" add \"config/$config_file\""
