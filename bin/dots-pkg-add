#!/bin/bash

# dots:summary=Install packages with Homebrew
# dots:args=<package...>

set -eo pipefail

if (( $# < 1 )); then
  echo "Usage: dots-pkg-add <package...>" >&2
  exit 1
fi

if ! command -v brew >/dev/null 2>&1; then
  echo "Homebrew is not installed. Get it from https://brew.sh first." >&2
  exit 1
fi

brew install "$@"
