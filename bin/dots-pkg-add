#!/usr/bin/env bash

# dots:summary=Install a tool globally with mise
# dots:args=<tool[@version]...>
# dots:examples=dots pkg add ripgrep;;dots pkg add node@lts

set -eo pipefail

SELF_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
DOTS_PATH=$("$SELF_DIR/dots-path-resolve")
DOTS_PATH=$(cd -- "$DOTS_PATH" && pwd)
if [[ $SELF_DIR != "$DOTS_PATH/bin" ]]; then exec "$DOTS_PATH/bin/dots-pkg-add" "$@"; fi

if (( $# < 1 )); then
  echo "Usage: dots-pkg-add <tool[@version]...>" >&2
  exit 1
fi

if ! command -v mise >/dev/null 2>&1; then
  echo "mise is not installed. See https://mise.jdx.dev/getting-started.html" >&2
  exit 1
fi

mise use --global "$@"

echo
echo "Recorded in ~/.config/mise/config.toml. Persist it in the repo with:"
echo "  dots config import mise/config.toml"
