#!/usr/bin/env bash

# dots:summary=Check or mark completed dots setup tasks
# dots:args=<check|mark|ensure> <name>
# dots:hidden=true

set -euo pipefail

SELF_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
DOTS_PATH=${DOTS_PATH:-$("$SELF_DIR/dots-path-resolve")}
DOTS_PATH=$(cd -- "$DOTS_PATH" && pwd)
if [[ $SELF_DIR != "$DOTS_PATH/bin" ]]; then
  exec "$DOTS_PATH/bin/dots-done" "$@"
fi
source "$DOTS_PATH/install/helpers/files.sh"

if (( $# != 2 )); then
  echo "Usage: dots-done <check|mark|ensure> <name>" >&2
  exit 1
fi

action=$1
name=$2
done_dir="$HOME/.local/state/dots/done"
marker="$done_dir/$name"

if [[ $name == */* || $name == "." || $name == ".." ]]; then
  echo "Invalid done marker name: $name" >&2
  exit 1
fi

dots_file_assert_safe_parents "$marker" "$HOME" || exit 2
if [[ -L $marker || ( -e $marker && ! -f $marker ) ]]; then
  echo "Refusing unsafe done marker: $marker" >&2
  exit 2
fi

case "$action" in
  check)
    [[ -f $marker && ! -L $marker ]]
    ;;
  mark)
    empty_marker=$(mktemp "${TMPDIR:-/tmp}/dots-done-marker.XXXXXX")
    trap 'rm -f "$empty_marker"' EXIT
    dots_file_replace "$empty_marker" "$marker" discard
    ;;
  ensure)
    mkdir -p "$done_dir"
    dots_file_assert_safe_parents "$marker" "$HOME"
    [[ ! -L $marker ]] || exit 1
    (set -o noclobber; : >"$marker") 2>/dev/null
    ;;
  *)
    echo "Usage: dots-done <check|mark|ensure> <name>" >&2
    exit 1
    ;;
esac
