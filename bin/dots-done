#!/usr/bin/env bash

# dots:summary=Check or mark completed dots setup tasks
# dots:args=<check|mark> <name>
# dots:hidden=true

set -euo pipefail

source "${BASH_SOURCE[0]%/*}/../install/helpers/runtime.sh"
source "$DOTS_PATH/install/helpers/files.sh"

if (( $# != 2 )); then
  echo "Usage: dots-done <check|mark> <name>" >&2
  exit 1
fi

action=$1
name=$2
done_dir="$HOME/.local/state/dots/done"
marker="$done_dir/$name"

if [[ $name == */* || $name == "." || $name == ".." ]]; then
  echo "Invalid done marker name: $name" >&2
  exit 1
fi

dots_file_assert_safe_parents "$marker" "$HOME" || exit 2
if [[ -L $marker || ( -e $marker && ! -f $marker ) ]]; then
  echo "Refusing unsafe done marker: $marker" >&2
  exit 2
fi

case "$action" in
  check)
    [[ -f $marker && ! -L $marker ]]
    ;;
  mark)
    empty_marker=$(mktemp "${TMPDIR:-/tmp}/dots-done-marker.XXXXXX")
    trap 'rm -f "$empty_marker"' EXIT
    dots_file_replace "$empty_marker" "$marker" discard
    ;;
  *)
    echo "Usage: dots-done <check|mark> <name>" >&2
    exit 1
    ;;
esac
